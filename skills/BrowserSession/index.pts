[SemanticProgram.InfinitivePhrase("to run playwright script")]
[SemanticProgram.InfinitivePhrase("to execute playwright automation")]
[SemanticProgram.InfinitivePhrase("to interact with a browser using playwright")]
prototype ToRunPlaywrightScript : PlaywrightBrowserSkillAction
{
	Description = @"Runs a Playwright-style automation script natively through Buffaly's Microsoft.Playwright runtime. This is not page JavaScript and does not run command-line Playwright.";

	function Execute(string subAgentId, string script, string argsJson = "{}", int timeoutMs = 30000) : string
	{
		return BrowserSessionTools.RunPlaywrightScript(_opsAgent, subAgentId, script, argsJson, timeoutMs);
	}
}

[SemanticProgram.InfinitivePhrase("to fill a browser selector with a secret")]
[SemanticProgram.InfinitivePhrase("to type a secret into a browser password field")]
prototype ToFillBrowserSelectorWithSecret : BrowserSessionSkillAction
{
	Description = @"Fills a browser selector with a StringRef secret without returning or logging the secret. The ProtoScript wrapper explicitly materializes the StringRef before calling the C# string helper; the helper still fails closed if an unresolved handle reaches it. Returns redacted JSON only.";

	function Execute(string subAgentId, string selector, StringRef secretValue, int timeoutMs = 15000) : string
	{
		string materializedSecret = MaterializeBrowserSecretValue(secretValue);
		return BrowserSessionTools.FillBrowserSelectorWithSecret(_opsAgent, subAgentId, selector, materializedSecret, timeoutMs);
	}
}

[SemanticProgram.InfinitivePhrase("to fill a browser password field with a secret")]
[SemanticProgram.InfinitivePhrase("to type a secret into a browser password input")]
prototype ToFillBrowserPasswordWithSecret : BrowserSessionSkillAction
{
	Description = @"Fills a browser password field with a StringRef secret without returning or logging the secret. The ProtoScript wrapper explicitly materializes the StringRef before calling the dedicated C# password helper; the helper still fails closed if an unresolved handle reaches it. selector defaults to input[type=password]. Returns redacted JSON only.";

	function Execute(string subAgentId, StringRef secretValue, string selector = "input[type=password]", int timeoutMs = 15000) : string
	{
		string materializedSecret = MaterializeBrowserSecretValue(secretValue);
		return BrowserSessionTools.FillBrowserPasswordWithSecret(_opsAgent, subAgentId, selector, materializedSecret, timeoutMs);
	}
}

function MaterializeBrowserSecretValue(StringRef value) : string
{
	return value;
}
