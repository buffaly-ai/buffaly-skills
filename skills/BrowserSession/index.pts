import Buffaly.Agent.Tools.Browser Buffaly.Agent.Tools.Browser.BrowserTools BrowserTools;
import Buffaly.Agent.Tools.Browser Buffaly.Agent.Tools.Browser.BrowserSessionTools BrowserSessionTools;

prototype BrowserSessionSkillAction : OpsAction, CodingContext
{
	Description = @"Base action type for the canonical default Browser Skill deterministic browser tools.";
}

[SemanticEntity("browser skill")]
[SemanticEntity("default browser skill")]
prototype BrowserSkill : SkillEntity
{
	EntityName = "browser skill, default browser skill";
	Description = @"Canonical default Browser Skill backed by the C# CDP browser runtime. Use for generic browser requests, selector actions, DOM inspection, trusted input, screenshots, console events, and browser session control.";
	ActionRoot = BrowserSessionSkillAction;
}

[SemanticEntity("browser session skill")]
prototype BrowserSessionSkill : BrowserSkill
{
	EntityName = "browser session skill";
	Description = @"Compatibility alias for the canonical BrowserSkill action surface.";
	ActionRoot = BrowserSessionSkillAction;
}

prototype PlaywrightBrowserSkillAction : BrowserSessionSkillAction
{
	Description = @"Base action type for explicit Playwright browser tools.";
}

[SemanticEntity("playwright browser skill")]
prototype PlaywrightBrowserSkill : SkillEntity
{
	EntityName = "playwright browser skill";
	Description = @"Explicit Playwright browser automation. Generic browser requests route to BrowserSkill/CDP instead.";
	ActionRoot = PlaywrightBrowserSkillAction;
}

include "PromptActions.pts";

[SemanticProgram.InfinitivePhrase("to open a browser session")]
[SemanticProgram.InfinitivePhrase("to start a browser session")]
prototype ToOpenBrowserSession : BrowserSessionSkillAction
{
	Description = @"Thin wrapper over BrowserTools.BrowserSubAgentOpenTool(_opsAgent, profileName). profileName - persistent browser profile name. Returns JSON containing subAgentId/profile/status.";

	function Execute(string profileName) : string
	{
		return BrowserTools.BrowserSubAgentOpenTool(_opsAgent, profileName);
	}
}

[SemanticProgram.InfinitivePhrase("to open a managed browser session")]
[SemanticProgram.InfinitivePhrase("to open a url in the default browser")]
[SemanticProgram.InfinitivePhrase("to use the managed browser")]
[SemanticProgram.InfinitivePhrase("to recover the persistent browser")]
[SemanticProgram.InfinitivePhrase("to open the browser with the existing login")]
[SemanticProgram.InfinitivePhrase("to open a persistent CDP browser")]
prototype ToOpenManagedCdpBrowserSession : BrowserSessionSkillAction
{
	Description = @"Authoritative route for registered persistent/default browsers. Atomically resolves the managed CDP browser, invokes its pre-approved launcher when the endpoint is unavailable, waits for bounded health recovery, and opens an absolute URL without Tier 2 approval. Use this instead of ToLaunchCdpChrome or raw port-based ToOpenCdpBrowserSession whenever a managed browser or existing login is intended. An empty browserKey uses Browser Feature DefaultManagedBrowserKey; the caller never supplies a launcher, profile, executable, or port.";

	function Execute(string browserKey, string url) : string
	{
		return BrowserTools.ManagedBrowserOpenTool(_opsAgent, browserKey, url);
	}
}

[SemanticProgram.InfinitivePhrase("to open a playwright browser session")]
[SemanticProgram.InfinitivePhrase("to open an isolated playwright browser")]
prototype ToOpenPlaywrightBrowserSession : PlaywrightBrowserSkillAction
{
	Description = @"Opens an explicitly Playwright-backed browser session without changing the generic CDP default.";

	function Execute(string profileName) : string
	{
		return BrowserTools.PlaywrightBrowserSubAgentOpenTool(_opsAgent, profileName);
	}
}

