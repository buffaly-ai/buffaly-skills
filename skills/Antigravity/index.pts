reference Buffaly.Tools.Antigravity;
import Buffaly.Tools.Antigravity Buffaly.Tools.Antigravity.AntigravityTools AntigravityTools;
include "RuntimeGlue.pts";

[SemanticEntity("antigravity skill")]
[SemanticEntity("agy skill")]
[SemanticEntity("google antigravity cli skill")]
prototype AntigravitySkill : SkillEntity
{
	Description = "Native Antigravity ACP tool: auth status/login/logout, one-shot prompt execution, and conversation management. Uses agy_acp_server plus matching localharness_external. Operator config is BUFFALY_ANTIGRAVITY_TOOL_CONFIG. Does not scrape ordinary agy CLI state.";
	ActionRoot = AntigravitySkillAction;
}

prototype AntigravitySkillAction : OpsAction
{
	Description = @"Base action type for Antigravity ACP native tools.";
}

[SemanticProgram.InfinitivePhrase("to get antigravity auth status")]
[SemanticProgram.InfinitivePhrase("to check antigravity auth status")]
[SemanticProgram.InfinitivePhrase("to check if agy is installed and authenticated")]
prototype ToGetAntigravityAuthStatus : AntigravitySkillAction
{
	Description = @"Returns whether the configured ACP executable is present. Non-secret status only. Does not scrape ordinary agy CLI state.";

	function Execute() : string
	{
		string contextJson = ToAntigravityNativeContextJson("default", "", "");
		string handle = AntigravityTools.BeginProbe(contextJson, _opsAgent.GetCurrentOperationCancellationToken());
		string result = ToAntigravityNativeRunHandle(handle);
		AntigravityTools.Release(handle);
		return result;
	}
}

[SemanticProgram.InfinitivePhrase("to begin antigravity login")]
[SemanticProgram.InfinitivePhrase("to sign in to agy")]
[SemanticProgram.InfinitivePhrase("to sign in to antigravity")]
[SemanticProgram.InfinitivePhrase("to login to antigravity")]
prototype ToBeginAntigravityLogin : AntigravitySkillAction
{
	Description = @"Explicit ACP login/setup only. timeoutSeconds defaults to 600. Normal prompt and probe paths do not start a browser.";

	function Execute(int timeoutSeconds) : string
	{
		if (timeoutSeconds <= 0)
			timeoutSeconds = 600;
		string contextJson = AntigravityTools.CreateTurnRequestJson(_opsAgent.GetSessionKeyOrEmpty(), _opsAgent.GetCurrentSessionDirectory(), _opsAgent.GetCurrentProjectDirectory(), _opsAgent.GetCurrentToolInvocationIdOrEmpty(), _opsAgent.GetCurrentToolMessageKeyOrEmpty(), _opsAgent.GetCurrentTurnKeyOrEmpty(), "default", "login", "", "", timeoutSeconds, "", false);
		string handle = AntigravityTools.BeginLogin(contextJson, _opsAgent.GetCurrentOperationCancellationToken());
		string result = ToAntigravityNativeRunHandle(handle);
		AntigravityTools.Release(handle);
		return result;
	}
}

[SemanticProgram.InfinitivePhrase("to logout of antigravity")]
[SemanticProgram.InfinitivePhrase("to sign out of antigravity")]
[SemanticProgram.InfinitivePhrase("to logout antigravity account")]
[SemanticProgram.InfinitivePhrase("to sign out of agy")]
prototype ToLogoutAntigravityAccount : AntigravitySkillAction
{
	Description = @"Logs out of the configured Antigravity ACP profile. Does not delete ordinary agy CLI files or unrelated profiles.";

	function Execute() : string
	{
		string contextJson = ToAntigravityNativeContextJson("default", "", "");
		string handle = AntigravityTools.BeginLogout(contextJson, _opsAgent.GetCurrentOperationCancellationToken());
		string result = ToAntigravityNativeRunHandle(handle);
		AntigravityTools.Release(handle);
		return result;
	}
}
[SemanticProgram.InfinitivePhrase("to run an antigravity prompt")]
[SemanticProgram.InfinitivePhrase("to execute an antigravity prompt")]
[SemanticProgram.InfinitivePhrase("to send a prompt to antigravity")]
[SemanticProgram.InfinitivePhrase("to ask agy a one-shot question")]
[SemanticProgram.InfinitivePhrase("to ask antigravity a question")]
[SemanticProgram.InfinitivePhrase("to run an agy prompt")]
prototype ToRunAntigravityPrompt : AntigravitySkillAction
{
	Description = @"prompt - required one-shot prompt text.
model - optional model override. Use native ACP model option IDs, not old CLI display labels.
workingDirectory - optional cwd for the native process.
timeoutSeconds - nonpositive values resolve to 3600.
continueConversation - retained for signature compatibility; true is rejected because ACP does not use agy -c.
conversationId - retained for signature compatibility; non-empty values are rejected because old agy UUIDs are not ACP sessions.
Runs one ephemeral ACP turn. Does not continue ordinary agy CLI conversations.";

	function Execute(string prompt, string model, string workingDirectory, int timeoutSeconds, bool continueConversation, string conversationId) : string
	{
		if (StringUtil.IsEmpty(prompt))
			return "Error: prompt is required.";
		if (continueConversation)
			return "Error: continueConversation is not supported. ACP conversations are owner-scoped; use ToTalkToAntigravity instead of agy -c.";
		if (!StringUtil.IsEmpty(conversationId))
			return "Error: conversationId is not an ACP session id. Old agy UUIDs are rejected. Use ToTalkToAntigravity or ToStartNewAntigravityConversation.";
		string scope = "oneshot-" + _opsAgent.GetCurrentToolInvocationIdOrEmpty();
		if (StringUtil.IsEmpty(scope) || scope == "oneshot-")
			scope = "oneshot-default";
		return ToAntigravityNativeTurn(scope, prompt, model, "", timeoutSeconds, workingDirectory, true);
	}
}

[SemanticProgram.InfinitivePhrase("to talk to antigravity")]
[SemanticProgram.InfinitivePhrase("to ask antigravity")]
[SemanticProgram.InfinitivePhrase("to send a message to antigravity")]
[SemanticProgram.InfinitivePhrase("to pass through to antigravity")]
[SemanticProgram.InfinitivePhrase("to chat with antigravity")]
prototype ToTalkToAntigravity : AntigravitySkillAction
{
	Description = @"prompt - the user's message to forward to Antigravity ACP.
model - optional model override.
timeoutSeconds - optional timeout. Nonpositive values resolve to 3600.
Owner identity comes from the current Buffaly session. Does not use -c or ordinary agy conversation files.";

	function Execute(string prompt, string model, int timeoutSeconds) : string
	{
		if (StringUtil.IsEmpty(prompt))
			return "Error: prompt is required.";
		return ToAntigravityNativeTurn("default", prompt, model, "", timeoutSeconds, "", false);
	}
}
[SemanticProgram.InfinitivePhrase("to start a new antigravity conversation")]
[SemanticProgram.InfinitivePhrase("to reset antigravity conversation")]
[SemanticProgram.InfinitivePhrase("to start fresh with antigravity")]
prototype ToStartNewAntigravityConversation : AntigravitySkillAction
{
	Description = @"Clears the current Antigravity ACP conversation binding so the next ToTalkToAntigravity call starts a fresh native session. Optional model parameter to set the model for the new conversation.";

	function Execute(string model) : string
	{
		string contextJson = ToAntigravityNativeContextJson("default", model, "");
		return AntigravityTools.ResetConversation(contextJson);
	}
}

[SemanticProgram.InfinitivePhrase("to get antigravity conversation state")]
[SemanticProgram.InfinitivePhrase("to check antigravity conversation status")]
prototype ToGetAntigravityConversationState : AntigravitySkillAction
{
	Description = @"Returns the current Antigravity ACP pass-through state: native session id, model, working directory, and generation.";

	function Execute() : string
	{
		return AntigravityTools.GetConversationState(ToAntigravityNativeContextJson("default", "", ""));
	}
}

[SemanticProgram.InfinitivePhrase("to set antigravity model")]
[SemanticProgram.InfinitivePhrase("to switch antigravity model")]
prototype ToSetAntigravityModel : AntigravitySkillAction
{
	Description = @"Sets the model for subsequent Antigravity ACP pass-through calls. Does not start a new conversation. Use native ACP model option IDs, not old CLI display names.";

	function Execute(string model) : string
	{
		if (StringUtil.IsEmpty(model))
			return "Error: model is required.";
		return AntigravityTools.SetModel(ToAntigravityNativeContextJson("default", model, ""), model);
	}
}

[SemanticProgram.InfinitivePhrase("to set antigravity working directory")]
[SemanticProgram.InfinitivePhrase("to change antigravity working directory")]
prototype ToSetAntigravityWorkingDirectory : AntigravitySkillAction
{
	Description = @"Sets the working directory for subsequent Antigravity ACP pass-through calls. Pass none/empty to reset.";

	function Execute(string workingDirectory) : string
	{
		return AntigravityTools.SetWorkingDirectory(ToAntigravityNativeContextJson("default", "", workingDirectory), workingDirectory);
	}
}
