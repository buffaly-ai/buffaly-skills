reference Buffaly.Marketing;
import Buffaly.Marketing Buffaly.Marketing.FeedingFrenzyGoogleOperations.GoogleOperationsLocalProofHelper GoogleOperationsLocalProofHelper;
import BasicUtilities BasicUtilities.JsonObject JsonObject;

prototype GoogleAnalyticsSkillAction : OpsAction
{
	Description = @"Base action type for Google Analytics primitive data access tools.";
}

[SemanticEntity("google analytics skill")]
prototype GoogleAnalyticsSkill : SkillEntity
{
	Description = "Primitive GA4 Data API access tools for configured Buffaly.Marketing properties.";
	EntityName = "google analytics skill";
	ActionRoot = GoogleAnalyticsSkillAction;
}

[SemanticProgram.InfinitivePhrase("to list marketing analytics properties")]
[SemanticProgram.InfinitivePhrase("to list google analytics properties")]
prototype ToListMarketingAnalyticsProperties : GoogleAnalyticsSkillAction
{
	Description = @"Returns configured GA4 property aliases, account IDs, property IDs, and API property names as JSON.";

	function Execute(FeedingFrenzyWebPropertiesJsonWsService service) : string
	{
		if (service == null) return "Error: FeedingFrenzyWebPropertiesJsonWsService binding is required.";
		return service.CallWebPropertiesRoute("google-operations/list-marketing-analytics-properties", new JsonObject());
	}
}

[SemanticProgram.InfinitivePhrase("to test marketing analytics access")]
[SemanticProgram.InfinitivePhrase("to test google analytics property access")]
prototype ToTestMarketingAnalyticsAccess : GoogleAnalyticsSkillAction
{
	Description = @"propertyAlias - configured GA4 property alias. startDate/endDate - GA4 date strings such as 7daysAgo/yesterday. Returns access status JSON.";

	function Execute(FeedingFrenzyWebPropertiesJsonWsService service, string propertyAlias, string startDate, string endDate) : string
	{
		if (service == null) return "Error: FeedingFrenzyWebPropertiesJsonWsService binding is required.";
		JsonObject args = new JsonObject(); args["PropertyAlias"] = propertyAlias; args["StartDate"] = startDate; args["EndDate"] = endDate;
		return service.CallWebPropertiesRoute("google-operations/test-marketing-analytics-access", args);
	}
}

[SemanticProgram.InfinitivePhrase("to run a marketing analytics report")]
[SemanticProgram.InfinitivePhrase("to run a google analytics report")]
prototype ToRunMarketingAnalyticsReport : GoogleAnalyticsSkillAction
{
	Description = @"propertyAlias - configured GA4 property alias. dimensionsCsv/metricsCsv - comma-separated GA4 fields. Returns raw GA4 report JSON wrapped with property metadata.";

	function Execute(FeedingFrenzyWebPropertiesJsonWsService service, string propertyAlias, string startDate, string endDate, string dimensionsCsv, string metricsCsv, int limit) : string
	{
		if (service == null) return "Error: FeedingFrenzyWebPropertiesJsonWsService binding is required.";
		JsonObject args = new JsonObject(); args["PropertyAlias"] = propertyAlias; args["StartDate"] = startDate; args["EndDate"] = endDate; args["DimensionsCsv"] = dimensionsCsv; args["MetricsCsv"] = metricsCsv; args["Limit"] = limit;
		return service.CallWebPropertiesRoute("google-operations/run-marketing-analytics-report", args);
	}
}

[SemanticProgram.InfinitivePhrase("to add a google analytics property")]
[SemanticProgram.InfinitivePhrase("to create a google analytics property")]
[SemanticProgram.InfinitivePhrase("to provision a google analytics property")]
prototype ToAddGoogleAnalyticsProperty : GoogleAnalyticsSkillAction
{
	Description = @"accountId - GA account ID. propertyDisplayName - GA4 property display name. webStreamDisplayName - web stream display name. defaultUri - canonical website URL. proofDirectoryPath - writable local proof directory checked before mutation. Creates or reuses the GA4 property and web stream, then returns the measurement ID.";

	function Execute(FeedingFrenzyWebPropertiesJsonWsService service, string accountId, string propertyDisplayName, string webStreamDisplayName, string defaultUri, string proofDirectoryPath) : string
	{
		if (service == null) return "Error: FeedingFrenzyWebPropertiesJsonWsService binding is required.";
		GoogleOperationsLocalProofHelper.PreflightAndPersistEvidence(proofDirectoryPath, "GoogleAnalytics.AddGoogleAnalyticsProperty");
		JsonObject args = new JsonObject(); args["AccountID"] = accountId; args["PropertyDisplayName"] = propertyDisplayName; args["WebStreamDisplayName"] = webStreamDisplayName; args["DefaultUri"] = defaultUri;
		string result = service.CallWebPropertiesRoute("google-operations/add-google-analytics-property", args);
		return GoogleOperationsLocalProofHelper.PersistResultEvidence(proofDirectoryPath, "GoogleAnalytics.AddGoogleAnalyticsProperty", result);
	}
}

[SemanticProgram.InfinitivePhrase("to run an advanced google analytics report")]
prototype ToRunMarketingAnalyticsReportAdvanced : GoogleAnalyticsSkillAction
{
	function Execute(FeedingFrenzyWebPropertiesJsonWsService service, string propertyAlias, string startDate, string endDate, string dimensionsCsv, string metricsCsv, int limit, int offset, string orderByCsv, string dimensionFilterJson) : string
	{
		if (service == null)
		{
			return "Error: FeedingFrenzyWebPropertiesJsonWsService binding is required.";
		}
		JsonObject args = new JsonObject();
		args["PropertyAlias"] = propertyAlias;
		args["StartDate"] = startDate;
		args["EndDate"] = endDate;
		args["DimensionsCsv"] = dimensionsCsv;
		args["MetricsCsv"] = metricsCsv;
		args["Limit"] = limit;
		args["Offset"] = offset;
		args["OrderByCsv"] = orderByCsv;
		args["DimensionFilterJson"] = dimensionFilterJson;
		return service.CallWebPropertiesRoute("google-operations/run-marketing-analytics-report-advanced", args);
	}
	Description = @"FF-owned GA report with explicit offset, orderByCsv and GA4 DimensionFilterJson. Preserves arbitrary dimensions, metrics and date ranges; uses only the FF service credential.";
}
