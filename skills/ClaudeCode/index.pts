reference Buffaly.Tools.ClaudeCode;
import Buffaly.Tools.ClaudeCode Buffaly.Tools.ClaudeCode.ClaudeCodeTools ClaudeCodeTools;
include "RuntimeGlue.pts";

[SemanticEntity("claude code skill")]
[SemanticEntity("claude cli skill")]
[SemanticEntity("anthropic claude skill")]
[SemanticEntity("claude skill")]
[SemanticEntity("anthropic ant skill")]
[SemanticEntity("ant skill")]
[SemanticEntity("anthropic cli skill")]
prototype ClaudeCodeSkill : SkillEntity
{
	Description = "Native Claude Code tool: auth status/login/logout, one-shot prompt execution, and scoped conversation management. Uses the official native claude executable over stream-json. Operator config is editable at Skills/ClaudeCode/config.json.";
	ActionRoot = ClaudeCodeSkillAction;
}

prototype ClaudeCodeSkillAction : OpsAction
{
	Description = @"Base action type for Anthropic Claude Code native tools.";
}
[SemanticProgram.InfinitivePhrase("to check claude auth status")]
[SemanticProgram.InfinitivePhrase("to get claude auth status")]
[SemanticProgram.InfinitivePhrase("to get ant auth status")]
[SemanticProgram.InfinitivePhrase("to check ant auth status")]
[SemanticProgram.InfinitivePhrase("to check if ant is installed and authenticated")]
prototype ToGetClaudeAuthStatus : ClaudeCodeSkillAction
{
	Description = @"Returns whether the native Claude Code executable is configured and whether a cheap auth status probe succeeds. Non-secret status only.";

	function Execute() : string
	{
		string contextJson = ToClaudeNativeContextJson("default", "", "");
		string handle = ClaudeCodeTools.BeginProbe(ToClaudeNativeConfigJson(), contextJson, _opsAgent.GetCurrentOperationCancellationToken());
		string result = ToClaudeNativeRunHandle(handle);
		ClaudeCodeTools.Release(handle);
		return result;
	}
}

[SemanticProgram.InfinitivePhrase("to login to claude")]
[SemanticProgram.InfinitivePhrase("to sign in to claude")]
[SemanticProgram.InfinitivePhrase("to begin claude login")]
[SemanticProgram.InfinitivePhrase("to log in to claude")]
[SemanticProgram.InfinitivePhrase("to begin ant login")]
[SemanticProgram.InfinitivePhrase("to sign in to ant")]
[SemanticProgram.InfinitivePhrase("to login to ant")]
[SemanticProgram.InfinitivePhrase("to log in to ant")]
prototype ToBeginClaudeLogin : ClaudeCodeSkillAction
{
	Description = @"Starts official native claude auth login for the configured profile. timeoutSeconds defaults to 360.";

	function Execute(int timeoutSeconds) : string
	{
		if (timeoutSeconds <= 0)
			timeoutSeconds = 360;
		string contextJson = ClaudeCodeTools.CreateTurnRequestJson(_opsAgent.GetSessionKeyOrEmpty(), _opsAgent.GetCurrentSessionDirectory(), _opsAgent.GetCurrentProjectDirectory(), _opsAgent.GetCurrentToolInvocationIdOrEmpty(), _opsAgent.GetCurrentToolMessageKeyOrEmpty(), _opsAgent.GetCurrentTurnKeyOrEmpty(), "default", "login", "", "", timeoutSeconds, "", false);
		string handle = ClaudeCodeTools.BeginLogin(ToClaudeNativeConfigJson(), contextJson, _opsAgent.GetCurrentOperationCancellationToken());
		string result = ToClaudeNativeRunHandle(handle);
		ClaudeCodeTools.Release(handle);
		return result;
	}
}

[SemanticProgram.InfinitivePhrase("to logout of claude")]
[SemanticProgram.InfinitivePhrase("to sign out of claude")]
[SemanticProgram.InfinitivePhrase("to logout claude account")]
[SemanticProgram.InfinitivePhrase("to logout ant account")]
[SemanticProgram.InfinitivePhrase("to sign out of ant")]
[SemanticProgram.InfinitivePhrase("to logout of ant")]
prototype ToLogoutClaudeAccount : ClaudeCodeSkillAction
{
	Description = @"Logs out of the configured native Claude Code profile using the official auth logout command.";

	function Execute() : string
	{
		string contextJson = ToClaudeNativeContextJson("default", "", "");
		string handle = ClaudeCodeTools.BeginLogout(ToClaudeNativeConfigJson(), contextJson, _opsAgent.GetCurrentOperationCancellationToken());
		string result = ToClaudeNativeRunHandle(handle);
		ClaudeCodeTools.Release(handle);
		return result;
	}
}
[SemanticProgram.InfinitivePhrase("to run a claude prompt")]
[SemanticProgram.InfinitivePhrase("to execute a claude prompt")]
[SemanticProgram.InfinitivePhrase("to send a prompt to claude")]
[SemanticProgram.InfinitivePhrase("to run an ant prompt")]
[SemanticProgram.InfinitivePhrase("to execute an ant prompt")]
[SemanticProgram.InfinitivePhrase("to send a prompt to ant")]
prototype ToRunClaudePrompt : ClaudeCodeSkillAction
{
	Description = @"prompt - required one-shot prompt text.
model - optional model name or alias.
system - optional system prompt.
maxTokens - optional (not directly supported by native Claude Code, ignored).
temperature - optional (not directly supported by native Claude Code, ignored).
workingDirectory - optional cwd for the native process.
timeoutSeconds - nonpositive values resolve to 3600.
Runs the native Claude executable for one ephemeral turn and returns a text-compatible result.";

	function Execute(string prompt, string model, string system, int maxTokens, string temperature, string workingDirectory, int timeoutSeconds) : string
	{
		if (StringUtil.IsEmpty(prompt))
			return "Error: prompt is required.";
		string scope = "oneshot-" + _opsAgent.GetCurrentToolInvocationIdOrEmpty();
		if (StringUtil.IsEmpty(scope) || scope == "oneshot-")
			scope = "oneshot-default";
		return ToClaudeNativeTurn(scope, prompt, model, system, timeoutSeconds, workingDirectory, true);
	}
}

[SemanticProgram.InfinitivePhrase("to start a new scoped claude conversation")]
[SemanticProgram.InfinitivePhrase("to reset scoped claude conversation")]
[SemanticProgram.InfinitivePhrase("to start fresh scoped claude")]
prototype ToStartScopedClaudeConversation : ClaudeCodeSkillAction
{
	Description = @"stateScope - required caller-owned scope such as a Buffaly session key. model - optional model for the scoped conversation. Clears the native session binding for that explicit scope.";

	function Execute(string stateScope, string model) : string
	{
		if (StringUtil.IsEmpty(stateScope))
			return "Error: stateScope is required for scoped Claude state.";
		string contextJson = ToClaudeNativeContextJson(stateScope, model, "");
		return ClaudeCodeTools.ResetConversation(ToClaudeNativeConfigJson(), contextJson);
	}
}

[SemanticProgram.InfinitivePhrase("to set scoped claude working directory")]
[SemanticProgram.InfinitivePhrase("to change scoped claude working directory")]
prototype ToSetScopedClaudeWorkingDirectory : ClaudeCodeSkillAction
{
	Description = @"stateScope - required caller-owned scope such as a Buffaly session key. workingDirectory - directory for subsequent ToTalkToClaude calls using that scope, or none/empty to reset.";

	function Execute(string stateScope, string workingDirectory) : string
	{
		if (StringUtil.IsEmpty(stateScope))
			return "Error: stateScope is required for scoped Claude state.";
		string contextJson = ToClaudeNativeContextJson(stateScope, "", workingDirectory);
		return ClaudeCodeTools.SetWorkingDirectory(ToClaudeNativeConfigJson(), contextJson, workingDirectory);
	}
}
[SemanticProgram.InfinitivePhrase("to run claude state scoping regression")]
[SemanticProgram.InfinitivePhrase("to test claude state scoping")]
prototype ToRunClaudeCodeStateScopingRegression : ClaudeCodeSkillAction
{
	Description = @"Runs the production ClaudeCode state-scoping regression without calling external Claude. It exercises the collision-resistant conversation identity hash.";

	function Execute() : string
	{
		string owner = _opsAgent.GetSessionKeyOrEmpty();
		if (StringUtil.IsEmpty(owner))
			owner = "regression-owner";
		string mappedA = ClaudeCodeTools.HashConversationIdentity("test-install", "claude_code", "test-profile", 1, owner, "collision/a");
		string mappedB = ClaudeCodeTools.HashConversationIdentity("test-install", "claude_code", "test-profile", 1, owner, "collision\\a");
		if (mappedA == mappedB)
			return "FAIL: colliding scopes mapped to the same identity hash: " + mappedA;
		return "PASS: scoped Claude identity hashes are distinct.`nScopeA=" + mappedA + "`nScopeB=" + mappedB;
	}
}

[SemanticProgram.InfinitivePhrase("to talk to claude")]
[SemanticProgram.InfinitivePhrase("to chat with claude")]
[SemanticProgram.InfinitivePhrase("to ask claude")]
[SemanticProgram.InfinitivePhrase("to send a message to claude")]
[SemanticProgram.InfinitivePhrase("to pass through to claude")]
[SemanticProgram.InfinitivePhrase("to talk to ant")]
[SemanticProgram.InfinitivePhrase("to chat with ant")]
[SemanticProgram.InfinitivePhrase("to ask ant")]
[SemanticProgram.InfinitivePhrase("to send a message to ant")]
[SemanticProgram.InfinitivePhrase("to pass through to ant")]
prototype ToTalkToClaude : ClaudeCodeSkillAction
{
	Description = @"prompt - the user's message to forward to Claude.
stateScope - required caller-owned scope such as a Buffaly session key. This prevents concurrent sessions from sharing Claude state.
model - optional model override.
system - optional system prompt override.
timeoutSeconds - nonpositive values resolve to 3600.
This is the main pass-through action. Long prompts are sent as original text.";

	function Execute(string prompt, string stateScope, string model, string system, int timeoutSeconds) : string
	{
		if (StringUtil.IsEmpty(prompt))
			return "Error: prompt is required.";
		if (StringUtil.IsEmpty(stateScope))
			return "Error: stateScope is required. Pass the Buffaly source session key or another stable caller-owned scope before using ToTalkToClaude.";
		return ToClaudeNativeTurn(stateScope, prompt, model, system, timeoutSeconds, "", false);
	}
}
[SemanticProgram.InfinitivePhrase("to start a new claude conversation")]
[SemanticProgram.InfinitivePhrase("to reset claude conversation")]
[SemanticProgram.InfinitivePhrase("to start fresh with claude")]
[SemanticProgram.InfinitivePhrase("to start a new ant conversation")]
[SemanticProgram.InfinitivePhrase("to reset ant conversation")]
[SemanticProgram.InfinitivePhrase("to start fresh with ant")]
prototype ToStartNewClaudeConversation : ClaudeCodeSkillAction
{
	Description = @"Clears the current claude pass-through conversation context so the next ToTalkToClaude call starts fresh. Optional model parameter to set the model for the new conversation.";

	function Execute(string model) : string
	{
		string contextJson = ToClaudeNativeContextJson("default", model, "");
		return ClaudeCodeTools.ResetConversation(ToClaudeNativeConfigJson(), contextJson);
	}
}

[SemanticProgram.InfinitivePhrase("to get claude conversation state")]
[SemanticProgram.InfinitivePhrase("to check claude conversation status")]
[SemanticProgram.InfinitivePhrase("to get ant conversation state")]
[SemanticProgram.InfinitivePhrase("to check ant conversation status")]
prototype ToGetClaudeConversationState : ClaudeCodeSkillAction
{
	Description = @"Returns the current claude pass-through state: native session id, model, working directory, and generation.";

	function Execute() : string
	{
		return ClaudeCodeTools.GetConversationState(ToClaudeNativeConfigJson(), ToClaudeNativeContextJson("default", "", ""));
	}
}

[SemanticProgram.InfinitivePhrase("to get claude usage stats")]
[SemanticProgram.InfinitivePhrase("to check claude usage")]
prototype ToGetClaudeUsageStats : ClaudeCodeSkillAction
{
	Description = @"Returns the latest available Claude account, context, turn, and session usage telemetry. stateScope optionally selects a delegated Claude conversation. Unsupported fields are returned as partial telemetry and never fail normal Claude calls.";

	function Execute(string stateScope) : string
	{
		if (StringUtil.IsEmpty(stateScope))
			stateScope = "default";
		string contextJson = ToClaudeNativeContextJson(stateScope, "", "");
		string handle = ClaudeCodeTools.BeginUsage(ToClaudeNativeConfigJson(), contextJson, _opsAgent.GetCurrentOperationCancellationToken());
		string resultJson = ToClaudeNativeRunHandleJson(handle);
		ClaudeCodeTools.Release(handle);
		return ClaudeCodeTools.GetResultText(resultJson);
	}
}

[SemanticProgram.InfinitivePhrase("to set claude model")]
[SemanticProgram.InfinitivePhrase("to switch claude model")]
[SemanticProgram.InfinitivePhrase("to set ant model")]
[SemanticProgram.InfinitivePhrase("to switch ant model")]
prototype ToSetClaudeModel : ClaudeCodeSkillAction
{
	Description = @"Sets the Claude model for subsequent pass-through calls. Does not start a new conversation.";

	function Execute(string model) : string
	{
		if (StringUtil.IsEmpty(model))
			return "Error: model is required.";
		return ClaudeCodeTools.SetModel(ToClaudeNativeConfigJson(), ToClaudeNativeContextJson("default", model, ""), model);
	}
}
[SemanticProgram.InfinitivePhrase("to set claude working directory")]
[SemanticProgram.InfinitivePhrase("to change claude working directory")]
[SemanticProgram.InfinitivePhrase("to set ant working directory")]
[SemanticProgram.InfinitivePhrase("to change ant working directory")]
prototype ToSetClaudeWorkingDirectory : ClaudeCodeSkillAction
{
	Description = @"Sets the working directory for subsequent unscoped Claude pass-through calls. Pass none/empty to reset.";

	function Execute(string workingDirectory) : string
	{
		return ClaudeCodeTools.SetWorkingDirectory(ToClaudeNativeConfigJson(), ToClaudeNativeContextJson("default", "", workingDirectory), workingDirectory);
	}
}

[SemanticProgram.InfinitivePhrase("to set scoped claude model")]
[SemanticProgram.InfinitivePhrase("to switch scoped claude model")]
prototype ToSetScopedClaudeModel : ClaudeCodeSkillAction
{
	Description = @"stateScope - required caller-owned scope such as a Buffaly session key. model - required model to store for that scope. Use this instead of ToSetClaudeModel when concurrent sessions may call Claude.";

	function Execute(string stateScope, string model) : string
	{
		if (StringUtil.IsEmpty(stateScope))
			return "Error: stateScope is required for scoped Claude state.";
		if (StringUtil.IsEmpty(model))
			return "Error: model is required.";
		return ClaudeCodeTools.SetModel(ToClaudeNativeConfigJson(), ToClaudeNativeContextJson(stateScope, model, ""), model);
	}
}

[SemanticProgram.InfinitivePhrase("to get scoped claude conversation state")]
[SemanticProgram.InfinitivePhrase("to check scoped claude conversation status")]
prototype ToGetScopedClaudeConversationState : ClaudeCodeSkillAction
{
	Description = @"stateScope - required caller-owned scope such as a Buffaly session key. Returns the Claude pass-through state for that explicit scope.";

	function Execute(string stateScope) : string
	{
		if (StringUtil.IsEmpty(stateScope))
			return "Error: stateScope is required for scoped Claude state.";
		return ClaudeCodeTools.GetConversationState(ToClaudeNativeConfigJson(), ToClaudeNativeContextJson(stateScope, "", ""));
	}
}
