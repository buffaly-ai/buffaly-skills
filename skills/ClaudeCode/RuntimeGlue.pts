import Buffaly.Agent.Runtime.Abstractions Buffaly.Agent.Runtime.Abstractions.RuntimeUiEventOutputContract RuntimeUiEventOutputContract;
import Buffaly.Agent.Runtime.Abstractions Buffaly.Agent.Runtime.Abstractions.LiveToolInputCollectionRequestContract LiveToolInputCollectionRequestContract;
import Buffaly.Agent.Runtime.Abstractions Buffaly.Agent.Runtime.Abstractions.LiveToolInputCollectionResultContract LiveToolInputCollectionResultContract;

function ToClaudeNativeConfigJson() : string
{
	string configPath = Path.Combine(_opsAgent.GetCurrentProjectDirectory(), "Skills", "ClaudeCode", "config.json");
	if (!File.Exists(configPath))
		throw new InvalidOperationException("ClaudeCode config.json was not found: " + configPath);
	return File.ReadAllText(configPath);
}

function ToClaudeNativeContextJson(string childScope, string model, string workingDirectory) : string
{
	return ClaudeCodeTools.CreateContextJson(_opsAgent.GetSessionKeyOrEmpty(), _opsAgent.GetCurrentSessionDirectory(), _opsAgent.GetCurrentProjectDirectory(), _opsAgent.GetCurrentToolInvocationIdOrEmpty(), _opsAgent.GetCurrentToolMessageKeyOrEmpty(), _opsAgent.GetCurrentTurnKeyOrEmpty(), childScope, model, workingDirectory);
}

function ToClaudeNativeTurnJson(string childScope, string prompt, string model, string system, int timeoutSeconds, string workingDirectory, bool ephemeral) : string
{
	return ClaudeCodeTools.CreateTurnRequestJson(_opsAgent.GetSessionKeyOrEmpty(), _opsAgent.GetCurrentSessionDirectory(), _opsAgent.GetCurrentProjectDirectory(), _opsAgent.GetCurrentToolInvocationIdOrEmpty(), _opsAgent.GetCurrentToolMessageKeyOrEmpty(), _opsAgent.GetCurrentTurnKeyOrEmpty(), childScope, prompt, model, system, timeoutSeconds, workingDirectory, ephemeral);
}

function ToClaudeNativeEmit(string text) : string
{
	if (StringUtil.IsEmpty(text))
		return "";
	_opsAgent.EmitRuntimeUiOutput(new RuntimeUiEventOutputContract
	{
		EventType = "tool-channel-output",
		Stream = "stdout",
		ToolInvocationId = _opsAgent.GetCurrentToolInvocationIdOrEmpty(),
		MessageKey = _opsAgent.GetCurrentToolMessageKeyOrEmpty(),
		Text = text,
		Command = "Claude Code"
	});
	return "";
}

function ToClaudeNativeRunHandle(string handle) : string
{
	string resultJson = ClaudeCodeTools.WaitForTerminalResult(handle, 250);
	return ClaudeCodeTools.FormatLegacyResult(resultJson);
}

function ToClaudeNativeRunHandleJson(string handle) : string
{
	return ClaudeCodeTools.WaitForTerminalResult(handle, 250);
}

function ToClaudeNativeTurn(string childScope, string prompt, string model, string system, int timeoutSeconds, string workingDirectory, bool ephemeral) : string
{
	if (timeoutSeconds <= 0)
		timeoutSeconds = 3600;
	string requestJson = ToClaudeNativeTurnJson(childScope, prompt, model, system, timeoutSeconds, workingDirectory, ephemeral);
	string handle = ClaudeCodeTools.BeginTurn(ToClaudeNativeConfigJson(), requestJson, _opsAgent.GetCurrentOperationCancellationToken());
	string result = "";
	try
	{
		result = ToClaudeNativeRunHandle(handle);
	}
	finally
	{
		ClaudeCodeTools.Release(handle);
	}
	return result;
}
