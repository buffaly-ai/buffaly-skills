function ToTruncatedText(string value, int maxLength) : string
{
	if (StringUtil.IsEmpty(value))
		return "";
	if (maxLength <= 0)
		return "";
	if (value.Length <= maxLength)
		return value;
	return value.Substring(0, maxLength) + "\n...[truncated]";
}

[SemanticProgram.InfinitivePhrase("to build a dotnet project")]
[SemanticProgram.InfinitivePhrase("to build a .net project")]
prototype ToBuildDotNetProject : VisualStudioSkillAction, CodingContext
{
	Description = @"projectPath - .csproj/.sln/.slnx file path or directory containing exactly one project/solution. configuration - build configuration (defaults to Debug). timeoutSeconds - command timeout in seconds (defaults to 120). Returns concise build summary and diagnostics.";

	function Execute(string projectPath, string configuration, int timeoutSeconds) : string
	{
		return DotNetProjects.BuildProject(projectPath, configuration, timeoutSeconds);
	}
}

