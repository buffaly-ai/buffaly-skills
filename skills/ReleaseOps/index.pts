reference Buffaly.ReleaseOps.Client Buffaly.ReleaseOps.Client;
import Buffaly.ReleaseOps.Client Buffaly.ReleaseOps.Client.ReleaseOpsExtensionFacade ReleaseOpsExtensionFacade;

prototype ReleaseOpsSkillAction : OpsAction
{
    Description = @"Base action type for Provisioning-owned ReleaseOps coordinator tools.";
}

[SemanticEntity("release ops skill")]
prototype ReleaseOpsSkill : SkillEntity
{
    Description = "External ReleaseOps coordinator actions available independently of package-managed extensions.";
    ActionRoot = ReleaseOpsSkillAction;
}

[SemanticProgram.InfinitivePhrase("to deploy one web module to staging")]
[SemanticProgram.InfinitivePhrase("to update a web module on staging")]
[SemanticProgram.InfinitivePhrase("to activate one extension on staging")]
[SemanticProgram.InfinitivePhrase("to install one package on staging")]
prototype ToDeployOneBuffalyExtensionToStagingSkill : ReleaseOpsSkillAction
{
    Description = @"Submits one registered WebModule or ProviderModule identity to the persisted ReleaseOps extension-operation coordinator and waits for its exact operation to finish. Never allocates an installer Build ID and never invokes update-all.";

    function Execute(string sourceId, string packageType, string packageId, int timeoutSeconds = 1800) : string
    {
        return ReleaseOpsExtensionFacade.DeployExactExtension(sourceId, packageType, packageId, timeoutSeconds);
    }
}

[SemanticProgram.InfinitivePhrase("to start a full Buffaly installer build")]
[SemanticProgram.InfinitivePhrase("to request a canonical installer build")]
[SemanticProgram.InfinitivePhrase("to queue a full installer build")]
prototype ToRequestFullBuffalyInstallerBuildSkill : ReleaseOpsSkillAction
{
    Description = @"Submits one canonical full installer build to the external ReleaseOps coordinator and immediately returns its immutable Build ID, queue disposition, and polling URL. The build process is owned by ReleaseOps, not by the requesting agent session.";

    function Execute(string buildReason) : string
    {
        return ReleaseOpsExtensionFacade.RequestFullInstallerBuild(buildReason);
    }
}

[SemanticProgram.InfinitivePhrase("to wait for a Buffaly extension operation")]
[SemanticProgram.InfinitivePhrase("to poll an extension operation to terminal state")]
prototype ToWaitForExtensionOperation : ReleaseOpsSkillAction
{
    Description = @"Polls one persisted ReleaseOps extension operation by exact operation ID and returns its terminal typed record.";

    function Execute(string operationId, int timeoutSeconds = 600) : string
    {
        return ReleaseOpsExtensionFacade.WaitForExtensionOperation(operationId, timeoutSeconds);
    }
}

[SemanticProgram.InfinitivePhrase("to monitor an installer build")]
[SemanticProgram.InfinitivePhrase("to wait for an installer build to reach terminal state")]
prototype ToMonitorInstallerBuildProgress : ReleaseOpsSkillAction
{
    Description = @"Polls one immutable installer Build ID through the ReleaseOps API and returns the terminal build record.";

    function Execute(int buildId, int timeoutSeconds = 1800) : string
    {
        return ReleaseOpsExtensionFacade.MonitorInstallerBuild(buildId, timeoutSeconds);
    }
}

[SemanticProgram.InfinitivePhrase("to get installer build evidence")]
[SemanticProgram.InfinitivePhrase("to inspect a failed installer build")]
prototype ToExtractInstallerBuildEvidence : ReleaseOpsSkillAction
{
    Description = @"Returns the persisted ReleaseOps record for one immutable installer Build ID without mutating or rebuilding it.";

    function Execute(int buildId) : string
    {
        return ReleaseOpsExtensionFacade.GetInstallerBuildEvidence(buildId);
    }
}

[SemanticProgram.InfinitivePhrase("to validate a deployment zip artifact")]
[SemanticProgram.InfinitivePhrase("to inspect a deployment package for forbidden files")]
prototype ToValidateDeploymentZipArtifact : ReleaseOpsSkillAction
{
    Description = @"Validates one deployment ZIP before release use. requiredEntriesJson and forbiddenPatternsJson are JSON string arrays. Default forbidden patterns reject configs, database files, backups, certificates/keys, logs, and artifacts/ entries. Returns structured JSON with SHA-256, entries, and failure reasons.";

    function Execute(string zipFilePath, string requiredEntriesJson = "[]", string forbiddenPatternsJson = "", bool failOnForbidden = true) : string
    {
        return ReleaseOpsExtensionFacade.ValidateDeploymentZipArtifact(zipFilePath, requiredEntriesJson, forbiddenPatternsJson, failOnForbidden);
    }
}

[SemanticProgram.InfinitivePhrase("to create a clean rooted deployment zip from dotnet publish output")]
[SemanticProgram.InfinitivePhrase("to package a dotnet project for deployment")]
prototype ToCreateCleanRootedDeploymentZipFromPublish : ReleaseOpsSkillAction
{
    Description = @"Publishes a .NET project to a clean folder, creates a rootless deployment ZIP, validates required and forbidden archive entries, computes SHA-256, and returns structured JSON evidence. Uses safe process arguments instead of shell interpolation.";

    function Execute(string projectPath, string requiredEntriesJson, string outputZipPath, string forbiddenPatternsJson = "", string configuration = "Release", string publishOutputPath = "", bool failOnForbidden = true, int timeoutSeconds = 180) : string
    {
        return ReleaseOpsExtensionFacade.CreateCleanRootedDeploymentZipFromPublish(projectPath, requiredEntriesJson, outputZipPath, forbiddenPatternsJson, configuration, publishOutputPath, failOnForbidden, timeoutSeconds);
    }
}

[SemanticProgram.InfinitivePhrase("to validate HTTPS TLS certificate and deployment revision against ALB nodes")]
[SemanticProgram.InfinitivePhrase("to validate tls against alb nodes")]
[SemanticProgram.InfinitivePhrase("to verify a deployment revision on every alb node")]
prototype ToValidateTlsAgainstAlbNodes : ReleaseOpsSkillAction
{
    Description = @"Read-only release cutover validation for an ALB-backed HTTPS site. Resolves the ALB DNS name, checks every resolved IP for every hostname using curl --resolve, verifies TLS, HTTP success, and the expected deployment revision marker, and returns structured JSON evidence.";

    function Execute(string albDnsName, string hostnamesJson, string expectedRevision, string relativePath, int timeoutSeconds = 20) : string
    {
        return ReleaseOpsExtensionFacade.ValidateTlsAgainstAlbNodes(albDnsName, hostnamesJson, expectedRevision, relativePath, timeoutSeconds);
    }
}
