reference Buffaly.Agent.Tools.SemanticDatabase Buffaly.Agent.Tools.SemanticDatabase;
import Buffaly.Agent.Tools.SemanticDatabase Buffaly.Agent.Tools.SemanticDatabase.SemanticDatabase SemanticDatabase;
reference Buffaly.Agent.DispatchTree.Viewer Buffaly.Agent.DispatchTree.Viewer;
import Buffaly.Agent.DispatchTree.Viewer Buffaly.Agent.DispatchTree.Viewer.RuntimeDispatchTreeFacade RuntimeDispatchTreeFacade;
import Buffaly.Agent.DispatchTree.Viewer Buffaly.Agent.DispatchTree.Viewer.DispatchNodeSummary DispatchNodeSummary;
import Buffaly.Agent.DispatchTree.Viewer Buffaly.Agent.DispatchTree.Viewer.OntologyTreeRuntimeReader OntologyTreeRuntimeReader;

prototype DispatchAgentActionRoot : OpsAction
{
	Description = @"Action root for bounded session-local dispatch tree lookup and guarded building. Delivery remains outside this skill and belongs to the normal Buffaly agent.";
}

prototype DispatchAgentEntityRoot : SemanticEntityBase
{
	EntityName = "dispatch agent local ontology root";
	Description = @"Entity root for one dispatch agent's session-local hidden-context routing tree.";
}

prototype DispatchTreeSkillAction : DispatchAgentActionRoot
{
	Description = @"Base action type for bounded session-local dispatch tree lookup and guarded building.";
}

[SemanticEntity("dispatch tree skill")]
prototype DispatchTreeSkill : SkillEntity
{
	Description = @"Hierarchical routing and guarded tree building over a dispatcher's session-local semantic memory.";
	ActionRoot = DispatchTreeSkillAction;
}

// Finds an exact node recursively because GetDescendants returns only immediate children.
function FindDispatchNode(Prototype parent, string exactPrototypeName) : Prototype
{
	Collection childPrototypes = parent.GetDescendants();
	foreach (Prototype childPrototype in childPrototypes)
	{
		if (childPrototype.PrototypeName == exactPrototypeName)
			return childPrototype;

		Prototype nestedMatch = FindDispatchNode(childPrototype, exactPrototypeName);
		if (nestedMatch != null)
			return nestedMatch;
	}
	return null;
}

prototype ToGetDispatchTree : DispatchTreeSkillAction, DispatchAgentActionRoot
{
	Description = @"Diagnostic complete-topology projection. Do not use for normal route traversal; it recursively returns node/parent structure without assigned routing evidence. This compatibility action never writes memory, creates a session, queues work, or sends an instruction.";

	function Execute() : Prototype
	{
		Prototype root = _runtime.GetPrototype("DispatchMemoryRoot");
		if (root == null)
			throw new InvalidOperationException("DispatchMemoryRoot was not found in the current session runtime. Restore or seed the reviewed session-local ontology before routing.");
		return GetDescendantsAsDistance(root);
	}
}

[SemanticProgram.InfinitivePhrase("to inspect a dispatch node and its saved examples")]
[SemanticProgram.InfinitivePhrase("to verify one exact dispatch leaf")]
[SemanticProgram.InfinitivePhrase("to read one dispatch node's routing evidence")]
prototype ToGetDispatchNode : DispatchTreeSkillAction, DispatchContext
{
	Description = @"prototypeName - exact prototype name selected beneath DispatchMemoryRoot. Read one exact node with its assigned semantic identity, context summary, historical dispatch examples, status, and exact destination session key. Use only after narrowing to verify a semantic anchor or final leaf. This action never decides a route, sends, or mutates memory.";

	function Execute(string prototypeName) : Prototype
	{
		string exactPrototypeName = prototypeName.Trim();
		if (StringUtil.IsEmpty(exactPrototypeName))
			throw new InvalidOperationException("prototypeName is required.");

		Prototype root = _runtime.GetPrototype("DispatchMemoryRoot");
		if (root == null)
			throw new InvalidOperationException("DispatchMemoryRoot was not found in the current session runtime. Restore or seed the reviewed session-local ontology before routing.");

		Prototype candidatePrototype = FindDispatchNode(root, exactPrototypeName);
		if (candidatePrototype != null)
			return candidatePrototype;

		throw new InvalidOperationException("Dispatch node was not found beneath DispatchMemoryRoot: " + exactPrototypeName);
	}
}

[SemanticProgram.InfinitivePhrase("to find dispatch nodes by semantic meaning")]
[SemanticProgram.InfinitivePhrase("to search dispatch memory for matching work")]
[SemanticProgram.InfinitivePhrase("to find routing-tree anchors for a task")]
prototype ToSearchDispatchMemories : DispatchTreeSkillAction, DispatchContext
{
	Description = @"query - one concise phrase containing distinctive identity, topic, operation, artifact, or constraint terms, not generic dispatch language. maxResults - candidate window from 10 through 20, defaulting to 12. subtreeRootPrototypeName - DispatchMemoryRoot or one exact descendant used to scope a local tie-breaker. Searches only current-session Dispatch Memory tags. Results are compact semantic anchors, never final routes; locate candidates in the graph, traverse immediate children, and verify context and saved examples before reuse.";

	function Execute(string query, int maxResults = 12, string subtreeRootPrototypeName = "DispatchMemoryRoot") : List<DispatchNodeSummary>
	{
		string sessionKey = _opsAgent.GetSessionKeyOrEmpty();
		if (StringUtil.IsEmpty(sessionKey))
			throw new InvalidOperationException("ToSearchDispatchMemories requires an active session key.");
		if (maxResults < 10)
			throw new InvalidOperationException("maxResults must be at least 10 so routing can compare a useful semantic candidate window.");
		if (maxResults > 20)
			throw new InvalidOperationException("maxResults must not exceed 20 for bounded routing context.");
		List<Prototype> candidates = SemanticDatabase.GetScopedCandidatePrototypesBySemanticTagAndCategorySearch(
			query,
			"Dispatch Memory",
			_runtime,
			"session:" + sessionKey,
			"DispatchMemoryRoot",
			subtreeRootPrototypeName,
			0.25,
			maxResults);
		return RuntimeDispatchTreeFacade.ProjectSemanticCandidates(_runtime, candidates, maxResults);
	}
}

[SemanticProgram.InfinitivePhrase("to get dispatch nodes linked to an entity")]
[SemanticProgram.InfinitivePhrase("to find dispatch nodes for a canonical entity")]
prototype ToGetDispatchNodesForEntity : DispatchTreeSkillAction, DispatchContext
{
	Description = @"entity - one unambiguous canonical prototype returned by entity resolution. Return compact Dispatch nodes whose directly assigned Entity property exactly equals that typed prototype. Zero or multiple linked nodes are valid candidate-neighborhood results. This action does not accept a prototype-name string, perform semantic search, choose a route, create or bind entities, mutate memory, or send work.";

	function Execute(Prototype entity, int maxResults = 25) : List<DispatchNodeSummary>
	{
		if (entity == null)
			throw new InvalidOperationException("entity is required.");
		return RuntimeDispatchTreeFacade.GetNodesForEntity(_runtime, entity, maxResults);
	}
}

[SemanticProgram.InfinitivePhrase("to add a child to the local dispatch tree")]
[SemanticProgram.InfinitivePhrase("to create the next dispatch routing node")]
prototype ToAddDispatchChild : DispatchTreeSkillAction, DispatchContext
{
	Description = @"parentPrototypeName - exact existing Dispatch node. childPrototypeName - new ProtoScript identifier. entityName - concise display label. semanticTerms - one or more grounded Dispatch Memory phrases separated by |. contextSummary - short factual routing meaning. Creates exactly one direct child through canonical NLMemory validation and persistence with Entity = null, Value = 0, and an empty HistoricalDispatches collection. It never creates a canonical entity, session, route decision, or delivery.";

	function Execute(string parentPrototypeName, string childPrototypeName, string entityName, string semanticTerms, string contextSummary) : string
	{
		return RuntimeDispatchTreeFacade.AddChild(_runtime, _opsAgent, parentPrototypeName, childPrototypeName, entityName, semanticTerms, contextSummary);
	}
}

[SemanticProgram.InfinitivePhrase("to record a historical dispatch on a routing node")]
[SemanticProgram.InfinitivePhrase("to save a verified dispatch example")]
prototype ToRecordHistoricalDispatch : DispatchTreeSkillAction, DispatchContext
{
	Description = @"prototypeName - exact verified terminal Dispatch node. historicalDispatch - one compact grounded natural-language record containing the object, action, material distinctions, and source or historical destination only when available. Appends once to HistoricalDispatches after successful terminal verification. It does not choose a route, authorize delivery, change SessionKey, create an entity, or modify graph structure.";

	function Execute(string prototypeName, string historicalDispatch) : string
	{
		return RuntimeDispatchTreeFacade.RecordHistoricalDispatch(_runtime, _opsAgent, prototypeName, historicalDispatch);
	}
}

[SemanticProgram.InfinitivePhrase("to list immediate dispatch child nodes")]
[SemanticProgram.InfinitivePhrase("to compare the next dispatch branches")]
[SemanticProgram.InfinitivePhrase("to read one level of the dispatch tree")]
prototype ToGetDispatchChildren : DispatchTreeSkillAction, DispatchContext
{
	Description = @"parentPrototypeName - exact DispatchMemoryRoot node, defaulting to the root. maxResults - bounded child count. Read only the immediate children of one verified node for a top-down traversal step. Returns compact assigned routing evidence, never grandchildren, historical examples, or destination values, and never chooses a branch.";

	function Execute(string parentPrototypeName = "DispatchMemoryRoot", int maxResults = 25) : List<DispatchNodeSummary>
	{
		return RuntimeDispatchTreeFacade.GetChildren(_runtime, parentPrototypeName, maxResults);
	}
}

[SemanticProgram.InfinitivePhrase("to locate a dispatch node in the routing hierarchy")]
[SemanticProgram.InfinitivePhrase("to read the ancestor path for a dispatch node")]
[SemanticProgram.InfinitivePhrase("to place a semantic dispatch match in its tree branch")]
prototype ToGetDispatchPath : DispatchTreeSkillAction, DispatchContext
{
	Description = @"prototypeName - exact semantic candidate beneath DispatchMemoryRoot. Return its compact root-to-node path with direct parent names and assigned context summaries. Use after semantic search only to establish the candidate's lineage. Verify a useful leaf directly; for a useful internal anchor, traverse downward through ToGetDispatchChildren. Do not automatically move upward to compare the anchor's parent or siblings. It never returns examples or destination values and never selects or dispatches a route.";

	function Execute(string prototypeName) : List<DispatchNodeSummary>
	{
		return RuntimeDispatchTreeFacade.GetPath(_runtime, prototypeName);
	}
}

[SemanticProgram.InfinitivePhrase("to read ontology tree root and children")]
prototype ToReadOntologyTree : DispatchTreeSkillAction
{
	Description = @"rootName - exact prototype name to use as tree root. after - optional continuation token for pagination. Returns a JSON string with root node, first page of direct children (max 200), totalChildCount, hasMore, and continuationToken. Read-only; never mutates memory.";

	function Execute(string rootName, string after = "") : string
	{
		return OntologyTreeRuntimeReader.ReadRootJson(_runtime, rootName, after);
	}
}

[SemanticProgram.InfinitivePhrase("to read ontology tree children of a node")]
prototype ToReadOntologyChildren : DispatchTreeSkillAction
{
	Description = @"rootName - exact root prototype name. parentName - exact prototype name of the node to expand. after - optional continuation token for pagination. Returns a JSON string with direct children (max 200), totalChildCount, hasMore, and continuationToken. Read-only; never mutates memory.";

	function Execute(string rootName, string parentName, string after = "") : string
	{
		return OntologyTreeRuntimeReader.ReadChildrenJson(_runtime, rootName, parentName, after);
	}
}
