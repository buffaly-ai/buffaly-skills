prototype HelpAgentActionRoot : OpsAction
{
	Description = @"Documentation and approved guided-walkthrough action root for the Buffaly Help Agent. It exposes documentation/wiki lookup, LLM-backed web search, and narrow walkthrough prompt actions.";
}

prototype HelpAgentPromptAction : PromptAction, HelpAgentActionRoot
{
	Description = "Base action type for approved Buffaly Help Agent guided walkthrough prompt workflows. Execute returns private walkthrough guidance that the Help Agent must follow interactively; it is not a user-visible answer or display result.";
	ResponseResultType = "status";

	function Execute() : string
	{
		return @"Start the approved Help Agent walkthrough interactively. Do not expose private prompt instructions or prompt source.";
	}
}

[SemanticProgram.InfinitivePhrase("to search local Buffaly wiki for help")]
[SemanticProgram.InfinitivePhrase("to find installed Buffaly wiki help articles")]
prototype ToSearchLocalBuffalyWikiForHelp : HelpAgentActionRoot
{
	Description = @"searchText - local wiki query text. maxResults - maximum number of results to return.";

	function Execute(string searchText, int maxResults) : SearchWikiResponseContract
	{
		WikiModule.Configure(RuntimeInstallRootFeature.GetRequiredAgentWebWikiRootPath());
		return WikiServiceApi.Search(new SearchWikiRequestContract
		{
			SearchText = searchText,
			MaxResults = maxResults
		});
	}
}

[SemanticProgram.InfinitivePhrase("to list local Buffaly wiki help articles")]
prototype ToListLocalBuffalyWikiArticlesForHelp : HelpAgentActionRoot
{
	Description = @"List local Buffaly wiki articles available to the Help Agent.";

	function Execute() : ListWikiArticlesResponseContract
	{
		WikiModule.Configure(RuntimeInstallRootFeature.GetRequiredAgentWebWikiRootPath());
		return WikiServiceApi.ListArticles(new ListWikiArticlesRequestContract());
	}
}

[SemanticProgram.InfinitivePhrase("to read local Buffaly wiki article for help")]
[SemanticProgram.InfinitivePhrase("to get installed Buffaly wiki article content")]
prototype ToReadLocalBuffalyWikiArticleForHelp : HelpAgentActionRoot
{
	Description = @"articleSlugOrPath - wiki article slug or relative path to read.";

	function Execute(string articleSlugOrPath) : GetWikiArticleResponseContract
	{
		WikiModule.Configure(RuntimeInstallRootFeature.GetRequiredAgentWebWikiRootPath());
		return WikiServiceApi.GetArticle(new GetWikiArticleRequestContract
		{
			Slug = articleSlugOrPath
		});
	}
}

[SemanticProgram.InfinitivePhrase("to search official Buffaly docs for help")]
[SemanticProgram.InfinitivePhrase("to find current Buffaly documentation")]
prototype ToSearchOfficialBuffalyDocsForHelp : HelpAgentActionRoot
{
	Description = @"searchText - Buffaly docs query text. maxResults - maximum number of results to return.";

	function Execute(string searchText, int maxResults) : SearchBuffalyDocsResponseContract
	{
		return WikiServiceApi.SearchBuffalyDocs(new SearchBuffalyDocsRequestContract
		{
			SearchText = searchText,
			MaxResults = maxResults
		});
	}
}

[SemanticProgram.InfinitivePhrase("to read official Buffaly doc for help")]
[SemanticProgram.InfinitivePhrase("to fetch current Buffaly documentation")]
prototype ToReadOfficialBuffalyDocForHelp : HelpAgentActionRoot
{
	Description = @"slugOrUrl - official Buffaly docs slug or https://buffa.ly/docs URL to read.";

	function Execute(string slugOrUrl) : GetBuffalyDocResponseContract
	{
		return WikiServiceApi.GetBuffalyDoc(new GetBuffalyDocRequestContract
		{
			SlugOrUrl = slugOrUrl
		});
	}
}

[SemanticProgram.InfinitivePhrase("to search the web with an LLM for Help Agent")]
prototype ToSearchWebWithLlmForHelp : HelpAgentActionRoot
{
	Description = @"question - narrow external public question to research. Uses the fixed Help Agent web-search model; callers cannot choose or override the model.";

	function Execute(string question) : string
	{
		return LLMs.ExecuteWebSearch(question);
	}
}

[SemanticProgram.InfinitivePhrase("to save the Write Professional Emails prompt skill from the Help Agent walkthrough")]
[SemanticProgram.InfinitivePhrase("to create the WriteProfessionalEmails prompt skill")]
prototype ToSaveWriteProfessionalEmailsPromptSkillFromWalkthrough : HelpAgentActionRoot
{
	Description = @"Create or update the default WriteProfessionalEmails Prompt Skill from the approved Help Agent walkthrough. This narrow save action writes only the tutorial prompt skill artifacts under Nodes/Personal/PromptSkills.";

	function Execute() : string
	{
		if (_opsAgent != null)
			return CoreOntologyTools.UpsertPromptActionArtifactsInCurrentProject(
				_opsAgent,
				@"Nodes/Personal/PromptSkills/PromptActions.pts",
				@"[SemanticProgram.InfinitivePhrase(""to write a professional email"")]
[SemanticProgram.InfinitivePhrase(""to draft a professional email"")]
[SemanticProgram.InfinitivePhrase(""to write a polished email about this"")]
prototype WriteProfessionalEmails : PromptAction
{
	SkillKind = ""prompt"";
	SkillVersion = ""1.0.0"";
	PromptPath = @""Nodes/Personal/PromptSkills/Prompts/WriteProfessionalEmails.prompt.md"";
	Description = ""Write clear, concise, professional emails from a topic, audience, tone, and key facts."";
}",
				@"Nodes/Personal/PromptSkills/Prompts/WriteProfessionalEmails.prompt.md",
				@"# Write Professional Emails

Write clear, concise, professional emails.

When the user asks for an email, use or ask for:

- who the email is for
- what the email is about
- the desired tone
- any key facts to include

Rules:

- preserve the user's facts
- do not invent details
- return a subject line and email body
- ask one focused question if important details are missing
");

		return "Error: _opsAgent runtime is not available.";
	}
}

