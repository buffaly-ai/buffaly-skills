reference Buffaly.Agent.Tools.TabularData Buffaly.Agent.Tools.TabularData;

import System.Data System.Data.DataTable DataTable;
import Buffaly.Agent.Tools.TabularData Buffaly.Agent.Tools.TabularData.TabularDataFunctions TabularDataFunctions;
import Buffaly.Agent.Tools.TabularData Buffaly.Agent.Tools.TabularData.CsvDataSourceFunctions CsvDataSourceFunctions;
[SemanticProgram.InfinitivePhrase("to load the basic csv walkthrough sample data")]
[SemanticProgram.InfinitivePhrase("load the sample data")]
prototype ToLoadBasicCsvWalkthroughSampleData : HelpAgentActionRoot
{
	Description = @"Load the synthetic medical CSV data for the Basic CSV Download + Export walkthrough and return a native DataTable reference. Uses the shared CSV data source function; no preview JSON is produced here.";

	function Execute() : Prototype
	{
		return BasicCsvWalkthroughGrid.LoadSampleTable();
	}
}

