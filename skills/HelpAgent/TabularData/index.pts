prototype ToGetBasicCsvWalkthroughSampleUrl : HelpAgentActionRoot
{
	Description = @"Return the public GitHub URL for the synthetic medical CSV sample used by the Basic CSV Download + Export walkthrough. The sample is currently shipped on disk; a public URL is not configured yet.";

