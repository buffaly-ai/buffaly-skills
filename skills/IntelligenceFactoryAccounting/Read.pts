[SemanticProgram.InfinitivePhrase("to get an IF accounting report")]
prototype ToGetIfAccountingReport : IntelligenceFactoryAccountingAction
{
	Description = "Read the server-owned report for an inclusive YYYY-MM-DD date period. Returned amounts are authoritative, never recompute them from a ledger page.";
	function Execute(string StartDate, string EndDate) : string
	{
		JsonObject args = new JsonObject();
		args["StartDate"] = StartDate;
		args["EndDate"] = EndDate;
		return IntelligenceFactoryAccountingService#Current.CallRoute("accounting-reports/get-report", args);
	}
}
[SemanticProgram.InfinitivePhrase("to get an IF accounting transaction")]
prototype ToGetIfAccountingTransaction : IntelligenceFactoryAccountingAction
{
	Description = "Read one transaction including immutable bank economics, review fields and provenance.";
	function Execute(int AccountingTransactionID) : string
	{
		JsonObject args = new JsonObject();
		args["AccountingTransactionID"] = AccountingTransactionID;
		return IntelligenceFactoryAccountingService#Current.CallRoute("accounting-transactions/get", args);
	}
}
[SemanticProgram.InfinitivePhrase("to get an IF accounting transaction cohort")]
prototype ToGetIfAccountingTransactionCohort : IntelligenceFactoryAccountingAction
{
	Description = "Read server-owned filtered cohort rows and full-cohort totals. Dates are inclusive YYYY-MM-DD. AccountID/CategoryID 0 means no filter, negative is invalid. Empty BookTreatment/Search/ReviewState means no filter. All flags/page fields must be explicit. Export refuses more than 5000 rows; do not silently truncate or export additional data.";
	function Execute(string StartDate, string EndDate, int AccountID, int CategoryID, string BookTreatment, bool ProfitAndLossOnly, string Search, string ReviewState, bool IncludeVoided, int Page, int PageSize) : string
	{
		JsonObject args = new JsonObject();
		args["Query"] = IntelligenceFactoryAccountingService#Current.Query(StartDate, EndDate, AccountID, CategoryID, BookTreatment, ProfitAndLossOnly, Search, ReviewState, IncludeVoided, Page, PageSize);
		return IntelligenceFactoryAccountingService#Current.CallRoute("accounting-transactions/get-cohort", args);
	}
}
[SemanticProgram.InfinitivePhrase("to export an IF accounting transaction cohort")]
prototype ToExportIfAccountingTransactionCohort : IntelligenceFactoryAccountingAction
{
	Description = "Read server-owned filtered cohort rows and full-cohort totals. Dates are inclusive YYYY-MM-DD. AccountID/CategoryID 0 means no filter, negative is invalid. Empty BookTreatment/Search/ReviewState means no filter. All flags/page fields must be explicit. Export refuses more than 5000 rows; do not silently truncate or export additional data.";
	function Execute(string StartDate, string EndDate, int AccountID, int CategoryID, string BookTreatment, bool ProfitAndLossOnly, string Search, string ReviewState, bool IncludeVoided, int Page, int PageSize) : string
	{
		JsonObject args = new JsonObject();
		JsonObject query = IntelligenceFactoryAccountingService#Current.Query(StartDate, EndDate, AccountID, CategoryID, BookTreatment, ProfitAndLossOnly, Search, ReviewState, IncludeVoided, Page, PageSize);
        query.Remove("Page");
        query.Remove("PageSize");
        args["Query"] = query;
		return IntelligenceFactoryAccountingService#Current.CallRoute("accounting-transactions/export-cohort", args);
	}
}
[SemanticProgram.InfinitivePhrase("to check an IF Chase CSV file")]
prototype ToCheckIfChaseCsv : IntelligenceFactoryAccountingAction
{
	Description = "Read-only validation/duplicate check using the owning Chase parser. ContentBase64 is the exact selected CSV bytes (max 2 MiB), not a reserialized table. This is NOT an import. Return candidate matches/fingerprint; never silently select Skip decisions. Current parser supports BANK checking and CARD ending 0536 only.";
	function Execute(int AccountingAccountID, string FileName, string ContentBase64) : string
	{
		JsonObject input = new JsonObject();
		input["AccountingAccountID"] = AccountingAccountID;
		input["FileName"] = FileName;
		input["ContentBase64"] = ContentBase64;
		JsonObject args = new JsonObject();
		args["Input"] = input;
		return IntelligenceFactoryAccountingService#Current.CallRoute("accounting-import-batches/check-chase-csv", args);
	}
}
