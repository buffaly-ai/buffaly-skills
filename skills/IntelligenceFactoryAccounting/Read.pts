[SemanticProgram.InfinitivePhrase("to get the IF accounting context")]
prototype ToGetIfAccountingContext : IntelligenceFactoryAccountingAction
{
	Description = "Verify the enabled actor and IF local capability. Does not disclose connection strings.";
	function Execute() : string
	{
		return IntelligenceFactoryAccountingService#Current.CallRoute("accounting-context/get-context", new JsonObject());
	}
}
