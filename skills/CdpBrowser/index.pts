prototype CdpBrowserSkillAction : OpsAction, CodingContext
{
	Description = @"Base action type for CDP browser tools.";
}

[SemanticEntity("cdp browser skill")]
[SemanticEntity("cdp browser session skill")]
prototype CdpBrowserSkill : SkillEntity
{
	EntityName = "cdp browser skill";
	Description = @"CDP browser automation tools that connect to the user's real Chrome via Chrome DevTools Protocol. Preserves logins, avoids anti-bot detection, uses trusted input events. Tier 1 actions are always available; Tier 2 actions require approval.";
	ActionRoot = CdpBrowserSkillAction;
}

include "PromptActions.pts";

// ===== Helper Functions =====

function ToCdpCleanOutput(string result) : string
{
	string content = result;
	int outputIdx = content.IndexOf("Output:\n");
	if (outputIdx >= 0)
	{
		content = content.Replace("Output:\n", "");
		int exitIdx = content.IndexOf("Exit code: ");
		if (exitIdx == 0)
		{
			int nlIdx = content.IndexOf("\n");
			if (nlIdx >= 0)
			{
				string exitPrefix = content.Substring(0, nlIdx);
				content = content.Replace(exitPrefix + "\n", "");
			}
			else
				content = "";
		}
		int errorIdx = content.IndexOf("\nError:");
		if (errorIdx >= 0)
			content = content.Substring(0, errorIdx);
		return content.Trim();
	}
	int exitCodeIdx = content.IndexOf("Exit code: ");
	if (exitCodeIdx > 0)
		return content.Substring(0, exitCodeIdx).Trim();
	if (exitCodeIdx == 0)
		return "";
	return content.Trim();
}

function ToCdpJsonEscape(string value) : string
{
	if (value == null || value == "")
		return "";
	string result = value.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\n", "\\n").Replace("\r", "\\r").Replace("\t", "\\t");
	return result;
}

function ToCdpHelperPath() : string
{
	// Use the authoritative runtime project directory instead of reconstructing it through shell environment paths.
	string helper = Path.Combine(_opsAgent.GetCurrentProjectDirectory(), "Skills", "CdpBrowser", "lib", "cdp_helper.js");
	if (!File.Exists(helper))
		return "";
	return helper;
}

function ToCdpRunCommand(string cmdJson, int timeoutSeconds, string label) : string
{
	string helper = ToCdpHelperPath();
	if (StringUtil.IsEmpty(helper))
		return "Error: cdp_helper.js not found. Ensure the CdpBrowser skill is installed.";
	string script = "$ErrorActionPreference='Continue'; $tmp=[System.IO.Path]::GetTempFileName(); Set-Content -LiteralPath $tmp -Value '" + cmdJson.Replace("'", "''") + "' -Encoding utf8 -NoNewline; $result = & node '" + helper.Replace("'", "''") + "' $tmp 2>&1; Remove-Item $tmp -Force -ErrorAction SilentlyContinue; Write-Output $result";
	return SystemOperations.RunPowerShellStreamingToRuntimeUi(script, "", timeoutSeconds, _opsAgent, "", label);
}

function ToCdpGrantFilePath() : string
{
	string sessionDir = _opsAgent.GetCurrentSessionDirectory();
	return Path.Combine(sessionDir, ".cdp", "grant.json");
}

function ToCdpCheckAdvancedApproved() : bool
{
	string grantPath = ToCdpGrantFilePath();
	if (!File.Exists(grantPath))
		return false;
	string content = File.ReadAllText(grantPath);
	string escapedSessionDir = _opsAgent.GetCurrentSessionDirectory().Replace("\\", "\\\\");
	bool hasRequiredGrantFields = content.Contains("\"approvedAt\":") && content.Contains("\"expiresAt\":") && content.Contains("\"scope\":\"all\"") && content.Contains("\"sessionDir\":\"" + escapedSessionDir + "\"");
	return hasRequiredGrantFields && File.GetLastWriteTimeUtc(grantPath).AddHours(4) > DateTime.UtcNow;
}

function ToCdpRequireApproval() : string
{
	if (!ToCdpCheckAdvancedApproved())
		return "Error: Tier 2 actions require approval. Ask the user, then call ToApproveCdpAdvancedActions first.";
	return "";
}

// ===== Approval Actions =====

[SemanticProgram.InfinitivePhrase("to approve CDP advanced actions")]
[SemanticProgram.InfinitivePhrase("to enable Tier 2 CDP browser tools")]
[SemanticProgram.InfinitivePhrase("to unlock privileged CDP browser actions")]
prototype ToApproveCdpAdvancedActions : CdpBrowserSkillAction
{
	Description = @"[Approval] Enables Tier 2 (privileged) CDP browser actions for this session. Tier 2 includes JS execution, cookie access, file upload, tab management, fingerprint modification. Ask the user for explicit approval before calling. Session-scoped, expires after 4 hours.";

	function Execute() : string
	{
		string grantPath = ToCdpGrantFilePath();
		string sessionDir = _opsAgent.GetCurrentSessionDirectory();
		string script = "$p='" + grantPath.Replace("'", "''") + "'; $d=Split-Path -Parent $p; if(-not(Test-Path -LiteralPath $d)){ New-Item -Path $d -ItemType Directory -Force | Out-Null }; $now=[DateTimeOffset]::UtcNow.ToUnixTimeSeconds(); $exp=$now + 14400; $g=@{approvedAt=$now; expiresAt=$exp; scope='all'; sessionDir='" + sessionDir.Replace("'", "''") + "'} | ConvertTo-Json -Compress; Set-Content -LiteralPath $p -Value $g -Encoding utf8 -NoNewline; 'APPROVED'";
		SystemOperations.RunPowerShellStreamingToRuntimeUi(script, "", 5, _opsAgent, "", "CDP Advanced Approve");
		return "Tier 2 CDP actions approved for this session. Expires in 4 hours. Privileged CDP browser tools are now available.";
	}
}

[SemanticProgram.InfinitivePhrase("to revoke CDP advanced actions")]
[SemanticProgram.InfinitivePhrase("to disable Tier 2 CDP browser tools")]
prototype ToRevokeCdpAdvancedActions : CdpBrowserSkillAction
{
	Description = @"[Approval] Revokes Tier 2 approval. Tier 2 actions will fail until re-approved.";

	function Execute() : string
	{
		string grantPath = ToCdpGrantFilePath();
		string script = "$p='" + grantPath.Replace("'", "''") + "'; if(Test-Path -LiteralPath $p){ Remove-Item -LiteralPath $p -Force }";
		SystemOperations.RunPowerShellStreamingToRuntimeUi(script, "", 5, _opsAgent, "", "CDP Advanced Revoke");
		return "Tier 2 CDP actions revoked. Privileged CDP browser tools are no longer available.";
	}
}

// ===== Tier 1: Session Management =====

[SemanticProgram.InfinitivePhrase("to open a CDP browser session")]
[SemanticProgram.InfinitivePhrase("to connect to a running Chrome browser")]
[SemanticProgram.InfinitivePhrase("to start a CDP browser session")]
prototype ToOpenCdpBrowserSession : CdpBrowserSkillAction
{
	Description = @"[Tier 1] Connects to Chrome via CDP, creates a new tab, enables Page/Runtime/DOM/Input domains, optionally navigates to URL. Returns { cdpSessionId, tabId, tabUrl, port }.";

	function Execute(int port, string url) : string
	{
		string cdpCmd = "{\"action\":\"open\",\"port\":" + port + ",\"url\":\"" + ToCdpJsonEscape(url) + "\"}";
		return ToCdpRunCommand(cdpCmd, 30, "CDP Open Session");
	}
}

