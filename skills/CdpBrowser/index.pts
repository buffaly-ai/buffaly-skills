[SemanticProgram.InfinitivePhrase("to set a CDP cookie")]
prototype ToSetCdpCookie : CdpBrowserSkillAction
{
	Description = @"[Tier 2 - Privileged] Sets cookie via Network.setCookie. Modifies session state. Requires approval.";

	function Execute(string cdpSessionId, string name, string value, string domain, string path, bool secure, bool httpOnly) : string
	{
		string check = ToCdpRequireApproval();
		if (!StringUtil.IsEmpty(check))
			return check;
		string secStr = "false";
		if (secure)
			secStr = "true";
		string httpStr = "false";
		if (httpOnly)
			httpStr = "true";
		if (StringUtil.IsEmpty(path))
			path = "/";
		string cdpCmd = "{\"action\":\"set_cookie\",\"cdpSessionId\":\"" + ToCdpJsonEscape(cdpSessionId) + "\",\"name\":\"" + ToCdpJsonEscape(name) + "\",\"value\":\"" + ToCdpJsonEscape(value) + "\",\"domain\":\"" + ToCdpJsonEscape(domain) + "\",\"path\":\"" + ToCdpJsonEscape(path) + "\",\"secure\":" + secStr + ",\"httpOnly\":" + httpStr + "}";
		return ToCdpRunCommand(cdpCmd, 15, "CDP Set Cookie");
	}
}

