// ===== Tier 1: Capture =====

[SemanticProgram.InfinitivePhrase("to capture CDP screenshot")]
[SemanticProgram.InfinitivePhrase("to take a CDP browser screenshot")]
prototype ToCaptureCdpScreenshot : CdpBrowserSkillAction
{
	Description = @"[Tier 1] Captures screenshot via Page.captureScreenshot. CDP-level, not detectable by page. Saves to session artifacts.";

	function Execute(string cdpSessionId, string relativePath, bool fullPage) : string
	{
		string sessionDir = _opsAgent.GetCurrentSessionDirectory();
		string filePath = Path.Combine(sessionDir, "artifacts");
		if (!StringUtil.IsEmpty(relativePath))
			filePath = Path.Combine(filePath, relativePath);
		else
			filePath = Path.Combine(filePath, "cdp-screenshot.png");
		string fpStr = "false";
		if (fullPage)
			fpStr = "true";
		string cdpCmd = "{\"action\":\"screenshot\",\"cdpSessionId\":\"" + ToCdpJsonEscape(cdpSessionId) + "\",\"filePath\":\"" + ToCdpJsonEscape(filePath) + "\",\"fullPage\":" + fpStr + "}";
		return ToCdpRunCommand(cdpCmd, 30, "CDP Screenshot");
	}
}

