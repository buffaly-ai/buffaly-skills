[SemanticProgram.InfinitivePhrase("to run CDP automation")]
prototype ToRunCdpAutomation : CdpBrowserSkillAction
{
	Description = @"[Tier 2 - Privileged] Runs multi-step CDP automation with raw domain access (page, runtime, dom, input, network, emulation). Requires approval.";

	function Execute(string cdpSessionId, string script, string argsJson, int timeoutMs) : string
	{
		string check = ToCdpRequireApproval();
		if (!StringUtil.IsEmpty(check))
			return check;
		string cdpCmd = "{\"action\":\"run_automation\",\"cdpSessionId\":\"" + ToCdpJsonEscape(cdpSessionId) + "\",\"script\":\"" + ToCdpJsonEscape(script) + "\",\"argsJson\":\"" + ToCdpJsonEscape(argsJson) + "\"}";
		return ToCdpRunCommand(cdpCmd, 60, "CDP Run Automation");
	}
}

