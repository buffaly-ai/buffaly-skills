[SemanticProgram.InfinitivePhrase("to run a CDP script")]
[SemanticProgram.InfinitivePhrase("to evaluate JavaScript in a CDP browser")]
prototype ToRunCdpScript : CdpBrowserSkillAction
{
	Description = @"[Tier 2 - Privileged] Evaluates arbitrary JavaScript via Runtime.evaluate. Can touch detectable properties, modify DOM. Requires approval. Use only when Tier 1 actions cannot express the operation.";

	function Execute(string cdpSessionId, string script, string argsJson, int timeoutMs) : string
	{
		string check = ToCdpRequireApproval();
		if (!StringUtil.IsEmpty(check))
			return check;
		string cdpCmd = "{\"action\":\"run_script\",\"cdpSessionId\":\"" + ToCdpJsonEscape(cdpSessionId) + "\",\"script\":\"" + ToCdpJsonEscape(script) + "\"}";
		return ToCdpRunCommand(cdpCmd, 60, "CDP Run Script");
	}
}

