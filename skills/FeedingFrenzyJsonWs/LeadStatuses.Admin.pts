prototype LeadStatuses_GetLeadStatus : FeedingFrenzyJsonWsSkillAction
{
	function Execute(int LeadStatusID) : string
	{
		JsonObject args = new JsonObject();
		args["LeadStatusID"] = LeadStatusID;
		return FeedingFrenzyJsonWsService#Current.CallBusinessRoute("lead-statuses/get-lead-status", args);
	}
}

prototype LeadStatuses_GetLeadStatuses : FeedingFrenzyJsonWsSkillAction
{
	function Execute() : string
	{
		return FeedingFrenzyJsonWsService#Current.CallBusinessRoute("lead-statuses/get-lead-statuses", new JsonObject());
	}
}

prototype LeadStatuses_GetLeadStatusByStatusName : FeedingFrenzyJsonWsSkillAction
{
	function Execute(string StatusName) : string
	{
		JsonObject args = new JsonObject();
		args["StatusName"] = StatusName;
		return FeedingFrenzyJsonWsService#Current.CallBusinessRoute("lead-statuses/get-lead-status-by-status-name", args);
	}
}
