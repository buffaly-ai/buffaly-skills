reference FeedingFrenzy.Agent.Tools FeedingFrenzy.Agent.Tools;
import FeedingFrenzy.Agent.Tools FeedingFrenzy.Agent.Tools.FeedingFrenzyJsonWsClient FeedingFrenzyJsonWsClient;
import FeedingFrenzy.Agent.Tools FeedingFrenzy.Agent.Tools.FeedingFrenzyJsonWsBinding FeedingFrenzyJsonWsBinding;

prototype FeedingFrenzyJsonWsSkillAction : OpsAction
{
	Description = @"Base action type for read-oriented Feeding Frenzy JSON WS service tools.";
}

prototype FeedingFrenzyJsonWsGuardedWriteAction : FeedingFrenzyJsonWsSkillAction
{
	Description = @"Base action type for narrow Feeding Frenzy JSON WS write tools.";
}

[SemanticEntity("feeding frenzy json ws skill")]
prototype FeedingFrenzyJsonWsSkill : SkillEntity
{
	Description = "Feeding Frenzy JSON web service skill exposed through role-composed ProtoScript entry points.";
	ActionRoot = FeedingFrenzyJsonWsSkillAction;
}

prototype FeedingFrenzyJsonWsService : Service
{
	ServiceName = "FeedingFrenzyJsonWsService";
	Scope = "per-binding";
	Description = @"Feeding Frenzy route-based JSON service. Current is configured by authenticated embedded launch. Explicit tenant bindings are for separately authorized diagnostics.";

	String BaseUrl = new String();
	String BusinessApiPrefix = "api/feedingfrenzy.admin.business";
	String CallCenterApiPrefix = "api/feedingfrenzy.callcenter";
	String UiApiPrefix = "api/feedingfrenzy.admin.ui";
	String AutomationsApiPrefix = "api/feedingfrenzy.automations";
	String TokenKey = new String();
	Bool TokenIsAuthorizationToken = false;
	String AutomationUserEmail = new String();

	function ClientBinding() : FeedingFrenzyJsonWsBinding
	{
		return FeedingFrenzyJsonWsClient.Bind(this.BaseUrl, this.TokenKey, this.TokenIsAuthorizationToken, this.BusinessApiPrefix, this.CallCenterApiPrefix, this.UiApiPrefix, this.AutomationsApiPrefix);
	}

	function Initialize() : string
	{
		return FeedingFrenzyJsonWsClient.Initialize(this.ClientBinding());
	}

	function ConfigureAuthorization(string BaseUrl, string AuthorizationToken) : string
	{
		return FeedingFrenzyJsonWsClient.ConfigureAuthorization(this, BaseUrl, AuthorizationToken);
	}

	function CallBusinessRoute(string routePath, JsonObject args) : string
	{
		return FeedingFrenzyJsonWsClient.CallRoute(this.ClientBinding(), "BusinessApiPrefix", routePath, args);
	}

	function CallCallCenterRoute(string routePath, JsonObject args) : string
	{
		return FeedingFrenzyJsonWsClient.CallRoute(this.ClientBinding(), "CallCenterApiPrefix", routePath, args);
	}

	function CallUiRoute(string routePath, JsonObject args) : string
	{
		return FeedingFrenzyJsonWsClient.CallRoute(this.ClientBinding(), "UiApiPrefix", routePath, args);
	}

	// FeedingFrenzy.Automations JsonWs classes (for example AutomationReview) are served under their own assembly prefix.
	function CallAutomationsRoute(string routePath, JsonObject args) : string
	{
		return FeedingFrenzyJsonWsClient.CallRoute(this.ClientBinding(), "AutomationsApiPrefix", routePath, args);
	}
}

[SemanticEntity("current feeding frenzy session service")]
partial prototype FeedingFrenzyJsonWsService#Current : FeedingFrenzyJsonWsService
{
	Description = "Current Feeding Frenzy installation configured by authenticated embedded session launch.";
}

[SemanticEntity("MEDEK feeding frenzy service")]
[SemanticEntity("feeding frenzy remote json ws service")]
[SemanticEntity("remote feeding frenzy json ws")]
partial prototype FeedingFrenzyJsonWsService#Medek : FeedingFrenzyJsonWsService
{
	BaseUrl = "https://ff.intelligencefactory.ai";
	TokenKey = "FeedingFrenzy.Medek.ApiKey";
	AutomationUserEmail = "matt+buffaly@intelligencefactory.ai";
	Description = "Explicit MEDEK production binding for separately authorized diagnostics and automation.";
}

[SemanticEntity("Affinity feeding frenzy service")]
partial prototype FeedingFrenzyJsonWsService#Affinity : FeedingFrenzyJsonWsService
{
	BaseUrl = "https://affinity.feedingfrenzy.ai";
	TokenKey = "FeedingFrenzy.Affinity.ApiKey";
	Description = "Explicit Affinity production binding for separately authorized diagnostics and automation.";
}

[SemanticEntity("feeding frenzy local json ws service")]
[SemanticEntity("local feeding frenzy json ws")]
partial prototype FeedingFrenzyJsonWsService#Local : FeedingFrenzyJsonWsService
{
	BaseUrl = "http://feedingfrenzy.local";
	TokenKey = "FeedingFrenzy.Local.ApiKey";
	Description = "Explicit local development binding for separately authorized diagnostics and automation.";
}
