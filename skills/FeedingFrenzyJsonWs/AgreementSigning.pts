[SemanticProgram.InfinitivePhrase("to create a master services agreement draft for a feeding frenzy lead")]
[SemanticProgram.InfinitivePhrase("to create an msa draft for a lead")]
[SemanticProgram.InfinitivePhrase("to attach a master services agreement draft to a lead")]
prototype ToCreateMasterServicesAgreementDraftForFeedingFrenzyLead : FeedingFrenzyJsonWsSkillAction
{
	Description = @"Creates an unsent Master Services Agreement signing Draft for a Feeding Frenzy lead. service - remote or local FeedingFrenzyJsonWsService binding. LeadID - target lead. MarkdownContent - completed Buffaly-generated MSA Markdown ending with exactly one [[signing-area]]. Feeding Frenzy resolves customer and configured countersigner defaults, attaches the exact Markdown to the lead, and returns the request/note/hash result JSON. This action never sends email.";

	function Execute(FeedingFrenzyJsonWsService service, int LeadID, StringRef MarkdownContent) : string
	{
		if (service == null) return "Error: FeedingFrenzyJsonWsService binding is required.";
		JsonObject args = new JsonObject();
		args["LeadID"] = LeadID;
		args["MarkdownContent"] = MarkdownContent;
		return service.CallBusinessRoute("lead-document-signing-requests/create-master-services-agreement-draft-for-lead", args);
	}
}

