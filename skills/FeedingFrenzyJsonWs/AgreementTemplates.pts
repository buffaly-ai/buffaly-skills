[SemanticProgram.InfinitivePhrase("to insert a feeding frenzy agreement template")]
[SemanticProgram.InfinitivePhrase("to register a feeding frenzy agreement template")]
prototype ToInsertFeedingFrenzyAgreementTemplate : FeedingFrenzyJsonWsGuardedWriteAction
{
    Description = @"Registers one Feeding Frenzy agreement template through the server-owned AgreementTemplates insert route. This only inserts a reusable template; it does not create a signing request or send anything.";
	function Execute(FeedingFrenzyJsonWsService service, string TemplateKey, string DisplayName, string TemplateDescription, string Category, string Cautions, string MarkdownContent, string SourceFileName, bool IsActive, int SortOrder, string Data) : string
