[SemanticProgram.InfinitivePhrase("to list feeding frenzy agreement templates")]
prototype ToListFeedingFrenzyAgreementTemplates : FeedingFrenzyJsonWsSkillAction
{
    Description = @"Lists active current agreement templates that Buffaly may retrieve and customize.";
    function Execute(FeedingFrenzyJsonWsService service) : string
    {
        if (service == null) return "Error: FeedingFrenzyJsonWsService binding is required.";
        return service.CallBusinessRoute("agreement-templates/get-active-agreement-templates", new JsonObject());
    }
}

[SemanticProgram.InfinitivePhrase("to get a feeding frenzy agreement template")]
prototype ToGetFeedingFrenzyAgreementTemplate : FeedingFrenzyJsonWsSkillAction
{
    Description = @"Gets one active current agreement template, including Markdown, by TemplateKey.";
    function Execute(FeedingFrenzyJsonWsService service, string TemplateKey) : string
    {
        if (service == null) return "Error: FeedingFrenzyJsonWsService binding is required.";
        JsonObject args = new JsonObject(); args["TemplateKey"] = TemplateKey;
        return service.CallBusinessRoute("agreement-templates/get-active-agreement-template", args);
    }
}

[SemanticProgram.InfinitivePhrase("to create a feeding frenzy signing draft from markdown")]
prototype ToCreateFeedingFrenzySigningDraftFromMarkdown : FeedingFrenzyJsonWsGuardedWriteAction
{
    Description = @"Attaches completed Markdown to a lead and creates the ordinary document-signing request in Draft. Does not send it.";
    function Execute(FeedingFrenzyJsonWsService service, int LeadID, string DocumentName, string MarkdownContent, string CustomerLegalName, string RecipientName, string RecipientEmail, string ExpirationDate, int ReminderIntervalDays, int ProviderSignerUserID, string SourceFileName, string AgreementTemplateKey) : string
    {
        if (service == null) return "Error: FeedingFrenzyJsonWsService binding is required.";
        JsonObject args = new JsonObject(); args["LeadID"]=LeadID; args["DocumentName"]=DocumentName; args["MarkdownContent"]=MarkdownContent; args["CustomerLegalName"]=CustomerLegalName; args["RecipientName"]=RecipientName; args["RecipientEmail"]=RecipientEmail; args["ExpirationDate"]=ExpirationDate; args["ReminderIntervalDays"]=ReminderIntervalDays; args["ProviderSignerUserID"]=ProviderSignerUserID; args["SourceFileName"]=SourceFileName; args["AgreementTemplateKey"]=AgreementTemplateKey;
        return service.CallBusinessRoute("lead-document-signing-requests/create-buffaly-signing-draft", args);
    }
}
