[SemanticProgram.InfinitivePhrase("to update a feeding frenzy signing draft from markdown")]
[SemanticProgram.InfinitivePhrase("to revise an unsent document signing draft")]
prototype ToUpdateFeedingFrenzySigningDraftFromMarkdown : FeedingFrenzyJsonWsGuardedWriteAction
{
	Description = @"Updates exactly one pristine unsent signing Draft through the server lifecycle owner. Requires expected version/hash, never sends email or mints signing tokens, and returns updated version/hash proof.";
	function Execute(FeedingFrenzyJsonWsService service, int LeadDocumentSigningRequestID, string ExpectedDocumentVersion, string ExpectedMarkdownHash, string DocumentName, string MarkdownContent, string CustomerLegalName, string RecipientName, string RecipientTitle, string RecipientEmail, string ExpirationDate, int ReminderIntervalDays, string Subject, string Message, bool SendCompletedCopyToCustomer, bool SendCompletedCopyToProvider, int ProviderSignerUserID) : string
	{
		JsonObject args = new JsonObject(); args["AutomationUserEmail"]=service.AutomationUserEmail; args["LeadDocumentSigningRequestID"]=LeadDocumentSigningRequestID; args["ExpectedDocumentVersion"]=ExpectedDocumentVersion; args["ExpectedMarkdownHash"]=ExpectedMarkdownHash; args["DocumentName"]=DocumentName; args["MarkdownContent"]=MarkdownContent; args["CustomerLegalName"]=CustomerLegalName; args["RecipientName"]=RecipientName; args["RecipientTitle"]=RecipientTitle; args["RecipientEmail"]=RecipientEmail; args["ExpirationDate"]=ExpirationDate; args["ReminderIntervalDays"]=ReminderIntervalDays; args["Subject"]=Subject; args["Message"]=Message; args["SendCompletedCopyToCustomer"]=SendCompletedCopyToCustomer; args["SendCompletedCopyToProvider"]=SendCompletedCopyToProvider; args["ProviderSignerUserID"]=ProviderSignerUserID;
		return service.CallBusinessRoute("lead-document-signing-requests/update-buffaly-signing-draft-as-automation", args);
