[SemanticProgram.InfinitivePhrase("to create a feeding frenzy user signing draft from markdown")]
prototype ToCreateFeedingFrenzyUserSigningDraftFromMarkdown : FeedingFrenzyJsonWsAdminGuardedWriteAction
{
    Description = @"Creates a user-owned signing Draft only; never creates a lead, prepares a token, or sends email. ReminderIntervalDays: 0 disables reminders (JSON null), positive values set the interval, negative values are rejected. ProviderSignerUserID is the company countersigner, not UserID. Local-file upload preserves exact bytes through the existing JSON byte-array upload route followed by uploaded-reference draft creation; no automatic cleanup on ambiguous failure.";
    function Execute(int UserID, string DocumentName, string MarkdownContent, string CustomerLegalName, string RecipientName, string RecipientEmail, string ExpirationDate, int ReminderIntervalDays, int ProviderSignerUserID, string SourceFileName, string AgreementTemplateKey) : string
    {
        if (ReminderIntervalDays < 0) return "Error: ReminderIntervalDays must be zero (disabled) or a positive integer.";
        if (StringUtil.IsEmpty(FeedingFrenzyJsonWsService#Current.AutomationUserEmail)) return "Error: AutomationUserEmail is required.";
        JsonObject args = new JsonObject(); args["AutomationUserEmail"]=FeedingFrenzyJsonWsService#Current.AutomationUserEmail; args["UserID"]=UserID; args["DocumentName"]=DocumentName; args["CustomerLegalName"]=CustomerLegalName; args["RecipientName"]=RecipientName; args["RecipientEmail"]=RecipientEmail; args["ExpirationDate"]=ExpirationDate; if (ReminderIntervalDays == 0) args["ReminderIntervalDays"] = null; else args["ReminderIntervalDays"] = ReminderIntervalDays; args["ProviderSignerUserID"]=ProviderSignerUserID; args["SourceFileName"]=SourceFileName; args["AgreementTemplateKey"]=AgreementTemplateKey;
        args["MarkdownContent"]=MarkdownContent;
        return FeedingFrenzyJsonWsService#Current.CallBusinessRoute("user-document-signing-requests/create-buffaly-signing-draft-as-automation", args);
    }
}

[SemanticProgram.InfinitivePhrase("to create a feeding frenzy user signing draft from uploaded markdown file")]
