reference "lib/FeedingFrenzy.UserSigning.Client.dll" FeedingFrenzy.UserSigning.Client;
import FeedingFrenzy.UserSigning.Client FeedingFrenzy.UserSigning.Client.SigningBinding SigningBinding;
