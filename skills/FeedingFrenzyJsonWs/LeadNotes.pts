[SemanticProgram.InfinitivePhrase("to get feeding frenzy lead note by id")]
prototype LeadNotes_GetLeadNote : FeedingFrenzyJsonWsSkillAction
{
	Description = @"service - required FeedingFrenzyJsonWsService binding. LeadNoteID - numeric lead note id.";

	function Execute(FeedingFrenzyJsonWsService service, int LeadNoteID) : string
	{
		if (service == null) return "Error: FeedingFrenzyJsonWsService binding is required.";
		JsonObject args = new JsonObject();
		args["LeadNoteID"] = LeadNoteID;
		return service.CallBusinessRoute("lead-notes/get-lead-note", args);
	}
}

