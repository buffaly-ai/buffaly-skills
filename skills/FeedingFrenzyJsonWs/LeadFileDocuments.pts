[SemanticProgram.InfinitivePhrase("to upload a generic file to a Feeding Frenzy lead")]
[SemanticEntity("upload a zip file to a Feeding Frenzy lead")]
[SemanticEntity("attach a generic file to a Feeding Frenzy lead")]
[SemanticEntity("attach a zip file to a Feeding Frenzy lead")]
prototype LeadFileDocuments_InsertFile : FeedingFrenzyJsonWsSkillAction
{
	Description = @"JsonWs wrapper over FeedingFrenzy.Admin.Business.LeadFileDocuments.InsertFile(LeadID, SalesRepID, fileName, contentType, Data). Uploads exact local bytes for any generic lead file, including ZIP packages and HTML bundles, through the existing Feeding Frenzy virtual-file/S3 pipeline and creates an idempotent visible File Attachment LeadNote keyed by LeadID and filename.";

	function Execute(FeedingFrenzyJsonWsService service, int LeadID, int SalesRepresentativeID, string LocalFilePath, string ContentType) : string
	{
		if (service == null) return "Error: FeedingFrenzyJsonWsService binding is required.";
		if (!File.Exists(LocalFilePath)) return "Error: Local file does not exist: " + LocalFilePath;

		JsonObject args = new JsonObject();
		args["LeadID"] = LeadID;
		args["SalesRepID"] = SalesRepresentativeID;
		args["fileName"] = Path.GetFileName(LocalFilePath);
		args["contentType"] = ContentType;
		args["Data"] = File.ReadAllBytes(LocalFilePath);
		return service.CallBusinessRoute("lead-file-documents/insert-file", args);
	}
}
