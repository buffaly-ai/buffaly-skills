[SemanticProgram.InfinitivePhrase("to search feeding frenzy help")]
[SemanticProgram.InfinitivePhrase("to find how to use feeding frenzy")]
prototype FeedingFrenzyWiki_SearchHelp : FeedingFrenzyJsonWsSkillAction
{
	Description = @"SearchText - the user's help question or how-to topic. Returns up to five ranked Feeding Frenzy wiki articles with titles, viewer links, and grounded snippets. Use GetHelpArticle when a result needs full procedural detail.";

	function Execute(string SearchText) : string
	{
		if (StringUtil.IsEmpty(SearchText)) return "Error: SearchText is required.";

		JsonObject request = new JsonObject();
		request["SearchText"] = SearchText;
		request["MaxResults"] = 5;
		request["SnippetLength"] = 320;
		JsonObject args = new JsonObject();
		args["request"] = request;
		return FeedingFrenzyJsonWsService#Current.CallBusinessRoute("wiki-service/search", args);
	}
}

[SemanticProgram.InfinitivePhrase("to read a feeding frenzy help article")]
[SemanticProgram.InfinitivePhrase("to get feeding frenzy instructions")]
prototype FeedingFrenzyWiki_GetHelpArticle : FeedingFrenzyJsonWsSkillAction
{
	Description = @"Slug - exact article slug returned by SearchHelp, for example commerce/creating-a-product. Returns full wiki Markdown for a grounded help answer.";

	function Execute(string Slug) : string
	{
		if (StringUtil.IsEmpty(Slug)) return "Error: Slug is required.";

		JsonObject request = new JsonObject();
		request["Slug"] = Slug;
		JsonObject args = new JsonObject();
		args["request"] = request;
		return FeedingFrenzyJsonWsService#Current.CallBusinessRoute("wiki-service/get-article", args);
	}
}
