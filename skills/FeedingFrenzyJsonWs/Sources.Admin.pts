prototype Sources_GetSource : FeedingFrenzyJsonWsSkillAction
{
	function Execute(int SourceID) : string
	{
		JsonObject args = new JsonObject();
		args["SourceID"] = SourceID;
		return FeedingFrenzyJsonWsService#Current.CallBusinessRoute("sources/get-source", args);
	}
}

prototype Sources_GetSources : FeedingFrenzyJsonWsSkillAction
{
	function Execute() : string
	{
		return FeedingFrenzyJsonWsService#Current.CallBusinessRoute("sources/get-sources", new JsonObject());
	}
}

prototype Sources_GetSourceBySourceName : FeedingFrenzyJsonWsSkillAction
{
	function Execute(string SourceName) : string
	{
		JsonObject args = new JsonObject();
		args["SourceName"] = SourceName;
		return FeedingFrenzyJsonWsService#Current.CallBusinessRoute("sources/get-source-by-source-name", args);
	}
}
