[SemanticProgram.InfinitivePhrase("to get active transcribed calls")]
[SemanticProgram.InfinitivePhrase("to discover active observation calls")]
prototype ToGetActiveTranscribedCalls : FeedingFrenzyJsonWsSkillAction
{
	Description = @"Discovers active transcribed Feeding Frenzy calls from the last 12 hours. service - required remote or local FeedingFrenzyJsonWsService binding. Returns a JSON array of compact call objects with CallID, CallKey, CallStatus, Duration, TranscriptVersion, and LastUpdated. Filters to nonterminal, streamed, realtime-transcribed calls. Capped at 100, newest first. Use this for passive call discovery before polling individual transcripts.";

	function Execute(FeedingFrenzyJsonWsService service) : string
	{
		if (service == null) return "Error: FeedingFrenzyJsonWsService binding is required.";
		JsonObject args = new JsonObject();
		return service.CallCallCenterRoute("calls/get-active-transcribed-calls", args);
	}
}

[SemanticProgram.InfinitivePhrase("to update buffaly observer state")]
[SemanticProgram.InfinitivePhrase("to write buffaly call observation state")]
prototype ToUpdateBuffalyObserverState : FeedingFrenzyJsonWsGuardedWriteAction
{
	Description = @"Writes a bounded Buffaly observer state snapshot to the Feeding Frenzy call row DataObject['BuffalyObserver']. service - required remote or local FeedingFrenzyJsonWsService binding. CallID - numeric call identifier. Sequence - monotonically increasing write sequence; equal or older sequences are ignored. Lifecycle - one of RINGING, IN_PROGRESS, DONE, FAILED, CANCELLED. Category - one of Unknown, HumanAnswered, IVR, Voicemail, InvalidNumber, Screening, DeadAir. Confidence - 0 to 1. Reason - bounded text explanation (max 500 chars). LastTranscriptVersion - transcript version this snapshot is based on. Returns JSON with Accepted (bool) and Sequence (int). This is a guarded write because it modifies FF call data, but it only writes the namespaced BuffalyObserver object and never overwrites native AICallOutcome fields or unrelated DataObject properties.";

	function Execute(FeedingFrenzyJsonWsService service, int CallID, int Sequence, string Lifecycle, string Category, double Confidence, string Reason, int LastTranscriptVersion) : string
	{
		if (service == null) return "Error: FeedingFrenzyJsonWsService binding is required.";
		JsonObject args = new JsonObject();
		args["CallID"] = CallID;
		args["Sequence"] = Sequence;
		args["Lifecycle"] = Lifecycle;
		args["Category"] = Category;
		args["Confidence"] = Confidence;
		args["Reason"] = Reason;
		args["LastTranscriptVersion"] = LastTranscriptVersion;
	return service.CallCallCenterRoute("calls/update-buffaly-observer-state", args);
	}
}
