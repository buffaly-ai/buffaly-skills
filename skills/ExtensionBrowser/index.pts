include "PromptActions.pts";

// ===== Skill Definition =====

prototype ExtensionBrowserSkillAction : OpsAction, CodingContext
{
	Description = @"Base action type for extension browser tools.";
}

[SemanticEntity("extension browser skill")]
prototype ExtensionBrowserSkill : SkillEntity
{
	EntityName = "extension browser skill";
	Description = @"Browser control tools that drive the loaded Buffaly Browser Agent extension via CDP. The extension runs in the user's real browser with their real sessions. Tools include page reading, navigation, click, type, screenshot, tab management, and DOM inspection.";
	ActionRoot = ExtensionBrowserSkillAction;
}

// ===== Helper Functions =====

function ToExtCleanOutput(string result) : string
{
	string content = result;
	int outputIdx = content.IndexOf("Output:\n");
	if (outputIdx >= 0)
	{
		content = content.Replace("Output:\n", "");
		int exitIdx = content.IndexOf("Exit code: ");
		if (exitIdx == 0)
		{
			int nlIdx = content.IndexOf("\n");
			if (nlIdx >= 0)
			{
				string exitPrefix = content.Substring(0, nlIdx);
				content = content.Replace(exitPrefix + "\n", "");
			}
			else
				content = "";
		}
		int errorIdx = content.IndexOf("\nError:");
		if (errorIdx >= 0)
			content = content.Substring(0, errorIdx);
		return content.Trim();
	}
	int exitCodeIdx = content.IndexOf("Exit code: ");
	if (exitCodeIdx > 0)
		return content.Substring(0, exitCodeIdx).Trim();
	if (exitCodeIdx == 0)
		return "";
	return content.Trim();
}

function ToExtJsonEscape(string value) : string
{
	if (value == null || value == "")
		return "";
	return value.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\n", "\\n").Replace("\r", "\\r").Replace("\t", "\\t");
}

function ToExtHelperPath() : string
{
	return Path.Combine(_opsAgent.GetCurrentProjectDirectory(), "Skills", "ExtensionBrowser", "lib", "extension_helper.js");
}

function ToExtRunCommand(string cmdJson, int timeoutSeconds, string label) : string
{
	string helper = ToExtHelperPath();
	if (StringUtil.IsEmpty(helper))
		return "Error: extension_helper.js not found. Ensure the ExtensionBrowser skill is installed.";
	string script = "$ErrorActionPreference='Continue'; $tmp=[System.IO.Path]::GetTempFileName(); Set-Content -LiteralPath $tmp -Value '" + cmdJson.Replace("'", "''") + "' -Encoding utf8 -NoNewline; $result = & node '" + helper.Replace("'", "''") + "' $tmp 2>&1; Remove-Item $tmp -Force -ErrorAction SilentlyContinue; Write-Output $result";
	return SystemOperations.RunPowerShellStreamingToRuntimeUi(script, "", timeoutSeconds, _opsAgent, "", label);
}

// ===== Bridge Path (persistent HTTP bridge to extension SW) =====

function ToExtBridgePath() : string
{
	return Path.Combine(_opsAgent.GetCurrentProjectDirectory(), "Skills", "ExtensionBrowser", "lib", "bridge.js");
}

function ToExtBridgeCall(int bridgePort, string tool, string argsJson, int timeoutSeconds, string label) : string
{
	string script = "try { $body = '{\"tool\":\"' + '" + tool.Replace("'", "''") + "' + '\",\"args\":' + '" + argsJson.Replace("'", "''") + "' + '}'; $resp = Invoke-WebRequest -Uri ('http://127.0.0.1:' + " + bridgePort.ToString() + " + '/tool') -Method POST -Body $body -ContentType 'application/json' -TimeoutSec " + timeoutSeconds.ToString() + " -ErrorAction Stop; Write-Output $resp.Content } catch { Write-Output ('{\"ok\":false,\"error\":\"' + $_.Exception.Message + '\",\"code\":\"BRIDGE_UNREACHABLE\"}') }";
	return SystemOperations.RunPowerShellStreamingToRuntimeUi(script, "", 35, _opsAgent, "", label);
}

function ToExtBridgeStart(int cdpPort, int bridgePort) : string
{
	string bridge = ToExtBridgePath();
	if (StringUtil.IsEmpty(bridge))
		return "Error: bridge.js not found. Ensure the ExtensionBrowser skill is installed.";
	string script = "$proc = Start-Process -FilePath 'node' -ArgumentList @('" + bridge.Replace("'", "''") + "', '" + cdpPort.ToString() + "', '" + bridgePort.ToString() + "') -PassThru -RedirectStandardOutput '" + _opsAgent.GetCurrentSessionDirectory().Replace("'", "''") + "/artifacts/bridge-stdout.log' -RedirectStandardError '" + _opsAgent.GetCurrentSessionDirectory().Replace("'", "''") + "/artifacts/bridge-stderr.log'; Start-Sleep -Seconds 2; try { $resp = Invoke-WebRequest -Uri ('http://127.0.0.1:' + " + bridgePort.ToString() + " + '/health') -TimeoutSec 5 -ErrorAction Stop; Write-Output $resp.Content } catch { Write-Output '{\"ok\":false,\"error\":\"Bridge failed to start\"}' }";
	return SystemOperations.RunPowerShellStreamingToRuntimeUi(script, "", 15, _opsAgent, "", "Extension Bridge Start");
}

// ===== Actions =====

[SemanticProgram.InfinitivePhrase("to call an extension browser tool")]
[SemanticProgram.InfinitivePhrase("to invoke an extension tool")]
prototype ToCallExtensionTool : ExtensionBrowserSkillAction
{
	Description = @"Calls any tool exposed by the Buffaly Browser Agent extension via CDP. The extension must be loaded in a Chromium instance with remote debugging enabled. Returns structured ToolResult JSON.";

	function Execute(int port, string tool, string argsJson) : string
	{
		string cmd = "{\"port\":" + port.ToString() + ",\"tool\":\"" + ToExtJsonEscape(tool) + "\",\"args\":" + argsJson + "}";
		return ToExtRunCommand(cmd, 30, "Extension Tool: " + tool);
	}
}

[SemanticProgram.InfinitivePhrase("to start the extension bridge")]
[SemanticProgram.InfinitivePhrase("to launch the extension bridge")]
prototype ToStartExtensionBridge : ExtensionBrowserSkillAction
{
	Description = @"Starts the persistent HTTP bridge process that maintains a CDP connection to the extension service worker. The bridge listens on http://127.0.0.1:<bridgePort> (HTTP API) and connects to Chrome via CDP WebSocket internally. Forwards tool calls to the extension service worker or falls back to direct CDP. Returns { ok, connected, mode, cdpPort, swUrl }. Call this once before using ToCallExtensionToolViaBridge.";

	function Execute(int cdpPort, int bridgePort) : string
	{
		return ToExtBridgeStart(cdpPort, bridgePort);
	}
}

[SemanticProgram.InfinitivePhrase("to call an extension tool via bridge")]
[SemanticProgram.InfinitivePhrase("to invoke an extension tool via bridge")]
prototype ToCallExtensionToolViaBridge : ExtensionBrowserSkillAction
{
	Description = @"Calls a tool on the extension via the persistent HTTP bridge (POST http://127.0.0.1:<bridgePort>/tool). The bridge must be started first with ToStartExtensionBridge. Faster than ToCallExtensionTool (no per-call process spawn). Auto-reconnects if the SW has suspended or the CDP connection is lost. Returns structured ToolResult JSON { ok, data|error, code? }.";

	function Execute(int bridgePort, string tool, string argsJson) : string
	{
		return ToExtBridgeCall(bridgePort, tool, argsJson, 30, "Extension Bridge Tool: " + tool);
	}
}

[SemanticProgram.InfinitivePhrase("to check extension bridge health")]
prototype ToCheckExtensionBridgeHealth : ExtensionBrowserSkillAction
{
	Description = @"Checks if the extension bridge is running and connected. Returns { ok, connected, mode, cdpPort, swUrl, browserWs }. mode is 'extension' (SW connected) or 'cdp_direct' (browser-level CDP fallback).";

	function Execute(int bridgePort) : string
	{
		string script = "try { $resp = Invoke-WebRequest -Uri ('http://127.0.0.1:' + " + bridgePort.ToString() + " + '/health') -TimeoutSec 5 -ErrorAction Stop; Write-Output $resp.Content } catch { Write-Output '{\"ok\":false,\"error\":\"Bridge not running\"}' }";
		return SystemOperations.RunPowerShellStreamingToRuntimeUi(script, "", 10, _opsAgent, "", "Extension Bridge Health");
	}
}

