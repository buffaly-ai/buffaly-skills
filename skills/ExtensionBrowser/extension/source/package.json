{
  "name": "buffaly-browser-agent",
  "version": "0.2.46",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test:page-context": "node ../../scripts/verify-page-context.mjs",
    "build": "wxt build",
    "zip": "wxt zip",
    "release:check": "npm run typecheck && npm run test:page-context && npm run build && npm run zip && node scripts/verify-release.mjs && npm audit --omit=dev",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.43",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "wxt": "^0.20.0"
  }
}
