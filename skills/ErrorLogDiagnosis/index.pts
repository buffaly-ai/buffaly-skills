import Buffaly.Agent.Runtime.Abstractions Buffaly.Agent.Runtime.Abstractions.InteractiveSiteLaunchRequestContract InteractiveSiteLaunchRequestContract;
import Buffaly.Agent.Runtime.Abstractions Buffaly.Agent.Runtime.Abstractions.InteractiveSiteLaunchResultContract InteractiveSiteLaunchResultContract;
reference Buffaly.Agent.Tools.SemanticDatabase Buffaly.Agent.Tools.SemanticDatabase;
import Buffaly.Agent.Tools.SemanticDatabase Buffaly.Agent.Tools.SemanticDatabase.SemanticDatabase SemanticDatabase;
prototype ErrorLogDiagnosisSkillAction : OpsAction
{
	Description = @"Base action type for Error Log Diagnosis settings and interactive-site tools.";
}

[SemanticEntity("error log diagnosis skill")]
prototype ErrorLogDiagnosisSkill : SkillEntity
{
	Description = "View and manage Error Log Diagnosis scheduled-process settings.";
	ActionRoot = ErrorLogDiagnosisSkillAction;
}

[SemanticProgram.InfinitivePhrase("to search local error memories")]
prototype ToSearchErrorMemories : ErrorLogDiagnosisSkillAction
{
	Description = @"Searches only the current session's scoped Error Memory semantic tag and returns bounded candidates under ErrorMemoryRoot. query - stable error message query. maxResults - candidate limit clamped to 1-25.";

	function Execute(string query, int maxResults = 10) : Collection
	{
		string sessionKey = _opsAgent.GetSessionKeyOrEmpty();
		if (StringUtil.IsEmpty(sessionKey))
		{
			throw new InvalidOperationException("ToSearchErrorMemories requires an active session key.");
		}

		return SemanticDatabase.GetScopedCandidatePrototypesBySemanticTagAndCategorySearch(
			query,
			"Error Memory",
			_runtime,
			"session:" + sessionKey,
			"ErrorMemoryRoot",
			"",
			0.25,
			maxResults);
	}
}

[SemanticProgram.InfinitivePhrase("to search local error memories within a category")]
prototype ToSearchErrorMemoriesInCategory : ErrorLogDiagnosisSkillAction
{
	Description = @"Searches only the current session's scoped Error Memory tag under one ErrorMemoryRoot descendant. query - stable error message query. categoryPrototypeName - exact local ontology category prototype. maxResults - candidate limit clamped to 1-25.";

	function Execute(string query, string categoryPrototypeName, int maxResults = 10) : Collection
	{
		string sessionKey = _opsAgent.GetSessionKeyOrEmpty();
		if (StringUtil.IsEmpty(sessionKey))
		{
			throw new InvalidOperationException("ToSearchErrorMemoriesInCategory requires an active session key.");
		}

		return SemanticDatabase.GetScopedCandidatePrototypesBySemanticTagAndCategorySearch(
			query,
			"Error Memory",
			_runtime,
			"session:" + sessionKey,
			"ErrorMemoryRoot",
			categoryPrototypeName,
			0.25,
			maxResults);
	}
}

[SemanticProgram.InfinitivePhrase("to validate an error memory taxonomy definition")]
prototype ToValidateErrorMemoryDefinition : ErrorLogDiagnosisSkillAction
{
	Description = @"Validates one recursive Error Memory taxonomy branch or routable leaf before NLMemory persistence. prototypeDefinition - exactly one raw ProtoScript definition. definitionKind - Branch or Leaf. Parents may be any depth beneath ErrorMemoryRoot; leaves require scoped Error Memory tags and routing verification fields.";

	function Execute(string prototypeDefinition, string definitionKind) : string
	{
		return SemanticDatabase.ValidateErrorMemoryDefinition(_runtime, prototypeDefinition, definitionKind);
	}
}
