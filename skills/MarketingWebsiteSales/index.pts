[SemanticEntity("marketing website sales skill")]
[SemanticEntity("website sales demo skill")]
[SemanticEntity("website review and seo sales packet skill")]
prototype MarketingWebsiteSalesSkillAction : OpsAction
{
	Description = @"Base action type for website sales/demo workflows: analysis, sales packets, proposal collateral, static demo sites, staging previews, outreach emails, and service-order sales documents. These actions sell or preview website work; they do not implement real client website source projects.";
	Collection Inputs = new Collection();
}

prototype MarketingWebsiteSalesSkill : SkillEntity
{
	EntityName = "marketing website sales skill, website sales demo skill, website review seo sales packet skill";
	Description = @"Website sales/demo workflows for public website audits, demo websites, client-facing reports, proposal decks, sales packets, staging previews, service-order addenda, and outreach emails. Use ClientWebsiteImplementationSkill for real source-controlled client website builds.";
	ActionRoot = MarketingWebsiteSalesSkillAction;
}

[SemanticProgram.InfinitivePhrase("to inspect marketing website sales action inputs")]
prototype ToInspectMarketingWebsiteSalesActionInputs : MarketingWebsiteSalesSkillAction
{
	Description = @"actionPrototype - exact MarketingWebsiteSalesSkillAction prototype name. Returns its resolved ProtoScript Inputs collection as strict JSON.";

	function Execute(string actionPrototype) : string
	{
		MarketingWebsiteSalesSkillAction action = null;
		Collection actions = MarketingWebsiteSalesSkillAction.GetDescendants();
		foreach (Prototype candidate in actions)
		{
			if (candidate.PrototypeName == actionPrototype && candidate typeof MarketingWebsiteSalesSkillAction)
				action = candidate;
		}
		if (action == null)
			throw new InvalidOperationException(@"Marketing website sales action not found: " + actionPrototype);

		JsonArray inputs = new JsonArray();
		foreach (string input in action.Inputs)
			inputs.Add(new JsonValue(input, false));
		JsonObject result = new JsonObject();
		result[@"schemaVersion"] = @"marketing-website-sales-action-inputs/v1";
		result[@"actionPrototype"] = action.PrototypeName;
		result[@"inputs"] = inputs;
		return result.ToJSON();
	}
}

