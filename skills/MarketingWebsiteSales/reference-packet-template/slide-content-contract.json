    {
      "n": 11,
      "visuals": [
        "service-content crops",
        "opportunity cards"
      ],
      "title": "What the Website Adds",
      "gather": [
        "current service content",
        "owned information and patient actions"
      ],
      "rules": [
        "confirm services before promoting them",
        "show durable searchable content and clear actions"
      ]
