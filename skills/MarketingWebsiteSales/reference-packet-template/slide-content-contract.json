    {
      "n": 14,
      "visuals": [
        "three recap cards"
      ],
      "title": "Growth Recap / Control",
      "gather": [
        "paths included",
        "approved proof metrics if any"
      ],
      "rules": [
        "start fast without giving up control",
        "no unsupported stats"
      ]
    },
    {
      "n": 15,
      "visuals": [
        "two timing cards"
      ],
      "title": "Two Clear Starting Paths",
      "gather": [
        "BAA/export needs",
        "scoring timeline support",
        "website access/content assumptions"
      ],
      "rules": [
        "remote care today/5 days/30 days",
        "website today/1 week/1 month",
        "timing caveats"
      ]
    },
    {
      "n": 16,
      "visuals": [
        "decision rows",
        "contact card"
      ],
      "title": "Choose a Starting Path",
      "gather": [
        "sales rep",
        "path applicability",
        "first action per path"
      ],
      "rules": [
        "no false urgency",
        "no ROI promises",
        "no internal language"
      ]
