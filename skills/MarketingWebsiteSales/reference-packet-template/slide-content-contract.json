      "rules": [
        "remote-care-general, never CCM-only or CCML",
        "start manageable and review at 30/60/90 days",
        "keep control of the relationship",
        "confirm terms before launch",
        "no unsupported cancellation, fee, revenue-share, data-exit, or lock-in claims"
      ]
    },
    {
      "n": 4,
      "visuals": [
        "eligibility scoring screenshot",
        "five program cards"
      ],
      "title": "Remote Care Opportunity",
      "gather": [
        "remote-care fit",
        "service relevance",
        "patient scoring/export feasibility"
      ],
      "rules": [
        "show RPM CCM AWV RTM APCM",
        "APCM and RTM prominent",
        "scoring caveat",
        "no reimbursement guarantee"
      ]
    },
    {
      "n": 5,
      "visuals": [
        "work queue screenshot"
      ],
      "title": "One Clear Remote-Care Workflow",
      "gather": [
        "platform capabilities",
        "AI assistance scope",
        "billing readiness scope"
      ],
      "rules": [
        "priority queue -> patient context -> connect/document/confirm readiness",
