        "verified pharmacy identity",
        "verified contact/title",
        "market",
        "month/year"
      ],
      "rules": [
        "no CRM/tool metadata",
        "no unverified title"
      ]
    },
    {
      "n": 2,
      "visuals": [
        "service chips"
      ],
      "title": "Value Proposition",
