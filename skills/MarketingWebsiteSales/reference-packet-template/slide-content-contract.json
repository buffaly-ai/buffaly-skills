    {
      "n": 12,
      "visuals": [
        "opportunity cards"
      ],
      "title": "Website and AI-Answer Opportunity",
      "gather": [
        "patient answer clarity",
        "local search evidence",
        "optional compact contrast"
      ],
      "rules": [
        "AI readiness is public answer clarity, not ranking"
      ]
