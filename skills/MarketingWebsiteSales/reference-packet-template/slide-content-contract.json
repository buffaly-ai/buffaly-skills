    {
      "n": 13,
      "visuals": [
        "comparison table/cards"
      ],
      "title": "Sourced Competitor Comparison",
      "gather": [
        "named competitors/profiles",
        "URLs/identifiers",
        "patient-action facts"
      ],
      "rules": [
        "not map-pack/ranking/review audit",
        "no generic categories only"
      ]
