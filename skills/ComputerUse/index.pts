reference Buffaly.DesktopAutomation Buffaly.DesktopAutomation;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseToolService ComputerUseToolService;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseToolResult ComputerUseToolResult;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseActionResult ComputerUseActionResult;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseClickRequest ComputerUseClickRequest;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseSecondaryActionRequest ComputerUseSecondaryActionRequest;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseSetValueRequest ComputerUseSetValueRequest;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseSelectTextRequest ComputerUseSelectTextRequest;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseScrollRequest ComputerUseScrollRequest;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseDragRequest ComputerUseDragRequest;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUsePressKeyRequest ComputerUsePressKeyRequest;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseTypeTextRequest ComputerUseTypeTextRequest;

prototype ComputerUseSkillAction : OpsAction
{
	Description = @"Base action type for app-aware Computer Use tools.";
}

[SemanticEntity("computer use skill")]
prototype ComputerUseSkill : SkillEntity
{
	Description = "App-aware Computer Use tools for observing and controlling one exact desktop window from the active model session. Call get_app_state before interaction.";
	ActionRoot = ComputerUseSkillAction;
}

function ComputerUseSessionId() : string
{
	return _opsAgent.GetCurrentSessionDirectory();
}

[SemanticProgram.InfinitivePhrase("to list computer use apps")]
prototype list_apps : ComputerUseSkillAction
{
	Description = @"List the apps and visible windows available to Computer Use. This tool is part of plugin Computer Use.";
	function Execute() : ComputerUseToolResult { return ComputerUseToolService.ListApps(ComputerUseSessionId()); }
}

[SemanticProgram.InfinitivePhrase("to get computer app state")]
[SemanticProgram.InfinitivePhrase("to observe a desktop app")]
prototype get_app_state : ComputerUseSkillAction
{
	Description = @"app - app name or process name. Starts or reuses an exact-window lease and returns a screenshot plus accessibility tree. Call once per assistant turn before interaction. This tool is part of plugin Computer Use.";
	function Execute(string app) : ComputerUseToolResult { return ComputerUseToolService.GetAppState(ComputerUseSessionId(), app); }
}

[SemanticProgram.InfinitivePhrase("to click a computer app")]
prototype click : ComputerUseSkillAction
{
	Description = @"app - app name. elementIndex - observed element id, or leave empty and provide screenshot x/y. clickCount defaults to 1. mouseButton is left, right, or middle. This tool is part of plugin Computer Use.";
	function Execute(string app, string elementIndex = "", double x = -1, double y = -1, int clickCount = 1, string mouseButton = "left") : ComputerUseActionResult
	{
		ComputerUseClickRequest request = new ComputerUseClickRequest(); request.App = app; request.ElementIndex = elementIndex; request.X = x; request.Y = y; request.ClickCount = clickCount; request.MouseButton = mouseButton;
		return ComputerUseToolService.Click(ComputerUseSessionId(), request);
	}
}

[SemanticProgram.InfinitivePhrase("to perform a secondary computer app action")]
prototype perform_secondary_action : ComputerUseSkillAction
{
	Description = @"app, elementIndex, action. Invokes one advertised UIA action: invoke, expand, collapse, toggle, select, add_to_selection, remove_from_selection, or scroll_into_view. This tool is part of plugin Computer Use.";
	function Execute(string app, string elementIndex, string action) : ComputerUseActionResult { ComputerUseSecondaryActionRequest request = new ComputerUseSecondaryActionRequest(); request.App = app; request.ElementIndex = elementIndex; request.Action = action; return ComputerUseToolService.PerformSecondaryAction(ComputerUseSessionId(), request); }
}

[SemanticProgram.InfinitivePhrase("to set a computer app value")]
prototype set_value : ComputerUseSkillAction
{
	Description = @"app, elementIndex, value. Sets an enabled settable accessibility element. This tool is part of plugin Computer Use.";
	function Execute(string app, string elementIndex, string value) : ComputerUseActionResult { ComputerUseSetValueRequest request = new ComputerUseSetValueRequest(); request.App = app; request.ElementIndex = elementIndex; request.Value = value; return ComputerUseToolService.SetValue(ComputerUseSessionId(), request); }
}

[SemanticProgram.InfinitivePhrase("to select text in a computer app")]
prototype select_text : ComputerUseSkillAction
{
	Description = @"app, elementIndex, text, prefix(optional), suffix(optional), selection(optional: text, cursor_before, cursor_after). This tool is part of plugin Computer Use.";
	function Execute(string app, string elementIndex, string text, string prefix = "", string suffix = "", string selection = "text") : ComputerUseActionResult { ComputerUseSelectTextRequest request = new ComputerUseSelectTextRequest(); request.App = app; request.ElementIndex = elementIndex; request.Text = text; request.Prefix = prefix; request.Suffix = suffix; request.Selection = selection; return ComputerUseToolService.SelectText(ComputerUseSessionId(), request); }
}

[SemanticProgram.InfinitivePhrase("to scroll a computer app")]
prototype scroll : ComputerUseSkillAction
{
	Description = @"app, elementIndex(optional), direction(up/down/left/right), pages(optional). This tool is part of plugin Computer Use.";
	function Execute(string app, string direction, string elementIndex = "", double pages = 1) : ComputerUseActionResult { ComputerUseScrollRequest request = new ComputerUseScrollRequest(); request.App = app; request.ElementIndex = elementIndex; request.Direction = direction; request.Pages = pages; return ComputerUseToolService.Scroll(ComputerUseSessionId(), request); }
}

[SemanticProgram.InfinitivePhrase("to drag in a computer app")]
prototype drag : ComputerUseSkillAction
{
	Description = @"app and screenshot coordinates fromX, fromY, toX, toY. This tool is part of plugin Computer Use.";
	function Execute(string app, double fromX, double fromY, double toX, double toY) : ComputerUseActionResult { ComputerUseDragRequest request = new ComputerUseDragRequest(); request.App = app; request.FromX = fromX; request.FromY = fromY; request.ToX = toX; request.ToY = toY; return ComputerUseToolService.Drag(ComputerUseSessionId(), request); }
}

[SemanticProgram.InfinitivePhrase("to press a key in a computer app")]
prototype press_key : ComputerUseSkillAction
{
	Description = @"app, key. Presses one key or modifier chord such as Return, Tab, win+c, or Up. This tool is part of plugin Computer Use.";
	function Execute(string app, string key) : ComputerUseActionResult { ComputerUsePressKeyRequest request = new ComputerUsePressKeyRequest(); request.App = app; request.Key = key; return ComputerUseToolService.PressKey(ComputerUseSessionId(), request); }
}

[SemanticProgram.InfinitivePhrase("to type text in a computer app")]
prototype type_text : ComputerUseSkillAction
{
	Description = @"app, text. Types literal text into the exact leased window. This tool is part of plugin Computer Use.";
	function Execute(string app, string text) : ComputerUseActionResult { ComputerUseTypeTextRequest request = new ComputerUseTypeTextRequest(); request.App = app; request.Text = text; return ComputerUseToolService.TypeText(ComputerUseSessionId(), request); }
}


