reference Buffaly.DesktopAutomation Buffaly.DesktopAutomation;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseToolService ComputerUseToolService;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseToolResult ComputerUseToolResult;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseActionResult ComputerUseActionResult;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseTargetSelector ComputerUseTargetSelector;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseGetAppStateRequest ComputerUseGetAppStateRequest;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseClickRequest ComputerUseClickRequest;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseSecondaryActionRequest ComputerUseSecondaryActionRequest;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseSetValueRequest ComputerUseSetValueRequest;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseSelectTextRequest ComputerUseSelectTextRequest;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseScrollRequest ComputerUseScrollRequest;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseDragRequest ComputerUseDragRequest;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseDragRequestBuilder ComputerUseDragRequestBuilder;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUsePressKeyRequest ComputerUsePressKeyRequest;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseTypeTextRequest ComputerUseTypeTextRequest;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseHoverRequest ComputerUseHoverRequest;
import Buffaly.DesktopAutomation Buffaly.DesktopAutomation.ComputerUseFocusElementRequest ComputerUseFocusElementRequest;

prototype ComputerUseSkillAction : OpsAction
{
	Description = @"Base action type for exact-window Computer Use tools. Use opaqueWindowId values returned by list_apps; do not infer or construct native handles.";
}

[SemanticProgram.InfinitivePhrase("to create a computer drag request")]
prototype create_drag_request : ComputerUseSkillAction
{
	Description = @"Build a drag request without sending input. Supply the exact source opaqueWindowId and current expectedObservationId. Coordinates are screenshot coordinates. Returns an opaque native request reference, not JSON. Pass that reference to the drag builder tools or execute_drag_request in this same session. Construction does not refresh an observation. For a cross-window drop, observe both windows and set the destination before execution; toX/toY then use destination screenshot space.";
	function Execute(string opaqueWindowId, string expectedObservationId, double fromX, double fromY, double toX, double toY) : Prototype
	{
		return ComputerUseDragRequestBuilder.Create(opaqueWindowId, expectedObservationId, fromX, fromY, toX, toY);
	}
}

[SemanticProgram.InfinitivePhrase("to add a computer drag waypoint")]
prototype add_drag_waypoint : ComputerUseSkillAction
{
	Description = @"Pass the opaque request reference returned by a drag builder, not a JSON object. Returns a new request reference with one appended waypoint; the original is unchanged. Use the NEW reference for subsequent steps. Waypoint x/y use source screenshot space. Existing execution limits apply: at most 32 waypoints, each dwell 0..1000ms, total dwell at most 5000ms. No input is sent.";
	function Execute(ComputerUseDragRequest request, double x, double y, int dwellMilliseconds) : Prototype
	{
		return ComputerUseDragRequestBuilder.AddWaypoint(request, x, y, dwellMilliseconds);
	}
}

[SemanticProgram.InfinitivePhrase("to add a computer drag modifier")]
prototype add_drag_modifier : ComputerUseSkillAction
{
	Description = @"Pass an opaque drag request reference. Append one exact modifier: ctrl, shift or alt. Returns a new reference; use it for subsequent steps. Duplicate or unsupported modifiers are rejected at execution. No input is sent and no key is held while building.";
	function Execute(ComputerUseDragRequest request, string modifier) : Prototype
	{
		return ComputerUseDragRequestBuilder.AddModifier(request, modifier);
	}
}

[SemanticProgram.InfinitivePhrase("to set a computer drag destination")]
prototype set_drag_destination : ComputerUseSkillAction
{
	Description = @"Pass an opaque drag request reference and the exact destination opaqueWindowId/current expectedObservationId. Returns a new request reference. The request's toX/toY now use destination screenshot space; source and waypoint coordinates remain in source screenshot space. Both observations must still be valid at execution. No input is sent.";
	function Execute(ComputerUseDragRequest request, string opaqueWindowId, string expectedObservationId) : Prototype
	{
		return ComputerUseDragRequestBuilder.SetDestination(request, opaqueWindowId, expectedObservationId);
	}
}

[SemanticProgram.InfinitivePhrase("to execute a computer drag request")]
prototype execute_drag_request : ComputerUseSkillAction
{
	Description = @"Execute the final opaque request reference returned by the drag builders in this same session. Do not supply JSON or invent a reference. Uses the existing Computer Use drag implementation and its platform support, observation, geometry, ownership and bounded-input validation. Construction does not reserve desktop state. After success, observe affected windows again before further input.";
	function Execute(ComputerUseDragRequest request) : ComputerUseActionResult
	{
		string sessionKey = ComputerUseToolService.GetCurrentSessionKey();
		return ComputerUseToolService.Drag(sessionKey, request);
	}
}

[SemanticEntity("computer use skill")]
prototype ComputerUseSkill : SkillEntity
{
	Description = "Exact-window Computer Use tools for observing and controlling one desktop window from the active model session. Call list_apps, choose the exact window, call get_app_state with its opaqueWindowId, then pass that opaqueWindowId plus the returned ObservationId to one mutation. After every successful mutation, call get_app_state again before reusing element ids or observation ids.";
	ActionRoot = ComputerUseSkillAction;
}

[SemanticProgram.InfinitivePhrase("to list computer use apps")]
prototype list_apps : ComputerUseSkillAction
{
	Description = @"List visible top-level app windows/dialogs available to Computer Use. Choose the exact window from the returned metadata and use its opaqueWindowId/WindowId for get_app_state and all later mutations; do not guess or construct native handles. This tool is part of plugin Computer Use.";
	function Execute() : ComputerUseToolResult
	{
		string sessionKey = ComputerUseToolService.GetCurrentSessionKey();
		return ComputerUseToolService.ListApps(sessionKey);
	}
}

[SemanticProgram.InfinitivePhrase("to get computer app state")]
[SemanticProgram.InfinitivePhrase("to observe a desktop app")]
prototype get_app_state : ComputerUseSkillAction
{
	Description = @"Observe the exact opaqueWindowId returned by list_apps. Returns screenshot, accessibility state and ObservationId. Observe again after successful input. Use discover_app_state for bounded search, subtree or continuation options.";
	function Execute(string opaqueWindowId) : ComputerUseToolResult
	{
		string sessionKey = ComputerUseToolService.GetCurrentSessionKey();
		ComputerUseTargetSelector target = new ComputerUseTargetSelector(); target.WindowId = opaqueWindowId;
		ComputerUseGetAppStateRequest request = new ComputerUseGetAppStateRequest(); request.Target = target;
		return ComputerUseToolService.GetAppState(sessionKey, request);
	}
}

[SemanticProgram.InfinitivePhrase("to discover bounded computer app elements")]
prototype discover_app_state : ComputerUseSkillAction
{
	Description = @"Observe the exact opaqueWindowId returned by list_apps. maxElements bounds output (1..1000); visitBudget bounds traversal work (1..2000). searchText filters names. For continuationToken or subtreeElementIndex, supply expectedObservationId from the current page in this session; do not combine continuation and subtree. Continuation preserves searchText and consumes the retained frontier, not an offset rescan. Each page replaces prior element/action leases for this window. Use empty strings for unused discovery fields, maxElements300 and visitBudget600 for defaults. Returns the screenshot, bounded accessibility state, truncation and a fresh ObservationId. Observe again after every successful mutation.";
	function Execute(string opaqueWindowId, int maxElements = 300, int visitBudget = 600, string searchText = "", string continuationToken = "", string subtreeElementIndex = "", string expectedObservationId = "") : ComputerUseToolResult
	{
		string sessionKey = ComputerUseToolService.GetCurrentSessionKey();
		ComputerUseTargetSelector target = new ComputerUseTargetSelector(); target.WindowId = opaqueWindowId;
		ComputerUseGetAppStateRequest request = new ComputerUseGetAppStateRequest(); request.Target = target;
		request.MaxElements = maxElements; request.VisitBudget = visitBudget; request.SearchText = searchText; request.ContinuationToken = continuationToken; request.SubtreeElementIndex = subtreeElementIndex; request.ExpectedObservationId = expectedObservationId;
		return ComputerUseToolService.GetAppState(sessionKey, request);
	}
}

[SemanticProgram.InfinitivePhrase("to click a computer app")]
prototype click : ComputerUseSkillAction
{
	Description = @"opaqueWindowId - exact WindowId returned by list_apps/get_app_state. expectedObservationId - exact ObservationId from the immediately preceding get_app_state for the same opaqueWindowId. elementIndex - observed element id, or leave empty and provide screenshot x/y. clickCount defaults to 1. mouseButton is left, right, or middle. This tool is part of plugin Computer Use.";
	function Execute(string opaqueWindowId, string expectedObservationId, string elementIndex = "", double x = -1, double y = -1, int clickCount = 1, string mouseButton = "left") : ComputerUseActionResult
	{
		string sessionKey = ComputerUseToolService.GetCurrentSessionKey();
		ComputerUseTargetSelector target = new ComputerUseTargetSelector(); target.WindowId = opaqueWindowId;
		ComputerUseClickRequest request = new ComputerUseClickRequest(); request.Target = target; request.ExpectedObservationId = expectedObservationId; request.ElementIndex = elementIndex; request.X = x; request.Y = y; request.ClickCount = clickCount; request.MouseButton = mouseButton;
		return ComputerUseToolService.Click(sessionKey, request);
	}
}

[SemanticProgram.InfinitivePhrase("to perform a secondary computer app action")]
prototype perform_secondary_action : ComputerUseSkillAction
{
	Description = @"opaqueWindowId, expectedObservationId, elementIndex, action. opaqueWindowId is the exact WindowId selected from list_apps/get_app_state. expectedObservationId is the exact ObservationId from the immediately preceding get_app_state for that same window. Invokes one advertised UIA action: invoke, expand, collapse, toggle, select, add_to_selection, remove_from_selection, or scroll_into_view. This tool is part of plugin Computer Use.";
	function Execute(string opaqueWindowId, string expectedObservationId, string elementIndex, string action) : ComputerUseActionResult { string sessionKey = ComputerUseToolService.GetCurrentSessionKey(); ComputerUseTargetSelector target = new ComputerUseTargetSelector(); target.WindowId = opaqueWindowId; ComputerUseSecondaryActionRequest request = new ComputerUseSecondaryActionRequest(); request.Target = target; request.ExpectedObservationId = expectedObservationId; request.ElementIndex = elementIndex; request.Action = action; return ComputerUseToolService.PerformSecondaryAction(sessionKey, request); }
}

[SemanticProgram.InfinitivePhrase("to set a computer app value")]
prototype set_value : ComputerUseSkillAction
{
	Description = @"opaqueWindowId, expectedObservationId, elementIndex, value. opaqueWindowId is the exact WindowId selected from list_apps/get_app_state. expectedObservationId is the exact ObservationId from the immediately preceding get_app_state for that same window. Sets an enabled settable accessibility element. This tool is part of plugin Computer Use.";
	function Execute(string opaqueWindowId, string expectedObservationId, string elementIndex, string value) : ComputerUseActionResult { string sessionKey = ComputerUseToolService.GetCurrentSessionKey(); ComputerUseTargetSelector target = new ComputerUseTargetSelector(); target.WindowId = opaqueWindowId; ComputerUseSetValueRequest request = new ComputerUseSetValueRequest(); request.Target = target; request.ExpectedObservationId = expectedObservationId; request.ElementIndex = elementIndex; request.Value = value; return ComputerUseToolService.SetValue(sessionKey, request); }
}

[SemanticProgram.InfinitivePhrase("to select text in a computer app")]
prototype select_text : ComputerUseSkillAction
{
	Description = @"opaqueWindowId, expectedObservationId, elementIndex, text, prefix(optional), suffix(optional), selection(optional: text, cursor_before, cursor_after). opaqueWindowId is the exact WindowId selected from list_apps/get_app_state. expectedObservationId is the exact ObservationId from the immediately preceding get_app_state for that same window. This tool is part of plugin Computer Use.";
	function Execute(string opaqueWindowId, string expectedObservationId, string elementIndex, string text, string prefix = "", string suffix = "", string selection = "text") : ComputerUseActionResult { string sessionKey = ComputerUseToolService.GetCurrentSessionKey(); ComputerUseTargetSelector target = new ComputerUseTargetSelector(); target.WindowId = opaqueWindowId; ComputerUseSelectTextRequest request = new ComputerUseSelectTextRequest(); request.Target = target; request.ExpectedObservationId = expectedObservationId; request.ElementIndex = elementIndex; request.Text = text; request.Prefix = prefix; request.Suffix = suffix; request.Selection = selection; return ComputerUseToolService.SelectText(sessionKey, request); }
}

[SemanticProgram.InfinitivePhrase("to scroll a computer app")]
prototype scroll : ComputerUseSkillAction
{
	Description = @"opaqueWindowId, expectedObservationId, direction(up/down/left/right), elementIndex(optional), pages(optional). opaqueWindowId is the exact WindowId selected from list_apps/get_app_state. expectedObservationId is the exact ObservationId from the immediately preceding get_app_state for that same window. Every successful mutation invalidates the prior observation; call get_app_state again before reusing element ids or observation ids. This tool is part of plugin Computer Use.";
	function Execute(string opaqueWindowId, string expectedObservationId, string direction, string elementIndex = "", double pages = 1) : ComputerUseActionResult { string sessionKey = ComputerUseToolService.GetCurrentSessionKey(); ComputerUseTargetSelector target = new ComputerUseTargetSelector(); target.WindowId = opaqueWindowId; ComputerUseScrollRequest request = new ComputerUseScrollRequest(); request.Target = target; request.ExpectedObservationId = expectedObservationId; request.ElementIndex = elementIndex; request.Direction = direction; request.Pages = pages; return ComputerUseToolService.Scroll(sessionKey, request); }
}

[SemanticProgram.InfinitivePhrase("to drag in a computer app")]
prototype drag : ComputerUseSkillAction
{
	Description = @"opaqueWindowId, expectedObservationId, and screenshot coordinates fromX, fromY, toX, toY. opaqueWindowId is the exact WindowId selected from list_apps/get_app_state. expectedObservationId is the exact ObservationId from the immediately preceding get_app_state for that same window. Every successful mutation invalidates the prior observation; call get_app_state again before reusing element ids or observation ids. This tool is part of plugin Computer Use.";
	function Execute(string opaqueWindowId, string expectedObservationId, double fromX, double fromY, double toX, double toY) : ComputerUseActionResult { string sessionKey = ComputerUseToolService.GetCurrentSessionKey(); ComputerUseTargetSelector target = new ComputerUseTargetSelector(); target.WindowId = opaqueWindowId; ComputerUseDragRequest request = new ComputerUseDragRequest(); request.Target = target; request.ExpectedObservationId = expectedObservationId; request.FromX = fromX; request.FromY = fromY; request.ToX = toX; request.ToY = toY; return ComputerUseToolService.Drag(sessionKey, request); }
}

[SemanticProgram.InfinitivePhrase("to scroll a chosen computer pane")]
prototype scroll_at : ComputerUseSkillAction
{
	Description = @"Scroll the chosen pane at paired x/y coordinates in the selected observation screenshot. No elementIndex is combined with coordinates. direction is up/down/left/right; pages is greater than zero and at most100. Observe again after success.";
	function Execute(string opaqueWindowId, string expectedObservationId, double x, double y, string direction, double pages = 1) : ComputerUseActionResult
	{
		string sessionKey = ComputerUseToolService.GetCurrentSessionKey();
		ComputerUseTargetSelector target = new ComputerUseTargetSelector(); target.WindowId = opaqueWindowId;
		ComputerUseScrollRequest request = new ComputerUseScrollRequest(); request.Target = target; request.ExpectedObservationId = expectedObservationId; request.X = x; request.Y = y; request.Direction = direction; request.Pages = pages;
		return ComputerUseToolService.Scroll(sessionKey, request);
	}
}

[SemanticProgram.InfinitivePhrase("to hover over a computer app")]
prototype hover : ComputerUseSkillAction
{
	Description = @"Move the pointer without clicking in the exact observed window. x/y use selected screenshot coordinates. dwellMilliseconds is bounded to 0..3000. A successful mutation requires a fresh get_app_state before another action.";
	function Execute(string opaqueWindowId, string expectedObservationId, double x, double y, int dwellMilliseconds = 500) : ComputerUseActionResult
	{
		string sessionKey = ComputerUseToolService.GetCurrentSessionKey();
		ComputerUseTargetSelector target = new ComputerUseTargetSelector(); target.WindowId = opaqueWindowId;
		ComputerUseHoverRequest request = new ComputerUseHoverRequest(); request.Target = target; request.ExpectedObservationId = expectedObservationId; request.X = x; request.Y = y; request.DwellMilliseconds = dwellMilliseconds;
		return ComputerUseToolService.Hover(sessionKey, request);
	}
}

[SemanticProgram.InfinitivePhrase("to press a key in a computer app")]
prototype press_key : ComputerUseSkillAction
{
	Description = @"opaqueWindowId, expectedObservationId, key. opaqueWindowId is the exact WindowId selected from list_apps/get_app_state. expectedObservationId is the exact ObservationId from the immediately preceding get_app_state for that same window. Presses one key or modifier chord such as Return, Tab, win+c, or Up. This tool is part of plugin Computer Use.";
	function Execute(string opaqueWindowId, string expectedObservationId, string key) : ComputerUseActionResult { string sessionKey = ComputerUseToolService.GetCurrentSessionKey(); ComputerUseTargetSelector target = new ComputerUseTargetSelector(); target.WindowId = opaqueWindowId; ComputerUsePressKeyRequest request = new ComputerUsePressKeyRequest(); request.Target = target; request.ExpectedObservationId = expectedObservationId; request.Key = key; return ComputerUseToolService.PressKey(sessionKey, request); }
}

[SemanticProgram.InfinitivePhrase("to type text in a computer app")]
prototype type_text : ComputerUseSkillAction
{
	Description = @"opaqueWindowId, expectedObservationId, text. opaqueWindowId is the exact WindowId selected from list_apps/get_app_state. expectedObservationId is the exact ObservationId from the immediately preceding get_app_state for that same window. Types literal text into the exact leased window. This tool is part of plugin Computer Use.";
	function Execute(string opaqueWindowId, string expectedObservationId, string text) : ComputerUseActionResult { string sessionKey = ComputerUseToolService.GetCurrentSessionKey(); ComputerUseTargetSelector target = new ComputerUseTargetSelector(); target.WindowId = opaqueWindowId; ComputerUseTypeTextRequest request = new ComputerUseTypeTextRequest(); request.Target = target; request.ExpectedObservationId = expectedObservationId; request.Text = text; return ComputerUseToolService.TypeText(sessionKey, request); }
}


[SemanticProgram.InfinitivePhrase("to focus an observed computer element")]
prototype focus_element : ComputerUseSkillAction
{
	function Execute(string opaqueWindowId, string expectedObservationId, string elementIndex) : ComputerUseActionResult
	{
		string sessionKey = ComputerUseToolService.GetCurrentSessionKey();
		ComputerUseTargetSelector target = new ComputerUseTargetSelector();
		target.WindowId = opaqueWindowId;
		ComputerUseFocusElementRequest request = new ComputerUseFocusElementRequest();
		request.Target = target;
		request.ExpectedObservationId = expectedObservationId;
		request.ElementIndex = elementIndex;
		return ComputerUseToolService.FocusElement(sessionKey, request);
	}
	Description = @"Explicitly request focus on one observed element in the exact window. Requires opaqueWindowId, expectedObservationId and elementIndex. Linux binds native object identity, process lifetime and ancestry, requests focus once, then verifies the exact window ACTIVE and exact element FOCUSED. The attempt consumes the observation even on failure; call get_app_state again before any further action. Other input does not activate automatically. Unsupported platforms reject explicitly. This is not an advertised native secondary action and sends no keyboard or pointer input.";
}
