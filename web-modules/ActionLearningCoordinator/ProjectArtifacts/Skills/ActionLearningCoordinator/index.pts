[SemanticProgram.InfinitivePhrase("to attach an online memory critic batch worker to a source session")]
prototype ToAttachOnlineMemoryCriticBatchWorker : OnlineMemoryCriticBatchCoordinatorSkillAction
{
	function Execute(string sourceSessionKey, string workerSessionKey) : string
	{
		JsonObject attached = new JsonObject(OnlineMemoryCriticBatchProjection.AttachWorker(Sessions.GetSessionsRootPath(), sourceSessionKey, workerSessionKey));
		string resolvedWorkerSessionKey = attached.GetStringOrFail(@"WorkerSessionKey", @"Attached critic worker key is required.");
		JsonObject receipt = new JsonObject(ToAddSessionWorkEntry.Execute(sourceSessionKey));
		JsonObject ledger = receipt.GetJsonObjectOrFail(@"Ledger", @"Session work attachment receipt Ledger is required.");
		JsonArray entries = ledger.GetJsonArrayOrFail(@"Entries", @"Session work ledger Entries is required.");
		foreach (JsonValue value in entries)
		{
			JsonObject entry = value.ToJsonObjectOrFail(@"Session work ledger entries must be objects.");
			if (entry.GetStringOrFail(@"SourceSessionKey", @"Session work entry SourceSessionKey is required.") == sourceSessionKey)
			{
				entry[@"WorkerSessionKey"] = resolvedWorkerSessionKey;
				entry[@"WorkerAgentName"] = @"online-session-memory-critic";
				entry[@"ProcessorSkill"] = @"OnlineSessionMemoryCriticSkill";
				entry[@"OperationState"] = @"Attached";
				entry[@"EventDeliveryEnabled"] = false;
			}
		}
		ledger[@"Entries"] = entries;
		FileSystemTools.ReplaceTextFile(_opsAgent.GetCurrentSessionDirectory(), @"artifacts\session-work\ledger.json", ledger.ToJSON());
		attached[@"Ledger"] = ledger;
		return attached.ToJSON();
	}
	Description = @"Creates or reuses the actual deterministic online-memory-critic child, disables event delivery, configures Terra, and records it as the batch worker.";
}

[SemanticProgram.InfinitivePhrase("to add an online memory critic batch turn")]
prototype ToAddOnlineMemoryCriticBatchTurn : OnlineMemoryCriticBatchCoordinatorSkillAction
{
	function Execute(string sourceSessionKey, string turnKey) : string
	{
		Sessions.ValidateSessionKey(sourceSessionKey);
		return OnlineMemoryCriticBatchProjection.AddTurn(Sessions.GetSessionsRootPath(), sourceSessionKey, turnKey);
	}
	Description = @"Adds one exact completed source turn key to the source-owned Terra Online Memory Critic batch manifest.";
}

[SemanticProgram.InfinitivePhrase("to run an online memory critic batch operation")]
prototype ToRunOnlineMemoryCriticBatchOperation : OnlineMemoryCriticBatchCoordinatorSkillAction
{
	function Execute(string sourceSessionKey, string actionPrototypeName, string inputValue = @"") : string
	{
		Sessions.ValidateSessionKey(sourceSessionKey);
		JsonObject ledger = new JsonObject(ToGetSessionWorkLedger.Execute());
		JsonArray entries = ledger.GetJsonArrayOrFail(@"Entries", @"Session work ledger Entries is required.");
		string workerSessionKey = @"";
		foreach (JsonValue value in entries)
		{
			JsonObject entry = value.ToJsonObjectOrFail(@"Session work ledger entries must be objects.");
			if (entry.GetStringOrFail(@"SourceSessionKey", @"Session work entry SourceSessionKey is required.") == sourceSessionKey)
			{
				workerSessionKey = entry.GetStringOrFail(@"WorkerSessionKey", @"An attached Online Memory Critic batch worker is required.");
			}
		}
		if (String.IsNullOrWhiteSpace(workerSessionKey))
		{
			throw new InvalidOperationException(@"No attached Online Memory Critic batch worker was found for source session " + sourceSessionKey);
		}
		return OnlineMemoryCriticBatchProjection.RunWorkerOperation(Sessions.GetSessionsRootPath(), sourceSessionKey, workerSessionKey, actionPrototypeName, inputValue);
	}
	Description = @"Runs one selected-turn Terra Online Memory Critic batch operation against the actual critic child with event delivery disabled and concurrency one.";
}
