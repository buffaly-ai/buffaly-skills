{
	function Execute() : string
	{
		return @"{""SchemaVersion"":1,""WorkspaceId"":""online-memory-critic-batch"",""DisplayName"":""Online Memory Critic Batch"",""Description"":""Discover attached Online Memory Critics, inspect exact result-marker freshness, and process missing turns through the existing sequential coordinator without changing live event delivery."",""WorkerAgentName"":""online-session-memory-critic"",""WorkerSessionSuffix"":""-online-memory-critic"",""ArtifactPath"":""artifacts/online-memory-critic-batch/manifest.json"",""ReconcileAction"":""ToReconcileOnlineMemoryCriticBatchLedger"",""AttachAction"":""ToAttachOnlineMemoryCriticBatchWorker"",""RunAction"":""ToRunOnlineMemoryCriticBatchOperation"",""PreviewTitle"":""Online memory critic batch manifest"",""PreviewDescription"":""Exact reviewed, pending, and missing source turns for the attached Online Memory Critic.""}";
	}
}

