[SemanticProgram.InfinitivePhrase("to reconcile discovered online memory critic attachments")]
prototype ToReconcileOnlineMemoryCriticBatchLedger : OnlineMemoryCriticBatchCoordinatorSkillAction
{
	function Execute(string maxWorkers) : string
	{
		JsonObject ledger = new JsonObject(OnlineMemoryCriticBatchProjection.RefreshDiscoveredLedger(ToInitializeSessionWorkLedger.Execute(), Sessions.GetSessionsRootPath(), maxWorkers));
		FileSystemTools.ReplaceTextFile(_opsAgent.GetCurrentSessionDirectory(), @"artifacts\session-work\ledger.json", ledger.ToJSON());
		return ledger.ToJSON();
	}
	Description = @"Explicitly discovers a bounded recent-session population of exact-profile Online Memory Critic children and atomically replaces this coordinator's specialization ledger snapshot without changing enabled state, subscriptions, model selection, manifests, or queued work.";
}

