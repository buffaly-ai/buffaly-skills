[SemanticProgram.InfinitivePhrase("to attach an online memory critic batch worker to a source session")]
prototype ToAttachOnlineMemoryCriticBatchWorker : OnlineMemoryCriticBatchCoordinatorSkillAction
{
	function Execute(string sourceSessionKey, string workerSessionKey) : string
	{
		JsonObject attached = new JsonObject(OnlineMemoryCriticBatchProjection.AttachWorker(Sessions.GetSessionsRootPath(), sourceSessionKey, workerSessionKey));
		string resolvedWorkerSessionKey = attached.GetStringOrFail(@"WorkerSessionKey", @"Attached critic worker key is required.");
		JsonObject ledger = new JsonObject(OnlineMemoryCriticBatchProjection.RefreshLedgerEntry(ToInitializeSessionWorkLedger.Execute(), Sessions.GetSessionsRootPath(), sourceSessionKey, resolvedWorkerSessionKey));
		FileSystemTools.ReplaceTextFile(_opsAgent.GetCurrentSessionDirectory(), @"artifacts\session-work\ledger.json", ledger.ToJSON());
		attached[@"Ledger"] = ledger;
		return attached.ToJSON();
	}
	Description = @"Validates and records the actual deterministic online-memory-critic child while preserving its enabled state, subscriptions, and model configuration.";
}

