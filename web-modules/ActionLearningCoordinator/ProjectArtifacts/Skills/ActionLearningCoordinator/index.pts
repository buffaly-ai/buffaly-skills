[SemanticProgram.InfinitivePhrase("to get session work coordinator information")]
prototype ToGetSessionWorkCoordinatorInfo : SessionWorkCoordinatorSkillAction
{
	function Execute(string specialization = "action-learning") : string
	{
		if (specialization == @"online-memory-critic-batch")
		{
			return @"{""SchemaVersion"":2,""WorkspaceId"":""online-memory-critic-batch"",""DisplayName"":""Online Memory Critic Batch"",""CoordinatorSkill"":""OnlineMemoryCriticBatchCoordinatorSkill"",""BaseSkill"":""SessionWorkCoordinatorSkill"",""WorkerSkill"":""OnlineSessionMemoryCriticSkill"",""SessionKey"":""" + _opsAgent.GetSessionKeyOrEmpty() + @""",""AgentName"":""online-memory-critic-batch-coordinator"",""LedgerPath"":""artifacts/session-work/ledger.json"",""WorkspaceDefinitionAction"":""ToGetOnlineMemoryCriticBatchWorkspaceDefinition"",""PortfolioAction"":""ToGetOnlineMemoryCriticBatchPortfolio"",""ItemWorkspaceAction"":""ToGetOnlineMemoryCriticBatchSourceWorkspace""}";
		}
		if (specialization == @"online-action-critic-batch")
		{
			return @"{""SchemaVersion"":2,""WorkspaceId"":""online-action-critic-batch"",""DisplayName"":""Online Action Critic Batch"",""CoordinatorSkill"":""OnlineActionCriticBatchCoordinatorSkill"",""BaseSkill"":""SessionWorkCoordinatorSkill"",""WorkerSkill"":""OnlineActionCriticSkill"",""SessionKey"":""" + _opsAgent.GetSessionKeyOrEmpty() + @""",""AgentName"":""online-action-critic-batch-coordinator"",""LedgerPath"":""artifacts/session-work/ledger.json"",""WorkspaceDefinitionAction"":""ToGetOnlineActionCriticBatchWorkspaceDefinition"",""PortfolioAction"":""ToGetOnlineActionCriticBatchPortfolio"",""ItemWorkspaceAction"":""ToGetOnlineActionCriticBatchSourceWorkspace""}";
		}
		if (specialization == @"ontology-foundry")
		{
			return @"{""SchemaVersion"":2,""WorkspaceId"":""ontology-foundry"",""DisplayName"":""Ontology Foundry"",""CoordinatorSkill"":""OntologyFoundryCoordinatorSkill"",""BaseSkill"":""SessionWorkCoordinatorSkill"",""WorkerSkill"":""OntologyFoundrySkill"",""SessionKey"":""" + _opsAgent.GetSessionKeyOrEmpty() + @""",""AgentName"":""ontology-foundry-coordinator"",""LedgerPath"":""artifacts/session-work/ledger.json"",""WorkspaceDefinitionAction"":""ToGetOntologyFoundryWorkspaceDefinition"",""PortfolioAction"":""ToGetOntologyFoundryPortfolio"",""ItemWorkspaceAction"":""ToGetOntologyFoundrySourceWorkspace""}";
		}
		return @"{""SchemaVersion"":2,""WorkspaceId"":""action-learning"",""DisplayName"":""Action Learning"",""CoordinatorSkill"":""ActionLearningCoordinatorSkill"",""BaseSkill"":""SessionWorkCoordinatorSkill"",""WorkerSkill"":""ActionLearningSkill"",""SessionKey"":""" + _opsAgent.GetSessionKeyOrEmpty() + @""",""AgentName"":""action-learning-coordinator"",""LedgerPath"":""artifacts/session-work/ledger.json"",""WorkspaceDefinitionAction"":""ToGetActionLearningWorkspaceDefinition"",""PortfolioAction"":""ToGetActionLearningPortfolio"",""ItemWorkspaceAction"":""ToGetActionLearningSourceWorkspace""}";
	}
	Description = @"Returns the live coordinator identity and fixed ledger contract for the current session-owned runtime.";
}

[SemanticProgram.InfinitivePhrase("to get the session work ledger")]
prototype ToGetSessionWorkLedger : SessionWorkCoordinatorSkillAction
{
	function Execute() : string
	{
		string path = Path.Combine(_opsAgent.GetCurrentSessionDirectory(), @"artifacts\session-work\ledger.json");
		if (!SessionWorkCoordinatorFile.Exists(path))
		{
			return @"{""SchemaVersion"":2,""CoordinatorSkill"":""SessionWorkCoordinatorSkill"",""Exists"":false,""Entries"":[]}";
		}
		return SessionWorkCoordinatorFile.ReadAllText(path);
	}
	Description = @"Reads the fixed JSON ledger owned by the current coordinator session. Missing is explicit and does not create state.";
}

[SemanticProgram.InfinitivePhrase("to initialize the session work ledger")]
prototype ToInitializeSessionWorkLedger : SessionWorkCoordinatorSkillAction
{
	function Execute() : string
	{
		string path = Path.Combine(_opsAgent.GetCurrentSessionDirectory(), @"artifacts\session-work\ledger.json");
		if (SessionWorkCoordinatorFile.Exists(path))
		{
			return SessionWorkCoordinatorFile.ReadAllText(path);
		}
		string ledger = @"{""SchemaVersion"":2,""CoordinatorSkill"":""SessionWorkCoordinatorSkill"",""Exists"":true,""Entries"":[]}";
		FileSystemTools.ReplaceTextFile(_opsAgent.GetCurrentSessionDirectory(), @"artifacts\session-work\ledger.json", ledger);
		return ledger;
	}
	Description = @"Creates the current coordinator session's fixed initial ledger only when it is missing.";
}

[SemanticProgram.InfinitivePhrase("to add a session work entry")]
prototype ToAddSessionWorkEntry : SessionWorkCoordinatorSkillAction
{
	function Execute(string sourceSessionKey) : string
	{
		string path = Path.Combine(_opsAgent.GetCurrentSessionDirectory(), @"artifacts\session-work\ledger.json");
		JsonObject ledger = new JsonObject(@"{""SchemaVersion"":2,""CoordinatorSkill"":""SessionWorkCoordinatorSkill"",""Exists"":true,""Entries"":[]}");
		if (SessionWorkCoordinatorFile.Exists(path))
		{
			ledger = new JsonObject(SessionWorkCoordinatorFile.ReadAllText(path));
		}
		JsonArray entries = ledger.GetJsonArrayOrFail(@"Entries", @"Session work ledger Entries is required.");
		foreach (JsonValue value in entries)
		{
			JsonObject existing = value.ToJsonObjectOrFail(@"Session work ledger entries must be objects.");
			if (existing.GetStringOrFail(@"SourceSessionKey", @"Session work entry SourceSessionKey is required.") == sourceSessionKey)
			{
				JsonObject unchanged = new JsonObject();
				unchanged[@"Outcome"] = @"AlreadyExists";
				unchanged[@"SourceSessionKey"] = sourceSessionKey;
				unchanged[@"Ledger"] = ledger;
				return unchanged.ToJSON();
			}
		}
		JsonObject entry = new JsonObject();
		entry[@"SourceSessionKey"] = sourceSessionKey;
		entry[@"Enabled"] = true;
		entries.Add(new JsonValue(entry));
		ledger[@"Entries"] = entries;
		ledger[@"Exists"] = true;
		FileSystemTools.ReplaceTextFile(_opsAgent.GetCurrentSessionDirectory(), @"artifacts\session-work\ledger.json", ledger.ToJSON());
		JsonObject added = new JsonObject();
		added[@"Outcome"] = @"Added";
		added[@"SourceSessionKey"] = sourceSessionKey;
		added[@"Ledger"] = ledger;
		return added.ToJSON();
	}
	Description = @"Adds one exact source-session entry to the current coordinator ledger. Repeated adds are idempotent.";
}

[SemanticProgram.InfinitivePhrase("to remove a session work entry")]
prototype ToRemoveSessionWorkEntry : SessionWorkCoordinatorSkillAction
{
	function Execute(string sourceSessionKey) : string
	{
		string path = Path.Combine(_opsAgent.GetCurrentSessionDirectory(), @"artifacts\session-work\ledger.json");
		if (!SessionWorkCoordinatorFile.Exists(path))
		{
			JsonObject absentLedger = new JsonObject(@"{""SchemaVersion"":2,""CoordinatorSkill"":""SessionWorkCoordinatorSkill"",""Exists"":false,""Entries"":[]}");
			JsonObject absent = new JsonObject();
			absent[@"Outcome"] = @"NotFound";
			absent[@"SourceSessionKey"] = sourceSessionKey;
			absent[@"Ledger"] = absentLedger;
			return absent.ToJSON();
		}
		JsonObject ledger = new JsonObject(SessionWorkCoordinatorFile.ReadAllText(path));
		JsonArray entries = ledger.GetJsonArrayOrFail(@"Entries", @"Session work ledger Entries is required.");
		foreach (JsonValue value in entries)
		{
			JsonObject existing = value.ToJsonObjectOrFail(@"Session work ledger entries must be objects.");
			if (existing.GetStringOrFail(@"SourceSessionKey", @"Session work entry SourceSessionKey is required.") == sourceSessionKey)
			{
				entries.Remove(value);
				ledger[@"Entries"] = entries;
				FileSystemTools.ReplaceTextFile(_opsAgent.GetCurrentSessionDirectory(), @"artifacts\session-work\ledger.json", ledger.ToJSON());
				JsonObject removed = new JsonObject();
				removed[@"Outcome"] = @"Removed";
				removed[@"SourceSessionKey"] = sourceSessionKey;
				removed[@"Ledger"] = ledger;
				return removed.ToJSON();
			}
		}
		JsonObject missing = new JsonObject();
		missing[@"Outcome"] = @"NotFound";
		missing[@"SourceSessionKey"] = sourceSessionKey;
		missing[@"Ledger"] = ledger;
		return missing.ToJSON();
	}
	Description = @"Removes one exact source-session entry and reports NotFound without modifying the ledger when absent.";
}

[SemanticProgram.InfinitivePhrase("to list session work attachment choices")]
prototype ToListSessionWorkAttachmentChoices : SessionWorkCoordinatorSkillAction
{
	function Execute(string expectedWorkerAgentName, string workerSessionSuffix, string maxSources) : string
	{
		return OntologyFoundryProposalProjection.BuildAttachmentChoicesFromText(expectedWorkerAgentName, workerSessionSuffix, maxSources);
	}
	Description = @"Lists bounded eligible source sessions and existing exact-profile workers for the shared coordinator attachment UI.";
}

[SemanticProgram.InfinitivePhrase("to attach an action learning worker to a source session")]
prototype ToAttachActionLearningWorker : ActionLearningCoordinatorSkillAction
{
	function Execute(string sourceSessionKey, string workerSessionKey) : string
	{
		JsonObject validated = new JsonObject(OntologyFoundryProposalProjection.ValidateWorkerAttachment(sourceSessionKey, workerSessionKey, @"action-learning", @"-action-learning"));
		workerSessionKey = validated.GetStringOrFail(@"WorkerSessionKey", @"Validated worker session key is required.");
		string path = Path.Combine(_opsAgent.GetCurrentSessionDirectory(), @"artifacts\session-work\ledger.json");
		JsonObject ledger = new JsonObject(@"{""SchemaVersion"":2,""CoordinatorSkill"":""SessionWorkCoordinatorSkill"",""Exists"":true,""Entries"":[]}");
		if (SessionWorkCoordinatorFile.Exists(path))
		{
			ledger = new JsonObject(SessionWorkCoordinatorFile.ReadAllText(path));
		}
		JsonArray entries = ledger.GetJsonArrayOrFail(@"Entries", @"Session work ledger Entries is required.");
		foreach (JsonValue value in entries)
		{
			JsonObject existingEntry = value.ToJsonObjectOrFail(@"Session work ledger entries must be objects.");
			string existingSource = existingEntry.GetStringOrDefault(@"SourceSessionKey", @"");
			string existingWorker = existingEntry.GetStringOrDefault(@"WorkerSessionKey", @"");
			if (existingWorker == workerSessionKey && existingSource != sourceSessionKey)
			{
				throw new InvalidOperationException(@"Worker is already attached to a different source in this coordinator ledger: " + existingSource);
			}
		}
		JsonArray updatedEntries = new JsonArray();
		bool found = false;
		foreach (JsonValue value in entries)
		{
			JsonObject entry = value.ToJsonObjectOrFail(@"Session work ledger entries must be objects.");
			if (entry.GetStringOrFail(@"SourceSessionKey", @"Session work entry SourceSessionKey is required.") == sourceSessionKey)
			{
				entry[@"WorkerSessionKey"] = workerSessionKey;
				entry[@"WorkerAgentName"] = @"action-learning";
				entry[@"ProcessorSkill"] = @"ActionLearningSkill";
				entry[@"OperationState"] = @"Attached";
				found = true;
			}
			updatedEntries.Add(new JsonValue(entry));
		}
		if (!found)
		{
			JsonObject entry = new JsonObject();
			entry[@"SourceSessionKey"] = sourceSessionKey;
			entry[@"Enabled"] = true;
			entry[@"WorkerSessionKey"] = workerSessionKey;
			entry[@"WorkerAgentName"] = @"action-learning";
			entry[@"ProcessorSkill"] = @"ActionLearningSkill";
			entry[@"OperationState"] = @"Attached";
			updatedEntries.Add(new JsonValue(entry));
		}
		ledger[@"Entries"] = updatedEntries;
		ledger[@"Exists"] = true;
		FileSystemTools.ReplaceTextFile(_opsAgent.GetCurrentSessionDirectory(), @"artifacts\session-work\ledger.json", ledger.ToJSON());
		JsonObject receipt = new JsonObject();
		string outcome = @"Attached";
		if (found)
		{
			outcome = @"Updated";
		}
		receipt[@"Outcome"] = outcome;
		receipt[@"SourceSessionKey"] = sourceSessionKey;
		receipt[@"WorkerSessionKey"] = workerSessionKey;
		receipt[@"Ledger"] = ledger;
		return receipt.ToJSON();
	}
	Description = @"Validates an existing source-attached Action Learning worker and records its exact binding in the coordinator ledger. Browser/host callers create a missing worker before invoking this worker-owned action.";
}

[SemanticProgram.InfinitivePhrase("to list action learning coordinator actions")]
prototype ToListActionLearningCoordinatorActions : ActionLearningCoordinatorSkillAction
{
	function Execute() : string
	{
		return @"{""CommonActions"":[""ToGetSessionWorkCoordinatorInfo"",""ToGetSessionWorkLedger"",""ToInitializeSessionWorkLedger"",""ToAddSessionWorkEntry"",""ToRemoveSessionWorkEntry""],""SpecializedActions"":[""ToAttachActionLearningWorker"",""ToListActionLearningCoordinatorActions""],""WorkerActions"":[""ToRefreshActionLearningSessionCandidatesSkill"",""ToDiscoverActionCandidatesWithinSessionSkill"",""ToBuildActionCandidateMetricsMatrixSkill"",""ToGroundAndExpandActionCandidateSkill"",""ToEvaluateActionLearningArtifact""]}";
	}
	Description = @"Returns the exact first-version coordinator and worker action names rendered by the dashboard.";
}

