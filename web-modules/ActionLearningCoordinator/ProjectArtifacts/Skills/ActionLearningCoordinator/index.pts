[SemanticProgram.InfinitivePhrase("to run an action learning worker operation")]
prototype ToRunActionLearningWorkerOperation : ActionLearningCoordinatorSkillAction
{
	function Execute(string sourceSessionKey, string actionPrototypeName, string inputValue = @"") : string
	{
		Sessions.ValidateSessionKey(sourceSessionKey);
		JsonObject ledger = new JsonObject(ToGetSessionWorkLedger.Execute());
		JsonArray entries = ledger.GetJsonArrayOrFail(@"Entries", @"Session work ledger Entries is required.");
		string workerSessionKey = @"";
		foreach (JsonValue value in entries)
		{
			JsonObject entry = value.ToJsonObjectOrFail(@"Session work ledger entries must be objects.");
			if (entry.GetStringOrFail(@"SourceSessionKey", @"Session work entry SourceSessionKey is required.") == sourceSessionKey)
			{
				workerSessionKey = entry.GetStringOrFail(@"WorkerSessionKey", @"An attached Action Learning worker is required.");
			}
		}
		if (String.IsNullOrWhiteSpace(workerSessionKey))
		{
			throw new InvalidOperationException(@"No attached Action Learning worker was found for source session " + sourceSessionKey);
		}
		string result = ActionLearningCandidateProjection.RunWorkerOperation(Sessions.GetSessionsRootPath(), sourceSessionKey, workerSessionKey, actionPrototypeName, inputValue);
		if (actionPrototypeName == @"ToResetActionLearningFromBeginning" || actionPrototypeName == @"ToStartActionLearningFromBeginning")
		{
			foreach (JsonValue value in entries)
			{
				JsonObject entry = value.ToJsonObjectOrFail(@"Session work ledger entries must be objects.");
				if (entry.GetStringOrFail(@"SourceSessionKey", @"Session work entry SourceSessionKey is required.") == sourceSessionKey)
				{
					entry.Remove(@"LastAcceptedSourceTurnId");
					entry.Remove(@"LastAcceptedSourceTurnUtc");
					entry[@"OperationState"] = @"Reset";
				}
			}
			ledger[@"Entries"] = entries;
			FileSystemTools.ReplaceTextFile(_opsAgent.GetCurrentSessionDirectory(), @"artifacts\session-work\ledger.json", ledger.ToJSON());
		}
		return result;
	}
	Description = @"Runs one allowlisted Action Learning operation on the exact source-attached worker, including guarded reset and start-from-beginning controls.";
}

