		return @"{""SchemaVersion"":1,""WorkspaceId"":""ontology-foundry"",""DisplayName"":""Ontology Foundry"",""Description"":""Source-owned entity evidence, prototype resolution, and Session Entity Index proposals."",""WorkerAgentName"":""ontology-foundry"",""WorkerSessionSuffix"":""-ontology-foundry"",""ArtifactPath"":""artifacts/ontology-foundry/evidence-graph.md"",""AttachAction"":""ToAttachOntologyFoundryWorker"",""RunAction"":""ToRunOntologyFoundryWorkerOperation"",""PreviewTitle"":""Entity evidence graph"",""PreviewDescription"":""Bounded evidence sections from the living source artifact.""}";
	}
}

