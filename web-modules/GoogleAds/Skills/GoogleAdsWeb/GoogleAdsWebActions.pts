[SemanticProgram.InfinitivePhrase("to validate a paused google ads search campaign")]
prototype ToValidatePausedGoogleAdsSearchCampaign : GoogleAdsWebSkillAction
{
	Description = @"Validate a complete paused Google Ads Search campaign hierarchy without creating resources. keywordsJson is an array of Text/MatchType objects; headlinesJson and descriptionsJson are string arrays. Budget and bid values use micros. Returns JSON.";
	function Execute(string customerId, string loginCustomerId, string campaignName, int dailyBudgetMicros, string adGroupName, int adGroupCpcBidMicros, string keywordsJson, string headlinesJson, string descriptionsJson, string finalUrl) : string
	{
		return GoogleAdsWebService.ValidatePausedSearchCampaignJson(customerId, loginCustomerId, campaignName, dailyBudgetMicros, adGroupName, adGroupCpcBidMicros, keywordsJson, headlinesJson, descriptionsJson, finalUrl);
	}
}

[SemanticProgram.InfinitivePhrase("to create a paused google ads search campaign")]
prototype ToCreatePausedGoogleAdsSearchCampaign : GoogleAdsWebSkillAction
{
	Description = @"Create one complete Google Ads Search campaign hierarchy with budget, campaign, ad group, keywords, and responsive search ad. Every supported resource is forced PAUSED. confirmCreatePaused must be true. Budget and bid values use micros. Returns resource names and request ID as JSON.";
	function Execute(string customerId, string loginCustomerId, string campaignName, int dailyBudgetMicros, string adGroupName, int adGroupCpcBidMicros, string keywordsJson, string headlinesJson, string descriptionsJson, string finalUrl, bool confirmCreatePaused) : string
	{
		return GoogleAdsWebService.CreatePausedSearchCampaignJson(customerId, loginCustomerId, campaignName, dailyBudgetMicros, adGroupName, adGroupCpcBidMicros, keywordsJson, headlinesJson, descriptionsJson, finalUrl, confirmCreatePaused);
	}
}

