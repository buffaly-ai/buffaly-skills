prototype ToValidatePausedGoogleAdReplacement : GoogleAdsWebSkillAction
{
	Description = @"Validate a PAUSED responsive search ad replacement without creating it or modifying the source ad. Arrays are supplied as JSON strings. Returns JSON.";
	function Execute(string customerId, string loginCustomerId, string adGroupId, string sourceAdId, string headlinesJson, string descriptionsJson, string finalUrl) : string
	{
		return GoogleAdsWebService.ValidatePausedAdReplacementJson(customerId, loginCustomerId, adGroupId, sourceAdId, headlinesJson, descriptionsJson, finalUrl);
	}
}

[SemanticProgram.InfinitivePhrase("to create a paused google ad replacement")]
prototype ToCreatePausedGoogleAdReplacement : GoogleAdsWebSkillAction
{
	Description = @"Create a PAUSED responsive search ad replacement in an existing ad group while leaving the source ad unchanged. confirmCreatePaused must be true. Returns JSON.";
	function Execute(string customerId, string loginCustomerId, string adGroupId, string sourceAdId, string headlinesJson, string descriptionsJson, string finalUrl, bool confirmCreatePaused) : string
	{
		return GoogleAdsWebService.CreatePausedAdReplacementJson(customerId, loginCustomerId, adGroupId, sourceAdId, headlinesJson, descriptionsJson, finalUrl, confirmCreatePaused);
	}
}

[SemanticProgram.InfinitivePhrase("to swap a google ad replacement")]
prototype ToSwapGoogleAdReplacement : GoogleAdsWebSkillAction
{
	Description = @"Validate or perform one guarded Google Ads replacement swap. Both ads must be responsive search ads in the same ad group; source must be ENABLED, replacement must be PAUSED, and replacement must have expectedFinalUrl. A real swap enables the replacement and pauses the source atomically. confirmSwap must be true when validateOnly is false.";
	function Execute(string customerId, string loginCustomerId, string adGroupId, string sourceAdId, string replacementAdId, string expectedFinalUrl, bool validateOnly, bool confirmSwap) : string
	{
		return GoogleAdsWebService.SwapAdReplacementJson(customerId, loginCustomerId, adGroupId, sourceAdId, replacementAdId, expectedFinalUrl, validateOnly, confirmSwap);
	}
}
prototype GoogleAdsInteractiveSiteLauncher
{
	function Execute(IAgentRuntimeHost opsAgent, string screen, string title, string customerId, string loginCustomerId, string dateRangePreset, string adId, int timeoutSeconds) : string
	{
		if (timeoutSeconds <= 0)
		{
			timeoutSeconds = 120;
		}

		string stateJson = GoogleAdsInteractiveSiteConfiguration.BuildStateJson(screen, customerId, loginCustomerId, dateRangePreset, adId);
		InteractiveSiteLaunchResultContract result = opsAgent.LaunchWebModuleComponent(new WebModuleComponentLaunchRequestContract
		{
			Title = title,
			MessageKey = opsAgent.GetCurrentToolMessageKeyOrEmpty(),
			ToolInvocationId = opsAgent.GetCurrentToolInvocationIdOrEmpty(),
			ModuleName = "GoogleAds",
			Screen = screen,
			StateJson = stateJson,
			TimeoutSeconds = timeoutSeconds
		});
		return "Google Ads " + screen + " interactive site exited with status: " + result.Status + "; value: " + result.Value;
	}
}

prototype GoogleAdsEntityInteractiveSiteLauncher
{
	function Execute(IAgentRuntimeHost opsAgent, string screen, string title, string customerId, string loginCustomerId, string dateRangePreset, string entityId, int timeoutSeconds) : string
	{
		if (timeoutSeconds <= 0) { timeoutSeconds = 120; }
		string stateJson = GoogleAdsInteractiveSiteConfiguration.BuildEntityStateJson(screen, customerId, loginCustomerId, dateRangePreset, entityId);
		InteractiveSiteLaunchResultContract result = opsAgent.LaunchWebModuleComponent(new WebModuleComponentLaunchRequestContract { Title = title, MessageKey = opsAgent.GetCurrentToolMessageKeyOrEmpty(), ToolInvocationId = opsAgent.GetCurrentToolInvocationIdOrEmpty(), ModuleName = "GoogleAds", Screen = screen, StateJson = stateJson, TimeoutSeconds = timeoutSeconds });
		return "Google Ads " + screen + " interactive site exited with status: " + result.Status + "; value: " + result.Value;
	}
}

[SemanticProgram.InfinitivePhrase("to view google ads performance in an interactive site")]
[SemanticProgram.InfinitivePhrase("to show google ads performance")]
prototype ToViewGoogleAdsPerformanceInteractiveSite : GoogleAdsWebSkillAction
{
	Description = @"Launch a read-only Google Ads performance popup. customerId and loginCustomerId may be blank to use saved defaults. dateRangePreset is LAST_7_DAYS, LAST_30_DAYS, THIS_MONTH, LAST_MONTH, TODAY, or YESTERDAY.";
	function Execute(string customerId, string loginCustomerId, string dateRangePreset, int timeoutSeconds) : string { return GoogleAdsInteractiveSiteLauncher.Execute(_opsAgent, "performance", "Google Ads Performance", customerId, loginCustomerId, dateRangePreset, "", timeoutSeconds); }
}

