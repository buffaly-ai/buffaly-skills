reference Buffaly.ErrorLogDispatch.WebModule Buffaly.ErrorLogDispatch.WebModule;
import Buffaly.ErrorLogDispatch.WebModule Buffaly.ErrorLogDispatch.ErrorDispatchFacade ErrorDispatchFacade;
import Buffaly.ErrorLogDispatch.WebModule Buffaly.ErrorLogDispatch.ErrorDispatchSessionRequest ErrorDispatchSessionRequest;
import Buffaly.ErrorLogDispatch.WebModule Buffaly.ErrorLogDispatch.ErrorDispatchSessionReceipt ErrorDispatchSessionReceipt;
import Buffaly.ErrorLogDispatch.WebModule Buffaly.ErrorLogDispatch.ErrorDispatchDeliveryRequest ErrorDispatchDeliveryRequest;
import Buffaly.ErrorLogDispatch.WebModule Buffaly.ErrorLogDispatch.ErrorDispatchDeliveryReceipt ErrorDispatchDeliveryReceipt;

prototype ErrorLogDispatchSkillAction : OpsAction
{
	Description = @"Deterministic diagnostic-session resolution and delivery for dispatch-agent.";
}

[SemanticEntity("error log dispatch skill")]
prototype ErrorLogDispatchSkill : SkillEntity
{
	Description = @"Two-operation deterministic pipeline shared by local error logs and remote production alarms.";
	ActionRoot = ErrorLogDispatchSkillAction;
}

[SemanticProgram.InfinitivePhrase("to get an error dispatch session")]
[SemanticProgram.InfinitivePhrase("to resolve a diagnostic owner session")]
prototype ToGetErrorDispatchSession : ErrorLogDispatchSkillAction, DispatchAgentCuratedActionRoot
{
	Description = @"Resolve or create one dedicated diagnostic owner, apply and verify the no-companion ErrorDiagnostic policy with ResetOnLimit, persist ErrorSession or AlarmSession on the exact Dispatch node, and read it back.";

	function Execute(string parentSessionKey, string dispatchNodePrototypeName, string attachmentName, string childSessionKey, string evaluationScope = "Live") : ErrorDispatchSessionReceipt
	{
		ErrorDispatchSessionRequest request = new ErrorDispatchSessionRequest();
		request.ParentSessionKey = parentSessionKey;
		request.DispatchNodePrototypeName = dispatchNodePrototypeName;
		request.AttachmentName = attachmentName;
		request.ChildSessionKey = childSessionKey;
		request.EvaluationScope = evaluationScope;
		return ErrorDispatchFacade.GetSession(_runtime, _opsAgent, request);
	}
}

[SemanticProgram.InfinitivePhrase("to dispatch an error to a session")]
[SemanticProgram.InfinitivePhrase("to queue a diagnostic assignment")]
prototype ToDispatchErrorToSession : ErrorLogDispatchSkillAction, DispatchAgentCuratedActionRoot
{
	Description = @"Deliver the saved diagnostic guidance plus the original source row to the exact diagnostic tree attachment; no model-authored assignment. Return provenance and the actual queue receipt. BuildOnly always fails closed.";

	function Execute(string sessionKey, string assignedFrame, string dispatchNodePrototypeName, string attachmentName, string routingReason, string evaluationScope = "Live") : ErrorDispatchDeliveryReceipt
	{
		ErrorDispatchDeliveryRequest request = new ErrorDispatchDeliveryRequest();
		request.SessionKey = sessionKey;
		request.AssignedFrame = assignedFrame;
		request.DispatchNodePrototypeName = dispatchNodePrototypeName;
		request.AttachmentName = attachmentName;
		request.RoutingReason = routingReason;
		request.EvaluationScope = evaluationScope;
		return ErrorDispatchFacade.Dispatch(_opsAgent, request);
	}
}
