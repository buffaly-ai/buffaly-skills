reference ExtensionBrowser.WebModule ExtensionBrowser.WebModule;
import ExtensionBrowser.WebModule ExtensionBrowser.WebModule.ExtensionBrowserModuleService ExtensionBrowserModuleService;

prototype ExtensionBrowserBoundSkillAction : OpsAction { Description = @"Bound regular-Chrome actions routed by the current session binding."; }
[SemanticEntity("bound extension browser skill")]
prototype ExtensionBrowserBoundSkill : SkillEntity { EntityName = "bound extension browser skill"; Description = @"Use the Chrome extension installation bound to the current Buffaly session."; ActionRoot = ExtensionBrowserBoundSkillAction; }
prototype ExtensionBrowserBoundSession : ContextPrompt
{
	EntityName = "extension browser bound session prompt context";
	ContextPhrase = "when a Chrome conversation is bound to one ExtensionBrowser installation and current tab";
	PromptPath = @"ContextPrompts/ExtensionBrowserBoundSession.prompt.md";
	DefinitionPromptPath = @"ContextPrompts/ContextPromptDefinition.prompt.md";
}
[SemanticProgram.InfinitivePhrase("to invoke a bound extension browser tool")]
prototype ToInvokeBoundExtensionBrowserTool : ExtensionBrowserBoundSkillAction
{
	Description = @"Invoke one supported tool through the extension installation bound to the current session. Supported names: get_active_tab, get_page_text, get_dom_snapshot, screenshot, find_elements, navigate, click, type_text, press_key, scroll, wait, list_tabs, open_tab, close_tab, switch_tab, attach_debugger, detach_debugger, get_status, go_back, go_forward, hover, select_option, get_attribute, check_exists, get_viewport, and get_console_events. No port, credential, session target, arbitrary JavaScript, or runScript tool is accepted.";
	function Execute(string tool, string argsJson) : string { return ExtensionBrowserModuleService.InvokeForSession(_opsAgent.GetSessionKeyOrEmpty(), tool, argsJson, 30); }
}
[SemanticProgram.InfinitivePhrase("to get the active tab from the bound extension")]
prototype ToGetBoundExtensionActiveTab : ExtensionBrowserBoundSkillAction
{
	function Execute() : string { return ExtensionBrowserModuleService.InvokeForSession(_opsAgent.GetSessionKeyOrEmpty(), "get_active_tab", "{}", 15); }
}
[SemanticProgram.InfinitivePhrase("to read the visible page from the bound extension")]
[SemanticProgram.InfinitivePhrase("to get page text from the bound chrome tab")]
[SemanticProgram.InfinitivePhrase("to summarize the visible page in bound chrome")]
prototype ToGetBoundExtensionPageText : ExtensionBrowserBoundSkillAction
{
	Description = @"Read visible document text from the current tab through the Chrome installation immutably bound to this Buffaly session. Use this action instead of guessing a runScript or arbitrary JavaScript tool name.";
	function Execute() : string { return ExtensionBrowserModuleService.InvokeForSession(_opsAgent.GetSessionKeyOrEmpty(), "get_page_text", "{}", 30); }
}
[SemanticProgram.InfinitivePhrase("to navigate the current tab with the bound extension")]
[SemanticProgram.InfinitivePhrase("to open a web page in the bound chrome tab")]
prototype ToNavigateBoundExtensionCurrentTab : ExtensionBrowserBoundSkillAction
{
 Description = @"Navigate the current tab through the Chrome installation immutably bound to this Buffaly session.";
 function Execute(string url) : string { return ExtensionBrowserModuleService.NavigateCurrentTabForSession(_opsAgent.GetSessionKeyOrEmpty(), url); }
}
[SemanticProgram.InfinitivePhrase("to navigate a bound extension tab")]
prototype ToNavigateBoundExtensionTab : ExtensionBrowserBoundSkillAction
{
 Description = @"Navigate one explicit tab through the Chrome installation immutably bound to this Buffaly session.";
 function Execute(string url, int tabId) : string { return ExtensionBrowserModuleService.NavigateTabForSession(_opsAgent.GetSessionKeyOrEmpty(), url, tabId); }
}
