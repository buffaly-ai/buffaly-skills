prototype FeedingFrenzyAgentActionRoot : CoreAction, FeedingFrenzyJsonWsSkillAction, LocalTaskPromptAction
{
	Description = @"Constrained action root for the unified Feeding Frenzy agent. Includes Buffaly session continuity tools, LocalTask prompt workflows, and FeedingFrenzy JsonWs tools in this separate project.";
}

prototype FeedingFrenzyAgentGuardedWriteActionRoot : CoreAction, FeedingFrenzyJsonWsGuardedWriteAction
{
	Description = @"Explicit guarded-write action root for high-risk Feeding Frenzy mutations and document-signing lifecycle operations. Use only when a caller intentionally loads a specific write action; this is separate from the default read-oriented FeedingFrenzy agent root.";
}

[SemanticEntity("feeding frenzy agent entity root")]
prototype FeedingFrenzyAgentEntityRoot : CoreEntity
{
	Description = "Entity root for the unified Feeding Frenzy agent.";
}

[SemanticEntity("feeding frenzy agent skill")]
prototype FeedingFrenzyAgentSkill : SkillEntity
{
	Description = "Unified non-voice Feeding Frenzy agent skill root combining lead, navigation, call-analysis, and Buffaly-native continuity support.";
