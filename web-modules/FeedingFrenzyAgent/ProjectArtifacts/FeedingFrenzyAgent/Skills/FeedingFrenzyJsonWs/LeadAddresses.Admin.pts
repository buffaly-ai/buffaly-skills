[SemanticProgram.InfinitivePhrase("to get feeding frenzy lead address by id")]
prototype LeadAddresses_GetLeadAddress : FeedingFrenzyJsonWsAdminAction, FeedingFrenzyJsonWsSkillAction
{
	Description = @"service - required FeedingFrenzyJsonWsService binding. LeadAddressID - numeric lead address id.";

	function Execute(FeedingFrenzyJsonWsService service, int LeadAddressID) : string
	{
		if (service == null) return "Error: FeedingFrenzyJsonWsService binding is required.";
		JsonObject args = new JsonObject();
		args["LeadAddressID"] = LeadAddressID;
		return service.CallBusinessRoute("lead-addresses/get-lead-address", args);
	}
}

