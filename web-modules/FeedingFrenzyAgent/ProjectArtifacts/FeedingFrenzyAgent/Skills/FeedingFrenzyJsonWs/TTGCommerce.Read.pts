[SemanticProgram.InfinitivePhrase("to search feeding frenzy customers")]
prototype Customers_GetCustomers : FeedingFrenzyJsonWsSkillAction
{
	Description = @"Thin mirror of Customers.GetCustomers. CustomerID is the returned LeadID and must have an Account link. Optional filter IDs: zero means no filter, not a row ID. First read current query scope; representative-restricted users must use its representative. Search uses the existing customer proc. Sort: LeadID, AccountID, Company, FirstName, LastName, Email, Phone, DateCreated or LastUpdated. SkipRows is zero-based; NumRows 1..200.";
	function Execute(int AccountID, int TagID, int LeadStatusID, int LeadSubStatusID, int SalesRepresentativeID, string Search, string SortColumn, bool SortAscending, int SkipRows, int NumRows) : string
	{
		return FeedingFrenzyCommerceReadTools.Customers_GetCustomers(FeedingFrenzyJsonWsService#Current.ClientBinding(), AccountID, TagID, LeadStatusID, LeadSubStatusID, SalesRepresentativeID, Search, SortColumn, SortAscending, SkipRows, NumRows);
	}
}

[SemanticProgram.InfinitivePhrase("to count matching feeding frenzy customers")]
prototype Customers_CountCustomers : FeedingFrenzyJsonWsSkillAction
{
	Description = @"Matching SQL count for GetCustomers; use exactly the same five filters and Search. No count from fetched-page length. Zero optional IDs mean no filter; existing representative permissions still apply.";
	function Execute(int AccountID, int TagID, int LeadStatusID, int LeadSubStatusID, int SalesRepresentativeID, string Search) : string
	{
		return FeedingFrenzyCommerceReadTools.Customers_CountCustomers(FeedingFrenzyJsonWsService#Current.ClientBinding(), AccountID, TagID, LeadStatusID, LeadSubStatusID, SalesRepresentativeID, Search);
	}
}

