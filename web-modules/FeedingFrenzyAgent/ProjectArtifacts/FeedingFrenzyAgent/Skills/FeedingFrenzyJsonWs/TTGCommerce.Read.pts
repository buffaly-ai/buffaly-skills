[SemanticProgram.InfinitivePhrase("to search feeding frenzy catalog products")]
prototype ProductsAdmin_GetProductsPage : FeedingFrenzyJsonWsSkillAction
{
	Description = @"Existing ProductGridResult Rows plus long TotalRows from the same SQL call. Optional IDs zero mean null; IsEnabled/IsInStock empty mean null, otherwise exact true/false. PriceTypeID zero gives all schedules. Sort: ProductName, ProductCode, SellingPrice, VendorCost, IsEnabled, InstockQuantity, VendorProductCode or LastUpdated. Vendor mode is ProductVendor-grained: TotalRows is mappings, not distinct products. Recorded on hand is not free-to-sell availability; absent pricing is not zero. Max200.";
	function Execute(int ProductID, int ProductVendorID, int VendorID, int CategoryID, string IsEnabled, string IsInStock, string Search, int PriceTypeID, string SortColumn, bool SortAscending, int SkipRows, int NumRows) : string
	{
		JsonObject args = FeedingFrenzyCommerceReadTools.ProductPageArguments(ProductID, ProductVendorID, VendorID, CategoryID, IsEnabled, IsInStock, Search, PriceTypeID, SortColumn, SortAscending, SkipRows, NumRows);
		return FeedingFrenzyJsonWsService#Current.CallUiRoute("products-admin/get-products-page", args);
	}
}

