[SemanticProgram.InfinitivePhrase("to search feeding frenzy customers")]
prototype Customers_GetCustomers : FeedingFrenzyJsonWsSkillAction
{
	Description = @"Thin mirror of Customers.GetCustomers. CustomerID is the returned LeadID and must have an Account link. Optional filter IDs: zero means no filter, not a row ID. First read current query scope; representative-restricted users must use its representative. Search uses the existing customer proc. Sort: LeadID, AccountID, Company, FirstName, LastName, Email, Phone, DateCreated or LastUpdated. SkipRows is zero-based; NumRows 1..200.";
	function Execute(int AccountID, int TagID, int LeadStatusID, int LeadSubStatusID, int SalesRepresentativeID, string Search, string SortColumn, bool SortAscending, int SkipRows, int NumRows) : string
	{
		if (AccountID < 0) return "Error: AccountID must be zero (no filter) or positive.";
		if (TagID < 0) return "Error: TagID must be zero (no filter) or positive.";
		if (LeadStatusID < 0) return "Error: LeadStatusID must be zero (no filter) or positive.";
		if (LeadSubStatusID < 0) return "Error: LeadSubStatusID must be zero (no filter) or positive.";
		if (SalesRepresentativeID < 0) return "Error: SalesRepresentativeID must be zero (no filter) or positive.";
		if (Search == null || Search.Length > 255) return "Error: Search is required and limited to 255 characters.";
		if (SkipRows < 0 || NumRows < 1 || NumRows > 200) return "Error: Invalid page bounds; NumRows must be 1 through 200.";
		JsonObject args = new JsonObject();
		if (AccountID == 0) args["AccountID"] = null; else args["AccountID"] = AccountID;
		if (TagID == 0) args["TagID"] = null; else args["TagID"] = TagID;
		if (LeadStatusID == 0) args["LeadStatusID"] = null; else args["LeadStatusID"] = LeadStatusID;
		if (LeadSubStatusID == 0) args["LeadSubStatusID"] = null; else args["LeadSubStatusID"] = LeadSubStatusID;
		if (SalesRepresentativeID == 0) args["SalesRepresentativeID"] = null; else args["SalesRepresentativeID"] = SalesRepresentativeID;
		args["Search"] = Search;
		args["SortColumn"] = SortColumn;
		args["SortAscending"] = SortAscending;
		args["SkipRows"] = SkipRows;
		args["NumRows"] = NumRows;
		return FeedingFrenzyJsonWsService#Current.CallBusinessRoute("customers/get-customers", args);
	}
}

