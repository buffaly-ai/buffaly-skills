	function Execute(int ProductID, int PriceTypeID) : string
	{
		return FeedingFrenzyCommerceReadTools.ProductsAdmin_GetProduct(FeedingFrenzyJsonWsService#Current.ClientBinding(), ProductID, PriceTypeID);
	}
}

