reference FeedingFrenzy.Agent.Tools FeedingFrenzy.Agent.Tools;
import FeedingFrenzy.Agent.Tools FeedingFrenzy.Agent.Tools.FeedingFrenzyLeadEvidenceTools FeedingFrenzyLeadEvidenceTools;
[SemanticProgram.InfinitivePhrase("to get feeding frenzy follow up by lead id")]
prototype LeadNotes_GetFollowUpByLeadID : FeedingFrenzyJsonWsSkillAction
{
	Description = @"service - required FeedingFrenzyJsonWsService binding. LeadID - numeric lead id.";

	function Execute(int LeadID) : string
	{
		JsonObject args = new JsonObject();
		args["LeadID"] = LeadID;
		return FeedingFrenzyJsonWsService#Current.CallBusinessRoute("lead-notes/get-follow-up-by-lead-id", args);
	}
}
