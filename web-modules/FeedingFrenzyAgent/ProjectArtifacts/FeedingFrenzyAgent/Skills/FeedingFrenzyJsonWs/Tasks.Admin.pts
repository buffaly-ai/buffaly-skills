[SemanticProgram.InfinitivePhrase("to create a feeding frenzy task")]
prototype Tasks_InsertTask : FeedingFrenzyJsonWsAdminGuardedWriteAction, FeedingFrenzyJsonWsSkillAction
{
	Description = @"Creates a task through generated Tasks.InsertTask. AssignToUserID 0 means unassigned and is sent as null. DueDate is an ISO-like string; pass an empty string for no due date. Data must contain only approved task metadata.";
	function Execute(FeedingFrenzyJsonWsService service, string TaskDescription, int TaskStatusID, int AssignToUserID, int CreatedByUserID, string Data, string DueDate, string Notes) : string
	{
		if (service == null) return "Error: FeedingFrenzyJsonWsService binding is required.";
		JsonObject args = new JsonObject();
		args["TaskDescription"] = TaskDescription;
		args["TaskStatusID"] = TaskStatusID;
		if (AssignToUserID > 0) args["AssignToUserID"] = AssignToUserID;
		else args["AssignToUserID"] = null;
		args["CreatedByUserID"] = CreatedByUserID;
		args["Data"] = Data;
		args["DueDate"] = DueDate;
		args["Notes"] = Notes;
		return service.CallBusinessRoute("tasks/insert-task", args);
	}
}

