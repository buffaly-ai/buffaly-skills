[SemanticProgram.InfinitivePhrase("to get a feeding frenzy task")]
prototype Tasks_GetTask : FeedingFrenzyJsonWsAdminAction, FeedingFrenzyJsonWsSkillAction
{
	Description = @"Gets one task through FeedingFrenzy.Admin.Business.Tasks.GetTask.";
	function Execute(FeedingFrenzyJsonWsService service, int TaskID) : string
	{
