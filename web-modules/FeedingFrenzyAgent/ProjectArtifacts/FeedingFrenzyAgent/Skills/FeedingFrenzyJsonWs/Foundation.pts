[SemanticEntity("feeding frenzy json ws skill")]
prototype FeedingFrenzyJsonWsSkill : SkillEntity
{
	Description = "Feeding Frenzy JSON web service skill exposed through role-composed ProtoScript entry points.";
	ActionRoot = FeedingFrenzyJsonWsSkillAction;
}

prototype FeedingFrenzyJsonWsService : Service
{
	ServiceName = "FeedingFrenzyJsonWsService";
	Scope = "per-binding";
	Description = @"Feeding Frenzy route-based JSON service. Current is configured by authenticated embedded launch. Explicit tenant bindings are for separately authorized diagnostics.";

	String BaseUrl = new String();
	String BusinessApiPrefix = "api/feedingfrenzy.admin.business";
	String CallCenterApiPrefix = "api/feedingfrenzy.callcenter";
	String UiApiPrefix = "api/feedingfrenzy.admin.ui";
	String TokenKey = new String();
	Bool TokenIsAuthorizationToken = false;
	String AutomationUserEmail = new String();

	function Initialize() : string
	{
		if (StringUtil.IsEmpty(this.BaseUrl))
			return "Error: FeedingFrenzyJsonWsService.BaseUrl must be configured.";
		if (StringUtil.IsEmpty(this.TokenKey))
			return "Error: FeedingFrenzyJsonWsService authorization must be configured.";
		return "Feeding Frenzy service binding initialized.";
	}

	function ConfigureAuthorization(string BaseUrl, string AuthorizationToken) : string
	{
		if (StringUtil.IsEmpty(BaseUrl))
			return "Error: BaseUrl is required.";
		if (StringUtil.IsEmpty(AuthorizationToken))
			return "Error: AuthorizationToken is required.";

		this.BaseUrl = BaseUrl;
		this.TokenKey = AuthorizationToken;
		this.TokenIsAuthorizationToken = true;
		return "Feeding Frenzy authorization configured for this session.";
	}

	function CallBusinessRoute(string routePath, JsonObject args) : string
	{
		if (StringUtil.IsEmpty(this.BaseUrl) || StringUtil.IsEmpty(this.TokenKey))
			return "Error: Current Feeding Frenzy session binding is not configured.";
		JsonObject normalizedArgs = args == null ? new JsonObject() : args;
		return this.TokenIsAuthorizationToken
			? JsonWsHelper.CallJsonRoute(this.BaseUrl, this.BusinessApiPrefix, routePath, this.TokenKey, normalizedArgs)
			: JsonWsHelper.CallJsonRouteSecure(this.BaseUrl, this.BusinessApiPrefix, routePath, this.TokenKey, normalizedArgs);
	}

	function CallCallCenterRoute(string routePath, JsonObject args) : string
	{
		if (StringUtil.IsEmpty(this.BaseUrl) || StringUtil.IsEmpty(this.TokenKey))
			return "Error: Current Feeding Frenzy session binding is not configured.";
		JsonObject normalizedArgs = args == null ? new JsonObject() : args;
		return this.TokenIsAuthorizationToken
			? JsonWsHelper.CallJsonRoute(this.BaseUrl, this.CallCenterApiPrefix, routePath, this.TokenKey, normalizedArgs)
			: JsonWsHelper.CallJsonRouteSecure(this.BaseUrl, this.CallCenterApiPrefix, routePath, this.TokenKey, normalizedArgs);
	}

	function CallUiRoute(string routePath, JsonObject args) : string
	{
		if (StringUtil.IsEmpty(this.BaseUrl) || StringUtil.IsEmpty(this.TokenKey))
			return "Error: Current Feeding Frenzy session binding is not configured.";
		JsonObject normalizedArgs = args == null ? new JsonObject() : args;
		return this.TokenIsAuthorizationToken
			? JsonWsHelper.CallJsonRoute(this.BaseUrl, this.UiApiPrefix, routePath, this.TokenKey, normalizedArgs)
			: JsonWsHelper.CallJsonRouteSecure(this.BaseUrl, this.UiApiPrefix, routePath, this.TokenKey, normalizedArgs);
	}
}

