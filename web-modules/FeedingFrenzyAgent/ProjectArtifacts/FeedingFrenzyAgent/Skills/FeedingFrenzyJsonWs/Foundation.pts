{
	Description = @"Base action type for read-oriented Feeding Frenzy JSON WS service tools.";
}

prototype FeedingFrenzyJsonWsGuardedWriteAction : FeedingFrenzyJsonWsSkillAction
{
	Description = @"Base action type for narrow Feeding Frenzy JSON WS write tools.";
