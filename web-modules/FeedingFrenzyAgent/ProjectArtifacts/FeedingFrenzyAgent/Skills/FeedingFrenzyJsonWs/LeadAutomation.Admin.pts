reference FeedingFrenzy.Agent.Tools FeedingFrenzy.Agent.Tools;
import FeedingFrenzy.Agent.Tools FeedingFrenzy.Agent.Tools.FeedingFrenzyLeadEvidenceTools FeedingFrenzyLeadEvidenceTools;

[SemanticProgram.InfinitivePhrase("to search feeding frenzy leads")]
[SemanticProgram.InfinitivePhrase("to search feeding frenzy leads by name")]
[SemanticProgram.InfinitivePhrase("to find feeding frenzy lead")]
prototype LeadAutomation_GetLeadsBySearch : FeedingFrenzyJsonWsSkillAction
{
	Description = @"JsonWs wrapper over FeedingFrenzy.Admin.Business.LeadAutomation.GetLeadsBySearch(Search). Returns raw response JSON string.";

	function Execute(string Search) : string
	{
		JsonObject args = new JsonObject();
		args["Search"] = Search;
		return FeedingFrenzyJsonWsService#Current.CallBusinessRoute("lead-automation/get-leads-by-search", args);
	}
}

[SemanticProgram.InfinitivePhrase("to get the latest feeding frenzy leads")]
[SemanticProgram.InfinitivePhrase("to find the newest feeding frenzy lead")]
prototype LeadAutomation_GetLatestLeads : FeedingFrenzyJsonWsSkillAction
{
	Description = @"Fresh authorized lead search ordered by DateCreated descending. For latest/newest lead requests, call this on the current turn before selecting a LeadID and fetching details; never infer newest from remembered detail results. Tied creation timestamps are equally recent. Returns response JSON with Markdown lead IDs.";

	function Execute(string Search) : string
	{
		JsonObject args = new JsonObject();
		args["Search"] = Search;
		return FeedingFrenzyJsonWsService#Current.CallBusinessRoute("lead-automation/get-latest-leads", args);
	}
}

prototype LeadAutomation_GetLeadsByTagName : FeedingFrenzyJsonWsSkillAction
{
	Description = @"JsonWs wrapper over FeedingFrenzy.Admin.Business.LeadAutomation.GetLeadsByTagName(TagName, Search, SortColumn, SortAscending, SkipRows, NumRows). Returns raw response JSON string.";

	function Execute(string TagName, string Search, string SortColumn, bool SortAscending, int SkipRows, int NumRows) : string
	{
		JsonObject args = new JsonObject();
		args["TagName"] = TagName;
		args["Search"] = Search;
		args["SortColumn"] = SortColumn;
		args["SortAscending"] = SortAscending;
		args["SkipRows"] = SkipRows;
		args["NumRows"] = NumRows;
		return FeedingFrenzyJsonWsService#Current.CallBusinessRoute("lead-automation/get-leads-by-tag-name", args);
	}
}

prototype LeadAutomation_GetLeadAndNotesAsMarkdown : FeedingFrenzyJsonWsSkillAction
{
	function Execute(int LeadID) : string
	{
		JsonObject args = new JsonObject();
		args["LeadID"] = LeadID;
		string response = FeedingFrenzyJsonWsService#Current.CallBusinessRoute("lead-automation/get-lead-and-notes-as-markdown", args);
		return FeedingFrenzyLeadEvidenceTools.DecodeMarkdownResponse(response);
	}
	Description = "Legacy full export; use bounded research brief/index/chunks for lead advice. Returns decoded Markdown, but long histories can exceed the host cap.";
}

[SemanticProgram.InfinitivePhrase("to get a feeding frenzy lead research brief")]
prototype LeadAutomation_GetLeadResearchBrief : FeedingFrenzyJsonWsSkillAction
{
	function Execute(int LeadID, int Offset) : string
	{
		JsonObject args = new JsonObject();
		args["LeadID"] = LeadID;
		args["Offset"] = Offset;
		return FeedingFrenzyJsonWsService#Current.CallBusinessRoute("lead-automation/get-lead-research-brief", args);
	}
	Description = "Start lead advice/drafts here. Authorized lead/contact brief only, not notes. Start Offset=0 and follow NextOffset until IsComplete. Then inspect note index and relevant complete note chunks. Returns bounded JSON with Markdown and coverage.";
}
[SemanticProgram.InfinitivePhrase("to get a feeding frenzy lead note index page")]
prototype LeadAutomation_GetLeadNoteIndexPage : FeedingFrenzyJsonWsSkillAction
{
	function Execute(int LeadID, int SkipRows, int NumRows) : string
	{
		JsonObject args = new JsonObject();
		args["LeadID"] = LeadID;
		args["SkipRows"] = SkipRows;
		args["NumRows"] = NumRows;
		return FeedingFrenzyJsonWsService#Current.CallBusinessRoute("lead-automation/get-lead-note-index-page", args);
	}
	Description = "Read note IDs/dates/types, not bodies. Start SkipRows=0, NumRows=20 (1..20); follow NextSkipRows. Unique LeadNoteID DESC is traversal order, not event recency. For all-note requests visit every page and body. No snapshot promise; returns bounded JSON.";
}
[SemanticProgram.InfinitivePhrase("to read a feeding frenzy lead note markdown chunk")]
prototype LeadAutomation_GetLeadNoteMarkdownChunk : FeedingFrenzyJsonWsSkillAction
{
	function Execute(int LeadID, int LeadNoteID, int Offset) : string
	{
		JsonObject args = new JsonObject();
		args["LeadID"] = LeadID;
		args["LeadNoteID"] = LeadNoteID;
		args["Offset"] = Offset;
		return FeedingFrenzyJsonWsService#Current.CallBusinessRoute("lead-automation/get-lead-note-markdown-chunk", args);
	}
	Description = "Read one authorized note body as Markdown. Start Offset=0; follow NextOffset exactly until IsComplete. The completion flag covers THIS note only. Other notes remain unread. Returns bounded JSON with Markdown, date/type, offsets and coverage.";
}
