[SemanticProgram.InfinitivePhrase("to start an observation call")]
[SemanticProgram.InfinitivePhrase("to originate a monitored feeding frenzy call")]
[SemanticProgram.InfinitivePhrase("to begin observing an outbound call")]
prototype ToStartObservationCall : FeedingFrenzyJsonWsAdminGuardedWriteAction
{
	Description = @"Starts a direct-dial observation call through Feeding Frenzy. service - required remote or local FeedingFrenzyJsonWsService binding. ToPhone - required lead destination. FromPhone - optional configured Twilio caller ID. Record - whether FF requests dual-channel recording. BaseUrl - optional FF callback/driver base URL. DeskPhone - optional by contract but currently rejected by FF until API-originated screening is proven. Returns JSON with CallID, CallKey, DriverUrl, and Status. This action can place a billable external call and must be used only with explicit operator approval.";

	function Execute(FeedingFrenzyJsonWsService service, string ToPhone, string FromPhone, bool Record, string BaseUrl, string DeskPhone) : string
	{
		if (service == null) return "Error: FeedingFrenzyJsonWsService binding is required.";
		JsonObject args = new JsonObject();
		args["ToPhone"] = ToPhone;
		args["FromPhone"] = FromPhone;
		args["Record"] = Record;
		args["BaseUrl"] = BaseUrl;
		args["DeskPhone"] = DeskPhone;
		return service.CallBusinessRoute("twilio-admin/start-observation-call", args);
	}
}

[SemanticProgram.InfinitivePhrase("to cancel an observation call")]
[SemanticProgram.InfinitivePhrase("to hang up a feeding frenzy call")]
[SemanticProgram.InfinitivePhrase("to stop a monitored outbound call")]
prototype ToCancelObservationCall : FeedingFrenzyJsonWsAdminGuardedWriteAction
{
	Description = @"Requests idempotent cancellation of an active Feeding Frenzy observation call. service - required remote or local FeedingFrenzyJsonWsService binding. CallID - numeric call identifier. Returns JSON distinguishing an already-terminal call from a newly requested Twilio hangup. The caller must continue polling ToGetCallTranscript until terminal status is confirmed.";

	function Execute(FeedingFrenzyJsonWsService service, int CallID) : string
	{
		if (service == null) return "Error: FeedingFrenzyJsonWsService binding is required.";
		JsonObject args = new JsonObject();
		args["CallID"] = CallID;
		return service.CallBusinessRoute("twilio-admin/cancel-call", args);
	}
}

[SemanticProgram.InfinitivePhrase("to get feeding frenzy calls by date range")]
prototype Calls_GetCallsByDateRange : FeedingFrenzyJsonWsAdminAction
{
	Description = @"service - required FeedingFrenzyJsonWsService binding. StartDate and EndDate should be ISO-like date strings accepted by Feeding Frenzy JsonWs DateTime binding.";

	function Execute(FeedingFrenzyJsonWsService service, string StartDate, string EndDate) : string
	{
