[SemanticProgram.InfinitivePhrase("to get feeding frenzy call by id")]
prototype Calls_GetCall : FeedingFrenzyJsonWsSkillAction
{
	Description = @"service - required FeedingFrenzyJsonWsService binding. CallID - numeric call id.";

	function Execute(FeedingFrenzyJsonWsService service, int CallID) : string
	{
		if (service == null) return "Error: FeedingFrenzyJsonWsService binding is required.";
		JsonObject args = new JsonObject();
		args["CallID"] = CallID;
		return service.CallBusinessRoute("calls/get-call", args);
	}
}

