[SemanticProgram.InfinitivePhrase("to get an observation call transcript")]
[SemanticProgram.InfinitivePhrase("to poll a feeding frenzy call transcript")]
[SemanticProgram.InfinitivePhrase("to inspect live observation call status")]
prototype ToGetCallTranscript : FeedingFrenzyJsonWsSkillAction
{
	Description = @"Gets one structured observation-call snapshot from Feeding Frenzy. service - required remote or local FeedingFrenzyJsonWsService binding. CallID - numeric call identifier. Returns JSON containing CallID, CallStatus, Duration, IsTerminal, TranscriptVersion, Turns (TranscriptionCombined array with TurnID, Role, Text, PreviewText, Start, Stop, Length, IsFinal, FinalTranscriptionFailed), TranscriptInbound, TranscriptOutbound, TranscriptCombined, PartialParticipantA, PartialParticipantB, AICallOutcome, BuffalyObserver, TranscriptionError, and LastUpdated. Poll this read-only action for incremental observation state. Skip processing when TranscriptVersion is unchanged.";

	function Execute(FeedingFrenzyJsonWsService service, int CallID) : string
	{
		if (service == null) return "Error: FeedingFrenzyJsonWsService binding is required.";
		JsonObject args = new JsonObject();
		args["CallID"] = CallID;
		return service.CallBusinessRoute("lead-calls/get-call-transcript", args);
	}
}

[SemanticProgram.InfinitivePhrase("to get feeding frenzy call by call key")]
prototype Calls_GetCallByCallKey : FeedingFrenzyJsonWsSkillAction
{
	Description = @"service - required FeedingFrenzyJsonWsService binding. CallKey - external/stable call key.";

	function Execute(FeedingFrenzyJsonWsService service, string CallKey) : string
	{
		if (service == null) return "Error: FeedingFrenzyJsonWsService binding is required.";
		JsonObject args = new JsonObject();
		args["CallKey"] = CallKey;
		return service.CallCallCenterRoute("calls/get-call-by-call-key", args);
	}
}
