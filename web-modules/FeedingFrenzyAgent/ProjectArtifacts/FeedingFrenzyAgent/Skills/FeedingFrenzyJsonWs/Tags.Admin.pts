prototype Tags_GetTag : FeedingFrenzyJsonWsSkillAction
{
	function Execute(int TagID) : string
	{
		JsonObject args = new JsonObject();
		args["TagID"] = TagID;
		return FeedingFrenzyJsonWsService#Current.CallBusinessRoute("tags/get-tag", args);
	}
}

