// User-environment imports for the Feeding Frenzy role entries (User.SalesRepresentative.pts, User.Administrator.pts).
// Same contract as the core OpsAgent User.Imports.pts plus the two opted-in Feeding Frenzy facades. User source may
// import only Prototype/String/Bool/Int/Double wrappers and [UserEnvironmentFacade] types (UserSharedGraph).
reference Ontology Ontology;
reference Ontology.Simulation Ontology.Simulation;
reference Buffaly.Agent.Host Buffaly.Agent.Host;
reference FeedingFrenzy.Agent.Tools FeedingFrenzy.Agent.Tools;
import Ontology Ontology.Prototype Prototype;
import Ontology.Simulation Ontology.Simulation.StringWrapper String;
import Ontology.Simulation Ontology.Simulation.BoolWrapper Bool;
import Ontology.Simulation Ontology.Simulation.IntWrapper Int;
import Buffaly.Agent.Host Buffaly.Agent.Host.UserMemoryFacade UserMemory;
import Buffaly.Agent.Host Buffaly.Agent.Host.UserAnnotationFacade UserAnnotations;
import Buffaly.Agent.Host Buffaly.Agent.Host.UserDiscoveryFacade UserDiscovery;
import Buffaly.Agent.Host Buffaly.Agent.Host.UserSessionFacade UserSessions;
import Buffaly.Agent.Host Buffaly.Agent.Host.UserPlanFacade UserPlan;
import Buffaly.Agent.Host Buffaly.Agent.Host.UserBorrowFacade UserBorrow;
import FeedingFrenzy.Agent.Tools FeedingFrenzy.Agent.Tools.FeedingFrenzyUserJsonWs FeedingFrenzyUserJsonWs;
import FeedingFrenzy.Agent.Tools FeedingFrenzy.Agent.Tools.FeedingFrenzyLeadEvidenceTools FeedingFrenzyLeadEvidenceTools;

function PromptEnvironmentAvailable() : bool { return UserMemory.Available(); }
function ReadEnvironmentPrompt(string path) : string { return UserMemory.ReadPrompt(path); }
function EnvironmentInsertOrUpdatePrototypeDefinition(string fileName, string prototypeDefinition) : string { return UserMemory.InsertOrUpdatePrototypeDefinition(fileName, prototypeDefinition); }
function EnvironmentUpsertPromptActionArtifacts(string promptActionsFileName, string prototypeDefinition, string promptFileName, string promptText) : string { return UserMemory.UpsertPromptActionArtifacts(promptActionsFileName, prototypeDefinition, promptFileName, promptText); }
function EnvironmentInsertOrUpdatePromptFile(string promptFileName, string promptText) : string { return UserMemory.InsertOrUpdatePromptFile(promptFileName, promptText); }
function EnvironmentAddInfinitivePhraseToAction(string fileName, string actionPrototypeName, string infinitivePhrase) : string { return UserMemory.AddInfinitivePhraseToAction(fileName, actionPrototypeName, infinitivePhrase); }
function EnvironmentAddSemanticEntityNameToPrototype(string fileName, string prototypeName, string semanticEntityName) : string { return UserMemory.AddSemanticEntityNameToPrototype(fileName, prototypeName, semanticEntityName); }
function EnvironmentAuthoringContract() : string
{
	return @"User environment: author memories, preferences and prompt skills only under Nodes/Personal. Shared sources are read-only even if explicitly requested. Use existing tools; do not add DLL references, imports, externs, native handles or reflection. Ordinary Prototype values are data, not authority. Persisted semantic annotations require literal strings; scoped retractions affect this source only. Source save, runtime activation and semantic registration are separate outcomes. ValidatedPromptAction is not available in this POC.";
}
