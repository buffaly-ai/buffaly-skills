[SemanticProgram.InfinitivePhrase("to list the first level descendants of a prototype")]
[SemanticProgram.InfinitivePhrase("to get direct descendants of a prototype")]

[SemanticProgram.InfinitivePhrase("to get the notes of a prototype")]
[SemanticProgram.InfinitivePhrase("to get prototype notes")]
[SemanticProgram.InfinitivePhrase("to read prototype notes")]
prototype ToGetPrototypeNotes : Level2ObserverActionRoot
{
	Description = @"prototype - prototype reference to inspect. Returns the Notes property value when present; otherwise returns an empty string.";

	function Execute(Prototype prototype) : string
	{
		// This helper is for memory workflows that need a quick read of unstructured prototype notes.
		// It intentionally returns only the Notes field (when present) rather than the full prototype dump.
		if (prototype == null)
		{
			return "";
		}

		string details = PrototypeLogging.ToFriendlyString(prototype).ToString();
		if (StringUtil.IsEmpty(details))
		{
			return "";
		}

		string marker = "Notes = ";
		int notesStart = details.IndexOf(marker);
		if (notesStart < 0)
		{
			return "";
		}

		string value = details.Substring(notesStart).Trim();
		if (value.StartsWith(marker))
		{
			value = value.Replace(marker, "");
		}

		int newLine = value.IndexOf("\n");
		if (newLine >= 0)
		{
			value = value.Substring(0, newLine).Trim();
		}

		if (value.StartsWith("\"") && value.EndsWith("\"") && value.Length >= 2)
		{
			// Keep quotes for now to avoid arithmetic parser edge cases on slice lengths.
			return value;
		}

		return value;
	}
}
prototype ToListPrototypeFirstLevelDescendants : CoreAction, Level2ObserverActionRoot
{
	Description = @"
	Return the first level descendants of the specified prototype.
	This returns only direct descendants (one level), not recursive descendants.
	";

	function Execute(Prototype prototype) : Collection
	{
		// Return direct descendant prototypes so runtime serialization preserves prototype structure.
		if (prototype == null)
		{
			return new Collection();
		}

		return prototype.GetDescendants();
	}
}

function ToGetCurrentSessionDirectorySafe() : string
{
	// Resolve the active session directory from runtime host and ensure it exists.
	if (_opsAgent == null)
	{
		return "";
	}

	string sessionDirectory = _opsAgent.GetCurrentSessionDirectory();
	if (StringUtil.IsEmpty(sessionDirectory))
	{
		return "";
	}

	string escapedSessionDirectory = sessionDirectory.Replace("'", "''");
	string ensureDirectoryScript =
		"$path='" + escapedSessionDirectory + "'\n" +
		"if (-not (Test-Path -LiteralPath $path)) { New-Item -ItemType Directory -Path $path -Force | Out-Null }";
	SystemOperations.RunPowerShell(ensureDirectoryScript);

	return sessionDirectory;
}

function ToDefaultScratchMarkdown() : string
{
	// Return the default markdown scaffold for Scratch.md.
	return
		"# Scratch\n\n" +
		"## Now\n" +
		"- \n\n" +
		"## Next\n" +
		"- \n\n" +
		"## Waiting On\n" +
		"- \n\n" +
		"## Blocked\n" +
		"- \n\n" +
		"## Done (Recent)\n" +
		"- \n\n" +
		"## Notes\n" +
		"- \n";
}

[SemanticProgram.InfinitivePhrase("to initialize session plan and scratch")]
[SemanticProgram.InfinitivePhrase("to initialize session planning files")]
prototype ToInitializeSessionPlanAndScratch : OpsAction, CoreAction
{
	Description = @"Creates Plan.md and Scratch.md in the current session directory when missing. If they already exist, leaves them unchanged and returns a status summary. IMPORTANT: This is the recovery entry point after provider compaction. Callers must also read the most recent user message or snapshot to re-anchor the current task if Plan.md is stale.";

	function Execute() : string
	{
		// Initialize Plan.md and Scratch.md once for the active session directory.
		if (_opsAgent == null)
		{
			return "Error: _opsAgent runtime is not available.";
		}

		string sessionDirectory = ToGetCurrentSessionDirectorySafe();
		if (StringUtil.IsEmpty(sessionDirectory))
		{
			return "Error: current session directory is unavailable.";
		}

		return SessionPlanManagementService.InitializePlanAndScratch(_opsAgent, ToDefaultScratchMarkdown());
	}
}

[SemanticProgram.InfinitivePhrase("to get the session plan")]
[SemanticProgram.InfinitivePhrase("to read session plan markdown")]
prototype ToGetSessionPlan : CoreAction, Level2ObserverActionRoot
{
	Description = @"Reads Plan.md from the current session directory. If missing, creates it from the authoritative structured template and returns the full content as StringRef.";

	function Execute() : string
	{
		// Load Plan.md through the host plan service so one format owns rendering.
		if (_opsAgent == null)
		{
			return "Error: _opsAgent runtime is not available.";
		}

		string sessionDirectory = ToGetCurrentSessionDirectorySafe();
		if (StringUtil.IsEmpty(sessionDirectory))
		{
			return "Error: current session directory is unavailable.";
		}

		return SessionPlanManagementService.GetSessionPlanMarkdown(_opsAgent);
	}
}

