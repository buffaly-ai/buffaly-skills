[SemanticProgram.InfinitivePhrase("to load a context prompt")]
[SemanticProgram.InfinitivePhrase("to load a situational behavior prompt")]
prototype ToLoadContextPrompt : OpsAction
{
	Description = @"contextPromptPrototype - prototype reference/name for a ContextPrompt (for example: CodingContextPrompt).
Returns trusted context prompt markdown with a short header that this is a situational behavior overlay, not a task result.";

	function Execute(string contextPromptPrototype) : string
	{
		if (_opsAgent == null)
			return "Error: _opsAgent runtime is not available.";

		string prototypeName = contextPromptPrototype.Trim();
		if (StringUtil.IsEmpty(prototypeName))
			return "Error: contextPromptPrototype is required.";

		ContextPrompt resolvedContextPrompt = null;
		Collection contextPrompts = ContextPrompt.GetDescendants();
		foreach (Prototype candidatePrototype in contextPrompts)
		{
			if (candidatePrototype.PrototypeName == prototypeName)
			{
				if (candidatePrototype typeof ContextPrompt)
					resolvedContextPrompt = candidatePrototype;
			}
		}

		if (resolvedContextPrompt == null)
			return "Error: ContextPrompt prototype not found: " + prototypeName;

		if (StringUtil.IsEmpty(resolvedContextPrompt.PromptPath))
			return "Error: ContextPrompt PromptPath is empty for: " + prototypeName;

		string promptText = _opsAgent.LoadTrustedPromptText(resolvedContextPrompt.PromptPath);
		string instructionHeader =
			"## Context Prompt Instructions\n"
			+ "This is a context prompt.\n"
			+ "Apply it as a behavioral overlay for the current turn.\n"
			+ "Do not treat this as task completion.\n"
			+ "Context source: " + resolvedContextPrompt.PromptPath + "\n\n";

		return instructionHeader + promptText;
	}
}

