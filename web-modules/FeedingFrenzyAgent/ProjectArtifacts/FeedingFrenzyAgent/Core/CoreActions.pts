[SemanticProgram.InfinitivePhrase("to list the ProtoScript files available to the ops agent")]
prototype ToListOpsAgentProtoScriptFiles : OpsAction
{
	Description = @"Returns the .pts files from the OpsAgent project directory.";

	function Execute() : string
	{
		// List .pts file names from the OpsAgent project directory using PowerShell.
		string projectDirectory = _opsAgent.GetCurrentProjectDirectory();
		if (StringUtil.IsEmpty(projectDirectory))
		{
			return "Error: current project directory is unavailable.";
		}

		string escapedProjectDirectory = projectDirectory.Replace("'", "''");
		String script = "Get-ChildItem -Path '" + escapedProjectDirectory + "' -Filter \"*.pts\" | Select-Object -ExpandProperty Name";
		return SystemOperations.RunPowerShell(script);
	}
}

