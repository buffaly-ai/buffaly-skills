}


[SemanticProgram.InfinitivePhrase("to remove redundant prototype parents in a file")]
[SemanticProgram.InfinitivePhrase("to normalize prototype inheritance parents")]
[SemanticProgram.InfinitivePhrase("to clean redundant baseobject parent declarations")]
prototype ToRemoveRedundantPrototypeParentsInFile : ProtoScriptAction
{
	Description = @"fileName - target .pts file path relative to project root.
includePartials - when true, also normalize partial prototype declarations.
Removes transitive redundant parents (for example `: Parent, BaseObject` where Parent already inherits BaseObject) and writes updates back to file.";

	function Execute(string fileName, bool includePartials) : string
	{
		if (_opsAgent != null)
			return CoreOntologyTools.RemoveRedundantPrototypeParentsInCurrentProject(_opsAgent, fileName, includePartials);

		return "Error: _opsAgent runtime is not available.";
	}
}
[SemanticProgram.InfinitivePhrase("to search the web with an llm")]
prototype ToSearchTheWebWithAnLLM : ProtoScriptAction
{
	function Execute(string question) : string
	{
		return LLMs.ExecuteWebSearch(question);
	}
	Description = @"
		question - the question to research using web search. Uses the fixed internal web-search model; callers cannot choose or override the model.";
}







