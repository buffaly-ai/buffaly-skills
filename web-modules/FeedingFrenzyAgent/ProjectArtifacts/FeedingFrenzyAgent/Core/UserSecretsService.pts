import Buffaly.Agent.Tools.Secrets Buffaly.Agent.Tools.Secrets.UserSecrets UserSecrets;

prototype UserSecretsService : Service
{
	ServiceName = "UserSecretsService";
	Scope = "singleton";
	Description = @"Global user-secret store for reading and writing sensitive credentials.";

	function Initialize() : string
	{
		return UserSecrets.EnsureInitializedForService();
	}

	function ToGetSecret(string key) : string
	{
		return UserSecrets.GetSecret(key);
	}

	function ToSetSecret(string key, string value) : string
	{
		return UserSecrets.SetSecret(key, value);
	}
}
