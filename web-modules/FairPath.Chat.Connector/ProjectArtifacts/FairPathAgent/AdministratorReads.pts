[SemanticProgram.InfinitivePhrase("to get a fairpath patient")]
prototype Patients_GetPatient : FairPathReadAction
{
	function Execute(int PatientID) : string
	{
		JsonObject args = new JsonObject();
		args["PatientID"] = PatientID;
		return FairPathJsonWsService#Current.CallBusinessRoute("patients/get-patient", args, new JsonObject(FairPathJsonWsService#Current.PatientFields));
	}
	Description = "Calls the existing published FairPath read API using the privately bound user token. No route, token or mutation input.";
}
[SemanticProgram.InfinitivePhrase("to search fairpath patients")]
prototype Patients_GetPatients : FairPathReadAction
{
	function Execute(int? OrganizationID, string Search, int SkipRows, int NumRows) : string
	{
		PatientReadWindow.Validate(Search, SkipRows, NumRows);
		JsonObject args = new JsonObject();
		args["Search"] = Search;
		args["SortColumn"] = "PatientID";
		args["SortAscending"] = true;
		args["SkipRows"] = SkipRows;
		args["NumRows"] = NumRows;
		if (OrganizationID != null)
		{
			args["OrganizationID"] = OrganizationID;
			return FairPathJsonWsService#Current.CallBusinessRoute("patients/get-patients-by-organization-id-sp-_-paging-sp", args, new JsonObject(FairPathJsonWsService#Current.PatientFields));
		}
		return FairPathJsonWsService#Current.CallBusinessRoute("patients/get-patients-sp-_-paging-sp", args, new JsonObject(FairPathJsonWsService#Current.PatientFields));
	}
	Description = "Calls the existing published FairPath read API using the privately bound user token. No route, token or mutation input.";
}
[SemanticProgram.InfinitivePhrase("to count fairpath patients")]
prototype Patients_GetPatientCount : FairPathReadAction
{
	function Execute(int? OrganizationID, string Search) : string
	{
		JsonObject args = new JsonObject();
		args["Search"] = Search;
		if (OrganizationID != null)
		{
			args["OrganizationID"] = OrganizationID.ToString();
			return FairPathJsonWsService#Current.CallUiRoute("patients-admin/get-grid-by-organization-id-count", args);
		}
		return FairPathJsonWsService#Current.CallUiRoute("patients-admin/get-grid-count", args);
	}
	Description = "Calls the existing published FairPath read API using the privately bound user token. No route, token or mutation input.";
}
