	function ConfigureAuthorization(string BaseUrl, string AuthorizationToken) : string
	{
		if (StringUtil.IsEmpty(BaseUrl) || StringUtil.IsEmpty(AuthorizationToken))
		{
			return "Error: FairPath origin and user authorization are required.";
		}
		this.BaseUrl = BaseUrl;
		this.AuthorizationToken = AuthorizationToken;
		return "FairPath user authorization configured.";
	}

	function CallRoute(string ApiPrefix, string RoutePath, JsonObject Args, JsonObject Serialize) : string
	{
		string result = JsonWsHelper.CallJsonRoute(this.BaseUrl, ApiPrefix, RoutePath, this.AuthorizationToken, Args, Serialize);
		if (result.Length > 1000000)
		{
			return "Error: FairPath result exceeds the assistant limit. Use a supported record or organization/status filter.";
		}
		return result;
	}

	function CallBusinessRoute(string RoutePath, JsonObject Args, JsonObject Serialize) : string
	{
		return this.CallRoute("api/fairpath.business", RoutePath, Args, Serialize);
	}

	function CallUiRoute(string RoutePath, JsonObject Args) : string
	{
		return this.CallRoute("api/fairpath.portal.admin.ui", RoutePath, Args, null);
	}

	function CallStagingRoute(string RoutePath, JsonObject Args, JsonObject Serialize) : string
	{
		return this.CallRoute("api/fairpath.staging.business", RoutePath, Args, Serialize);
	}
}
