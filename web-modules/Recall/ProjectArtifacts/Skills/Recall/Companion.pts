reference Buffaly.Agent.Recall Buffaly.Agent.Recall;
import Buffaly.Agent.Recall Buffaly.Agent.Recall.RecallCompanionFacade RecallCompanionFacade;
import Buffaly.Agent.Recall Buffaly.Agent.Recall.RecallResearch RecallResearch;
import Buffaly.Agent.Recall Buffaly.Agent.Recall.RecallPublicationFacade RecallPublicationFacade;
prototype RecallCompanionAction : OpsAction;
prototype RecallCompanionEntity : SemanticEntityBase;
prototype ToDispatchRecallObservation : RecallCompanionAction
{
	function Execute(string callbackJson) : string { return RecallCompanionFacade.Render(_opsAgent, callbackJson); }
}
[InfinitivePhrase("to find recall entities")]
prototype ToFindRecallEntities : RecallCompanionAction
{
	function Execute(string query) : string { return RecallResearch.Search(_opsAgent, query, false); }
}
[InfinitivePhrase("to find recall actions")]
prototype ToFindRecallActions : RecallCompanionAction
{
	function Execute(string query) : string { return RecallResearch.Search(_opsAgent, query, true); }
}
[InfinitivePhrase("to inspect a recall definition")]
prototype ToInspectRecallDefinition : RecallCompanionAction
{
	function Execute(string ownerScope, string prototypeName) : string { return RecallResearch.Definition(_opsAgent, ownerScope, prototypeName); }
}
[InfinitivePhrase("to read recall evidence")]
prototype ToReadRecallEvidence : RecallCompanionAction
{
	function Execute(string evidenceId, int start, int length) : string { return RecallResearch.Evidence(_opsAgent, evidenceId, start, length); }
}
[InfinitivePhrase("to search recall evidence")]
prototype ToSearchRecallEvidence : RecallCompanionAction
{
	function Execute(string evidenceId, string query) : string { return RecallResearch.SearchEvidence(_opsAgent, evidenceId, query); }
}
[InfinitivePhrase("to read a recall source message")]
prototype ToReadRecallMessage : RecallCompanionAction
{
	function Execute(string sessionKey, string messageKey, int start, int length) : string { return RecallResearch.Message(_opsAgent, sessionKey, messageKey, start, length); }
}
[InfinitivePhrase("to publish a recall finding")]
prototype ToPublishRecallFinding : RecallCompanionAction
{
	function Execute(string draftJson) : string { return RecallPublicationFacade.Publish(_opsAgent, draftJson); }
}
