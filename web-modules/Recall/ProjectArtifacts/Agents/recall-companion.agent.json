{
  "AgentName": "recall-companion",
  "DisplayName": "Context Recall",
  "Provider": "openai",
  "DefaultModelName": "gpt-6-luna",
  "DefaultReasoningLevel": "high",
  "Appearance": {
    "LabelSource": "AgentDisplayName",
    "Emphasis": "Supporting",
    "Icon": "compass",
    "TextColor": { "Light": "#0F766E", "Dark": "#5EEAD4" }
  },
  "PromptFile": "Skills/Recall/Companion.prompt.md",
  "ProjectFilePath": "Skills/Recall/CompanionProject.pts",
  "EnableImmediateProtoScriptCommands": false,
  "RootActionPrototypeName": "RecallCompanionAction",
  "RootEntityPrototypeName": "RecallCompanionEntity",
  "UiPage": "/buffaly-agent.html",
  "IsHidden": true,
  "IsReadOnly": false,
  "CanChangeModel": true,
  "CompanionAgents": [],
  "CompanionAttachment": {
    "SessionKeyStrategy": "suffix",
    "SessionSuffix": "-recall",
    "SourceBinding": {
      "SetParentSessionKey": true,
      "ObservedSessionUserStateKey": "ObservedSessionKey"
    },
    "Events": [
      "user.input.admitted"
    ],
    "HandlerAction": "tool:ToDispatchRecallObservation"
  }
}
