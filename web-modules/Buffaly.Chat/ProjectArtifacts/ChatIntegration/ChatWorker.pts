reference Buffaly.Chat.Server;
import Buffaly.Chat.Server Buffaly.Chat.Server.ChatRuntime ChatRuntime;
import Buffaly.Chat.Server Buffaly.Chat.Server.ChatWorkerExecution ChatWorkerExecution;
prototype ChatIngressWorker
{
	function Run(string MessageKey) : string
	{
		return ChatWorkerExecution.Run(_opsAgent, MessageKey);
	}

	function Prepare(string MessageKey) : string
	{
		return ChatRuntime.Prepare(_opsAgent, MessageKey);
	}

	function Complete(string MessageKey) : string
	{
		return ChatRuntime.Complete(_opsAgent, MessageKey);
	}

	function Reply(string CommandKey) : string
	{
		return ChatRuntime.Reply(_opsAgent, CommandKey);
	}

	function Audit(string CommandKey) : string
	{
		return ChatRuntime.Audit(_opsAgent, CommandKey);
	}
}
prototype ChatRunAdmission
{
	function Check(string Stage) : void
	{
		ChatRuntime.Check(_opsAgent, Stage);
	}
}
