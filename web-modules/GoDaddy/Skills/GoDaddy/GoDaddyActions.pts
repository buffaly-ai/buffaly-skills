// -- Domain transfer tools --

[SemanticProgram.InfinitivePhrase("to get godaddy transfer agreements")]
prototype ToGetGoDaddyTransferAgreements : GoDaddySkillAction
{
	Description = @"domain - the domain name to transfer in. Returns JSON array of legal agreements required by GoDaddy, including agreement keys and text. The user must read and accept these before initiating a transfer.";
	function Execute(string domain) : string
	{
		return GoDaddySkillFacade.GetTransferAgreements(domain);
	}
}

[SemanticProgram.InfinitivePhrase("to initiate a godaddy domain transfer")]
prototype ToInitiateGoDaddyTransfer : GoDaddySkillAction
{
	Description = @"domain - the domain name to transfer in. authCode - the EPP authorization code from the current registrar. agreedAt - ISO timestamp of user consent. agreedBy - user name or identity who agreed to the legal terms. agreementKeys - JSON array of legal agreement keys from ToGetGoDaddyTransferAgreements. period - optional registration period in years (1-10, default 1). Initiates a transfer-in. Requires confirmation and valid agreement keys.";
	function Execute(string domain, string authCode, string agreedAt, string agreedBy, string agreementKeys, int period) : string
	{
		return GoDaddySkillFacade.InitiateTransfer(domain, authCode, agreedAt, agreedBy, agreementKeys, period);
	}
}

[SemanticProgram.InfinitivePhrase("to check a godaddy domain transfer status")]
prototype ToCheckGoDaddyTransferStatus : GoDaddySkillAction
{
	Description = @"domain - the domain name. Returns JSON with transfer status, transfer ID, and timestamps.";
	function Execute(string domain) : string
	{
		return GoDaddySkillFacade.CheckTransferStatus(domain);
	}
}

prototype GoDaddyInteractiveSiteLauncher
{
	function Execute(IAgentRuntimeHost opsAgent, string screen, string title, string domain, int timeoutSeconds) : string
	{
		string stateJson = GoDaddyInteractiveSiteConfiguration.BuildStateJson(screen, domain);
		InteractiveSiteLaunchResultContract result = opsAgent.LaunchWebModuleComponent(new WebModuleComponentLaunchRequestContract
		{
			Title = title,
			MessageKey = opsAgent.GetCurrentToolMessageKeyOrEmpty(),
			ToolInvocationId = opsAgent.GetCurrentToolInvocationIdOrEmpty(),
			ModuleName = "GoDaddy",
			Screen = screen,
			StateJson = stateJson,
			TimeoutSeconds = timeoutSeconds
		});
		return "GoDaddy " + screen + " interactive site exited with status: " + result.Status + "; value: " + result.Value;
	}
}

[SemanticProgram.InfinitivePhrase("to show godaddy domains")]
prototype ToViewGoDaddyDomainsInteractiveSite : GoDaddySkillAction
{
	Description = @"Open the read-only GoDaddy domain portfolio in an interactive site.";
	function Execute(int timeoutSeconds) : string { return GoDaddyInteractiveSiteLauncher.Execute(_opsAgent, "domains", "GoDaddy Domains", "", timeoutSeconds); }
}

[SemanticProgram.InfinitivePhrase("to show a specific godaddy domain")]
prototype ToViewGoDaddyDomainInteractiveSite : GoDaddySkillAction
{
	Description = @"Open one read-only GoDaddy domain. Resolve the exact domain first with ToListGoDaddyDomains.";
	function Execute(string domain, int timeoutSeconds) : string { return GoDaddyInteractiveSiteLauncher.Execute(_opsAgent, "domain", "GoDaddy Domain " + domain, domain, timeoutSeconds); }
}

[SemanticProgram.InfinitivePhrase("to show godaddy dns records")]
prototype ToViewGoDaddyDnsInteractiveSite : GoDaddySkillAction
{
	Description = @"Open the read-only DNS and name-server view for one exact GoDaddy domain. Resolve the domain first with ToListGoDaddyDomains.";
	function Execute(string domain, int timeoutSeconds) : string { return GoDaddyInteractiveSiteLauncher.Execute(_opsAgent, "dns", "GoDaddy DNS " + domain, domain, timeoutSeconds); }
}
