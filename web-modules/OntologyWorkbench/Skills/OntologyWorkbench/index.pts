reference Buffaly.OntologyWorkbench.WebModule;
import Buffaly.Agent.Runtime.Abstractions Buffaly.Agent.Runtime.Abstractions.IAgentRuntimeHost IAgentRuntimeHost;
import Buffaly.OntologyWorkbench.WebModule Buffaly.OntologyPreparation.OntologyPreparationFacade OntologyPreparationFacade;
import Buffaly.OntologyWorkbench.WebModule Buffaly.OntologyPreparation.ExtractAndBindResult ExtractAndBindResult;

prototype OntologyWorkbenchSkillAction : OpsAction
{
    Description = "Base action for extracting ontology grammar and semantic candidate text.";
}

[SemanticEntity("ontology workbench skill")]
prototype OntologyWorkbenchSkill : SkillEntity
{
    Description = "Ontology Workbench grammar extraction and candidate binding actions.";
    ActionRoot = OntologyWorkbenchSkillAction;
}

[SemanticProgram.InfinitivePhrase("to extract and bind ontology workbench text")]
prototype ToWorkbenchExtractAndBindOntologyText : OntologyWorkbenchSkillAction
{
    Description = "Return the complete annotated grammar and a separate plain-text candidate list for a user directive.";
    function Execute(IAgentRuntimeHost opsAgent, string sourceText, string provider = "openai", string model = "gpt-5.6-luna", string reasoningLevel = "low") : ExtractAndBindResult
    {
        return OntologyPreparationFacade.ExtractAndBind(opsAgent, sourceText, provider, model, reasoningLevel);
    }
}
