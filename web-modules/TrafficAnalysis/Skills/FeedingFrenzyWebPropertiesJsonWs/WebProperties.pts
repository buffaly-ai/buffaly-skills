[SemanticProgram.InfinitivePhrase("to list feeding frenzy web properties")]
prototype WebProperties_GetWebProperties : FeedingFrenzyWebPropertiesJsonWsSkillAction
{
	Description = @"service - required local or remote FeedingFrenzyWebPropertiesJsonWsService binding. Returns the existing GetWebProperties JsonWs response without reshaping.";
	function Execute(FeedingFrenzyWebPropertiesJsonWsService service) : string
	{
		if (service == null) return "Error: FeedingFrenzyWebPropertiesJsonWsService binding is required.";
		return service.CallWebPropertiesRoute("web-properties/get-web-properties", new JsonObject());
	}
}

[SemanticProgram.InfinitivePhrase("to get a feeding frenzy web property")]
prototype WebProperties_GetWebProperty : FeedingFrenzyWebPropertiesJsonWsSkillAction
{
	Description = @"service - required service binding. WebPropertyID - exact property identifier. Returns the existing GetWebProperty JsonWs response.";
