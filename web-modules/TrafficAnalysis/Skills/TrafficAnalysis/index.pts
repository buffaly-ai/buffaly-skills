prototype TrafficAnalysisBuildGoogleAdsEnvelopeFromSources
{
	function Execute(string runId, string runSettingsJson, StringRef campaignsValue, StringRef searchTermsValue, StringRef adCreativesValue) : string
	{
		string campaignsJson = ToResolveStringReference.Execute(campaignsValue);
		string searchTermsJson = ToResolveStringReference.Execute(searchTermsValue);
		string adCreativesJson = ToResolveStringReference.Execute(adCreativesValue);
		return TrafficAnalysisProtoScriptFacade.BuildGoogleAdsEnvelope(runId, runSettingsJson, campaignsJson, searchTermsJson, adCreativesJson);
	}
}

prototype TrafficAnalysisCollectGoogleAdsEnvelope
{
	function Execute(string runId, string runSettingsJson, string customerId, string loginCustomerId, string dateRangePreset) : StringRef
	{
		return TrafficAnalysisBuildGoogleAdsEnvelopeFromSources.Execute(runId, runSettingsJson,
			GoogleAdsWebService.RunCampaignReportJson(customerId, loginCustomerId, dateRangePreset),
			GoogleAdsWebService.RunSearchTermReportJson(customerId, loginCustomerId, dateRangePreset),
			GoogleAdsWebService.RunAdCreativeReportJson(customerId, loginCustomerId, dateRangePreset));
	}
}

