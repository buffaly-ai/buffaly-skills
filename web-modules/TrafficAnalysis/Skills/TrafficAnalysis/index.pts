import FeedingFrenzy.TrafficAnalysis.Web FeedingFrenzy.TrafficAnalysis.Web.TrafficAnalysisProtoScriptFacade TrafficAnalysisProtoScriptFacade;

[SemanticEntity("traffic analysis skill")]
prototype TrafficAnalysisSkillAction : OpsAction
{
	Description = @"Base action type for the two-stage traffic analysis pipeline.";
}

prototype TrafficAnalysisSkill : SkillEntity
{
	EntityName = "traffic analysis skill";
	Description = @"Ordinary deterministic traffic analysis collectors and aggregator. Collectors return enriched JSON envelopes; the aggregator owns cross-source synthesis and email report composition.";
	ActionRoot = TrafficAnalysisSkillAction;
}

[SemanticProgram.InfinitivePhrase("to collect ga4 traffic data")]
prototype ToCollectGa4TrafficData : TrafficAnalysisSkillAction
{
	Description = @"Collect GA4 traffic data for the requested run and return the common collector envelope JSON.";
	function Execute(string runId, string runSettingsJson) : string
	{
		FeedingFrenzyWebPropertiesJsonWsService service = FeedingFrenzyWebPropertiesJsonWsService#Local;
		string propertiesJson = WebProperties_GetWebProperties.Execute(service);
		return TrafficAnalysisProtoScriptFacade.CollectGa4TrafficDataFromSourceJson(runId, runSettingsJson, propertiesJson);
	}
}

[SemanticProgram.InfinitivePhrase("to collect tracking log data")]
prototype ToCollectTrackingLogData : TrafficAnalysisSkillAction
{
	Description = @"Collect tracking-log traffic data for the requested run and return the common collector envelope JSON.";
	function Execute(string runId, string runSettingsJson) : string
	{
		FeedingFrenzyWebPropertiesJsonWsService service = FeedingFrenzyWebPropertiesJsonWsService#Local;
		string propertiesJson = WebProperties_GetWebProperties.Execute(service);
		return TrafficAnalysisProtoScriptFacade.CollectTrackingLogDataFromSourceJson(runId, runSettingsJson, propertiesJson);
	}
}

[SemanticProgram.InfinitivePhrase("to collect google ads data")]
prototype ToCollectGoogleAdsData : TrafficAnalysisSkillAction
{
	Description = @"Collect Google Ads campaign, search-term, and creative data for the requested run and return the common collector envelope JSON.";
	function Execute(string runId, string runSettingsJson) : string { return TrafficAnalysisProtoScriptFacade.CollectGoogleAdsData(runId, runSettingsJson); }
}

