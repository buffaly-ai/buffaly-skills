reference FeedingFrenzy.TrafficAnalysis.Web FeedingFrenzy.TrafficAnalysis.Web;
import FeedingFrenzy.TrafficAnalysis.Web FeedingFrenzy.TrafficAnalysis.Web.TrafficAnalysisProtoScriptFacade TrafficAnalysisProtoScriptFacade;
reference Buffaly.GoogleAds Buffaly.GoogleAds;
import Buffaly.GoogleAds Buffaly.GoogleAds.GoogleAdsWebService GoogleAdsWebService;
reference Buffaly.OpenAiAdmin.WebModule;
import Buffaly.OpenAiAdmin.WebModule Buffaly.OpenAiAdmin.WebModule.OpenAiAdminAgentTools OpenAiAdminAgentTools;
reference Buffaly.RedditAds.Web Buffaly.RedditAds.Web;
import Buffaly.RedditAds.Web Buffaly.RedditAds.Web.RedditAdsWebService RedditAdsWebService;
reference Buffaly.FacebookAds Buffaly.FacebookAds;
import Buffaly.FacebookAds Buffaly.FacebookAds.FacebookAdsWebService FacebookAdsWebService;

[SemanticEntity("traffic analysis skill")]
prototype TrafficAnalysisSkillAction : OpsAction
{
	Description = @"Base action type for the two-stage traffic analysis pipeline.";
}

prototype TrafficAnalysisSkill : SkillEntity
{
	EntityName = "traffic analysis skill";
	Description = @"Ordinary deterministic traffic analysis collectors and aggregator. Collectors return enriched JSON envelopes; the aggregator owns cross-source synthesis and email report composition.";
	ActionRoot = TrafficAnalysisSkillAction;
}

prototype TrafficAnalysisCollectorAnalyzer
{
	function Execute(StringRef collectorEnvelopeValue) : string
	{
		string collectorEnvelopeJson = ToResolveStringReference.Execute(collectorEnvelopeValue);
		if (!TrafficAnalysisProtoScriptFacade.ShouldAnalyzeCollector(collectorEnvelopeJson)) return collectorEnvelopeJson;
		string prompt = TrafficAnalysisProtoScriptFacade.BuildCollectorAnalysisPrompt(collectorEnvelopeJson);
		string modelResponseJson = ToAskModelViaBuffalyRuntime.Execute(prompt, "Return strict JSON only. Use only supplied source metrics and raw data. Do not invent numbers.", "", "", "", "[]");
		return TrafficAnalysisProtoScriptFacade.ApplyCollectorAnalysis(collectorEnvelopeJson, modelResponseJson);
	}
}

prototype TrafficAnalysisGa4SourceCollector
{
	function Execute(FeedingFrenzyWebPropertiesJsonWsService service, string timeframe, StringRef propertyIDsValue, StringRef summariesValue) : string
	{
		string propertyIDsJson = ToResolveStringReference.Execute(propertyIDsValue);
		string summariesJson = ToResolveStringReference.Execute(summariesValue);
		int index = TrafficAnalysisProtoScriptFacade.GetWebPropertyIDCount(summariesJson);
		if (index >= TrafficAnalysisProtoScriptFacade.GetWebPropertyIDCount(propertyIDsJson)) return summariesJson;
		int webPropertyID = TrafficAnalysisProtoScriptFacade.GetCompactWebPropertyIDAt(propertyIDsJson, index);
		string nextSummariesJson = TrafficAnalysisProtoScriptFacade.AppendSourceResponse(summariesJson, WebProperties_GetWebPropertyAnalyticsSummary.Execute(service, webPropertyID, timeframe));
		return TrafficAnalysisGa4SourceCollector.Execute(service, timeframe, propertyIDsJson, nextSummariesJson);
	}
}

prototype TrafficAnalysisTrackingSourceCollector
{
	function Execute(FeedingFrenzyWebPropertiesJsonWsService service, string timeframe, StringRef propertyIDsValue, StringRef overviewsValue) : string
	{
		string propertyIDsJson = ToResolveStringReference.Execute(propertyIDsValue);
		string overviewsJson = ToResolveStringReference.Execute(overviewsValue);
		int index = TrafficAnalysisProtoScriptFacade.GetWebPropertyIDCount(overviewsJson);
		if (index >= TrafficAnalysisProtoScriptFacade.GetWebPropertyIDCount(propertyIDsJson)) return overviewsJson;
		int webPropertyID = TrafficAnalysisProtoScriptFacade.GetCompactWebPropertyIDAt(propertyIDsJson, index);
		string nextOverviewsJson = TrafficAnalysisProtoScriptFacade.AppendSourceResponse(overviewsJson, WebProperties_GetWebPropertyTrafficOverview.Execute(service, webPropertyID, timeframe));
		return TrafficAnalysisTrackingSourceCollector.Execute(service, timeframe, propertyIDsJson, nextOverviewsJson);
	}
}

prototype TrafficAnalysisGetGa4PropertySummary
{
	function Execute(string binding, int webPropertyID, string timeframe) : StringRef
	{
		FeedingFrenzyWebPropertiesJsonWsService service = FeedingFrenzyWebPropertiesJsonWsService#Remote;
		if (binding == "Local") service = FeedingFrenzyWebPropertiesJsonWsService#Local;
		return WebProperties_GetWebPropertyAnalyticsSummary.Execute(service, webPropertyID, timeframe);
	}
}

prototype TrafficAnalysisGetWebProperties
{
	function Execute(string binding) : StringRef
	{
		FeedingFrenzyWebPropertiesJsonWsService service = FeedingFrenzyWebPropertiesJsonWsService#Remote;
		if (binding == "Local") service = FeedingFrenzyWebPropertiesJsonWsService#Local;
		return WebProperties_GetWebProperties.Execute(service);
	}
}

prototype TrafficAnalysisGetTrackingPropertyOverview
{
	function Execute(string binding, int webPropertyID, string timeframe) : StringRef
	{
		FeedingFrenzyWebPropertiesJsonWsService service = FeedingFrenzyWebPropertiesJsonWsService#Remote;
		if (binding == "Local") service = FeedingFrenzyWebPropertiesJsonWsService#Local;
		return WebProperties_GetWebPropertyTrafficOverview.Execute(service, webPropertyID, timeframe);
	}
}

