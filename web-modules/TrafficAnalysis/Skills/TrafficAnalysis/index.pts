{
	Description = @"Collect LinkedIn analytics for the requested run and return the common collector envelope JSON.";
	function Execute(string runId, string runSettingsJson) : string { return TrafficAnalysisProtoScriptFacade.CollectLinkedInData(runId, runSettingsJson); }
}

