[SemanticProgram.InfinitivePhrase("to collect ga4 traffic data")]
prototype ToCollectGa4TrafficData : TrafficAnalysisSkillAction
{
	Description = @"Collect GA4 traffic data for the requested run and return the common collector envelope JSON.";
	function Execute(string runId, string runSettingsJson) : string
	{
		string binding = TrafficAnalysisProtoScriptFacade.ResolveWebPropertiesBinding(runSettingsJson);
		FeedingFrenzyWebPropertiesJsonWsService service = FeedingFrenzyWebPropertiesJsonWsService#Remote;
		if (binding == "Local") service = FeedingFrenzyWebPropertiesJsonWsService#Local;
		string timeframe = TrafficAnalysisProtoScriptFacade.ResolveWebPropertiesTimeframe(runSettingsJson);
		string propertyIDsJson = TrafficAnalysisProtoScriptFacade.ProjectWebPropertyIDs(WebProperties_GetWebProperties.Execute(service), true);
		string propertiesJson = TrafficAnalysisProtoScriptFacade.ProjectWebProperties(WebProperties_GetWebProperties.Execute(service), true);
		string summariesJson = TrafficAnalysisGa4SourceCollector.Execute(service, timeframe, propertyIDsJson, "[]");
		return TrafficAnalysisCollectorAnalyzer.Execute(TrafficAnalysisProtoScriptFacade.BuildGa4Envelope(runId, runSettingsJson, propertiesJson, summariesJson));
	}
}

[SemanticProgram.InfinitivePhrase("to collect tracking log data")]
prototype ToCollectTrackingLogData : TrafficAnalysisSkillAction
{
	Description = @"Collect tracking-log traffic data for the requested run and return the common collector envelope JSON.";
	function Execute(string runId, string runSettingsJson) : string
	{
		string binding = TrafficAnalysisProtoScriptFacade.ResolveWebPropertiesBinding(runSettingsJson);
		FeedingFrenzyWebPropertiesJsonWsService service = FeedingFrenzyWebPropertiesJsonWsService#Remote;
		if (binding == "Local") service = FeedingFrenzyWebPropertiesJsonWsService#Local;
		string timeframe = TrafficAnalysisProtoScriptFacade.ResolveWebPropertiesTimeframe(runSettingsJson);
		string propertyIDsJson = TrafficAnalysisProtoScriptFacade.ProjectWebPropertyIDs(WebProperties_GetWebProperties.Execute(service), false);
		string propertiesJson = TrafficAnalysisProtoScriptFacade.ProjectWebProperties(WebProperties_GetWebProperties.Execute(service), false);
		string overviewsJson = TrafficAnalysisTrackingSourceCollector.Execute(service, timeframe, propertyIDsJson, "[]");
		return TrafficAnalysisCollectorAnalyzer.Execute(TrafficAnalysisProtoScriptFacade.BuildTrackingLogsEnvelope(runId, runSettingsJson, propertiesJson, overviewsJson));
	}
}

[SemanticProgram.InfinitivePhrase("to collect google ads data")]
prototype ToCollectGoogleAdsData : TrafficAnalysisSkillAction
{
	Description = @"Collect Google Ads campaign, search-term, and creative data for the requested run and return the common collector envelope JSON.";
	function Execute(string runId, string runSettingsJson) : string
	{
		string customerID = TrafficAnalysisProtoScriptFacade.GetRequiredSetting(runSettingsJson, "GoogleAdsCustomerId");
		string loginCustomerID = TrafficAnalysisProtoScriptFacade.GetSetting(runSettingsJson, "GoogleAdsLoginCustomerId", "");
		string dateRangePreset = TrafficAnalysisProtoScriptFacade.GetSetting(runSettingsJson, "GoogleAdsDateRangePreset", "LAST_7_DAYS");
		string collectorEnvelopeJson = TrafficAnalysisCollectGoogleAdsEnvelope.Execute(runId, runSettingsJson, customerID, loginCustomerID, dateRangePreset);
		return TrafficAnalysisCollectorAnalyzer.Execute(collectorEnvelopeJson);
	}
}

[SemanticProgram.InfinitivePhrase("to collect linkedin analytics")]
prototype ToCollectLinkedInData : TrafficAnalysisSkillAction
{
	Description = @"Collect LinkedIn analytics for the requested run and return the common collector envelope JSON.";
	function Execute(string runId, string runSettingsJson) : string
	{
		string organizationUrn = TrafficAnalysisProtoScriptFacade.GetRequiredSetting(runSettingsJson, "LinkedInOrganizationUrn");
		string collectorEnvelopeJson = TrafficAnalysisProtoScriptFacade.BuildLinkedInEnvelope(runId, runSettingsJson,
			ToGetLinkedInMemberAnalytics.Execute("IMPRESSION"),
			ToGetLinkedInOrganizationAnalytics.Execute(organizationUrn));
		return TrafficAnalysisCollectorAnalyzer.Execute(collectorEnvelopeJson);
	}
}

[SemanticProgram.InfinitivePhrase("to collect openai usage data")]
prototype ToCollectOpenAIUsageData : TrafficAnalysisSkillAction
{
	Description = @"Collect OpenAI usage data for the requested run and return the common collector envelope JSON.";
	function Execute(string runId, string runSettingsJson) : string
	{
		string startDate = TrafficAnalysisProtoScriptFacade.GetRequiredSetting(runSettingsJson, "StartDateUtc");
		string endDate = TrafficAnalysisProtoScriptFacade.GetRequiredSetting(runSettingsJson, "EndDateUtc");
		return TrafficAnalysisCollectorAnalyzer.Execute(TrafficAnalysisCollectOpenAIEnvelope.Execute(runId, runSettingsJson, startDate, endDate));
	}
}

[SemanticProgram.InfinitivePhrase("to collect reddit ads data")]
prototype ToCollectRedditAdsData : TrafficAnalysisSkillAction
{
	Description = @"Collect Reddit Ads data for the requested run when configured and return the common collector envelope JSON.";
	function Execute(string runId, string runSettingsJson) : string
	{
		string adAccountID = TrafficAnalysisProtoScriptFacade.GetRequiredSetting(runSettingsJson, "RedditAdsAccountId");
		string reportType = TrafficAnalysisProtoScriptFacade.GetSetting(runSettingsJson, "RedditAdsReportType", "campaign");
		string dateRangePreset = TrafficAnalysisProtoScriptFacade.GetSetting(runSettingsJson, "RedditAdsDateRangePreset", "last_7d");
		return TrafficAnalysisCollectorAnalyzer.Execute(TrafficAnalysisCollectRedditEnvelope.Execute(runId, runSettingsJson, adAccountID, reportType, dateRangePreset));
	}
}

