[SemanticProgram.InfinitivePhrase("to collect reddit ads data")]
prototype ToCollectRedditAdsData : TrafficAnalysisSkillAction
{
	Description = @"Collect Reddit Ads data for the requested run when configured and return the common collector envelope JSON.";
	function Execute(string runId, string runSettingsJson) : string { return TrafficAnalysisProtoScriptFacade.CollectRedditAdsData(runId, runSettingsJson); }
}

[SemanticProgram.InfinitivePhrase("to aggregate traffic analysis for email rendering")]
prototype ToAggregateTrafficAnalysis : TrafficAnalysisSkillAction
{
	Description = @"Aggregate available collector envelope JSON documents into the TrafficAnalysis email report view model using one bounded runtime LLM synthesis pass for narrative and prioritization.";
	function Execute(string runId, string runSettingsJson, string collectorsJson) : string
	{
		string prompt = TrafficAnalysisProtoScriptFacade.BuildAggregateSynthesisPrompt(runSettingsJson, collectorsJson);
		string modelResponseJson = ToAskModelViaBuffalyRuntime.Execute(prompt, "Return strict JSON only. Use only supplied metrics and collector analysis. Do not invent numbers.", "", "", "", "[]");
		return TrafficAnalysisProtoScriptFacade.AggregateTrafficAnalysisWithSynthesis(runId, runSettingsJson, collectorsJson, modelResponseJson);
	}
}
