[SemanticEntity("traffic analysis skill")]
prototype TrafficAnalysisSkillAction : OpsAction
{
	Description = @"Base action type for the two-level traffic analysis pipeline.";
}

prototype TrafficAnalysisSkill : SkillEntity
{
	EntityName = "traffic analysis skill";
	Description = @"Validated prompt workflows that use existing typed data-source tools for four independent collectors and a partial-failure-tolerant traffic summary aggregator.";
	ActionRoot = TrafficAnalysisSkillAction;
}

[SemanticProgram.InfinitivePhrase("to collect web property traffic data")]
prototype ToCollectWebPropertyTrafficData : ValidatedPromptAction, TrafficAnalysisSkillAction
{
	IsPromptAction = true; SkillKind = "validated-prompt"; SkillVersion = "1.0.0"; ChildSessionScope = "per-action";
	PromptPath = @"Skills/TrafficAnalysis/Prompts/traffic-collector.prompt.md";
	WorkPromptPath = @"Skills/TrafficAnalysis/Prompts/traffic-collector.prompt.md";
	ValidationPromptPath = @"Skills/TrafficAnalysis/Prompts/collector.validation.prompt.md";
	Description = @"Collect all active Feeding Frenzy web properties through the independent WebProperties wrappers, analyze GA4 and classified tracking traffic, and save data-stream/traffic-properties.json with exact prompt provenance.";
}

