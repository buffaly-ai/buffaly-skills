[SemanticProgram.InfinitivePhrase("to create a google document from explicit content")]
prototype ToCreateGoogleWorkspaceDocumentFromContent : GoogleWorkspaceSkillAction
{
    Description = @"content accepts a StringRef or text. contentFormat must be auto, text, html or pages. text preserves literal markup. makePublic controls link sharing. All content preparation occurs before Google calls.";
    function Execute(string accountKey, string scopePreset, string title, StringRef content, string contentFormat, bool makePublic) : string
    {
        string resolvedContent = content;
        if (StringUtil.IsEmpty(scopePreset))
            scopePreset = "docs.write";
        return GoogleWorkspaceServiceHost.CreateDocumentFromContentAsync(
            GoogleWorkspaceService.NormalizeGoogleWorkspaceAccountKey(accountKey),
            NormalizeGoogleWorkspaceOperationScopePreset(scopePreset), title,
            resolvedContent, contentFormat, makePublic, false, new CancellationToken(false));
    }
}