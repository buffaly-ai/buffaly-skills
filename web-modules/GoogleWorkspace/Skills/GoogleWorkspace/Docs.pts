[SemanticProgram.InfinitivePhrase("to create a public google docs document")]
prototype ToCreatePublicGoogleWorkspaceDocument : GoogleWorkspaceSkillAction
{
	Description = @"accountKey - authorized account key. scopePreset - defaults to docs.write when empty. title and bodyTextHtml required. Body accepts a StringRef or text; HTML is compiled to document formatting before creation. Unsupported HTML fails before creation. Returns JSON.";

	function Execute(string accountKey, string scopePreset, string title, StringRef bodyTextHtml) : string
	{
        string resolvedContent = bodyTextHtml;
		if (StringUtil.IsEmpty(scopePreset))
			scopePreset = "docs.write";

		// Return facade JSON without reshaping.
		return GoogleWorkspaceServiceHost.CreatePublicDocumentAsync(			GoogleWorkspaceService.NormalizeGoogleWorkspaceAccountKey(accountKey),
			NormalizeGoogleWorkspaceOperationScopePreset(scopePreset),
			title,
			resolvedContent,
			true,
			false,
			new CancellationToken(false));
	}
}

